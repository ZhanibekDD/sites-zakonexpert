# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он добавлен в .gitignore.

# API-ключ для доступа к data.egov.kz (AISOIP)
# Без этого ключа функция проверки по ИИН не будет работать
EGOV_API_KEY=ваш_ключ_здесь

# Порт, на котором запускается сервер (по умолчанию 3000)
PORT=3000

# CORS: укажите домен в production, чтобы ограничить запросы
# Оставьте пустым для отключения CORS (локальная разработка)
# CORS_ORIGIN=https://zakonexpertt.kz

# Режим окружения (development / production)
NODE_ENV=development
