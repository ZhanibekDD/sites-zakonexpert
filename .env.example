# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он добавлен в .gitignore.

# ─── ОСНОВНОЕ ────────────────────────────────────────────────
# API-ключ для доступа к data.egov.kz (AISOIP) — проверка ИИН
EGOV_API_KEY=ваш_ключ_здесь
# Ежедневное обновление полного компактного каталога data.egov.kz.
# Поставьте false, если обновление запускается внешним cron.
OPEN_DATA_AUTO_REFRESH=true
# Сохранять записи API в сжатом локальном кэше. Сначала прогреваются первые
# страницы всех наборов, затем полные таблицы — пока не достигнут лимит.
OPEN_DATA_RECORD_CACHE=true
OPEN_DATA_RECORD_CACHE_MAX_MB=700
# На диске всегда остаётся минимум 350 МБ для приложения, логов и обновлений.
OPEN_DATA_RECORD_CACHE_RESERVE_MB=350
# Одновременных запросов к data.egov.kz (1–5).
OPEN_DATA_RECORD_CACHE_CONCURRENCY=2
OPEN_DATA_RECORD_CACHE_DELAY_MS=100
# Даже без изменения паспорта полная копия пересобирается раз в 7 дней.
OPEN_DATA_RECORD_CACHE_MAX_AGE_HOURS=168
# Необязательное еженедельное обновление локальных агрегатов старых витрин.
# Полные таблицы и поиск работают без него через официальный API.
OPEN_DATA_AGGREGATE_REFRESH=false

# Серверный токен API КГД для /proverka-kontragenta. Храните только в
# переменных окружения Plesk; не вставляйте в HTML, JavaScript или репозиторий.
KGD_API_TOKEN=ваш_токен_кгд_здесь
# Необязательно: базовый адрес API КГД, если его изменит администратор портала.
KGD_API_BASE_URL=https://portal.kgd.gov.kz

# Токен унифицированных сервисов портала государственных закупок. Первичный
# токен выдаёт АО «Центр электронных финансов»; храните только в Plesk.
GOSZAKUP_API_TOKEN=ваш_токен_госзакуп_здесь
GOSZAKUP_API_BASE_URL=https://ows.goszakup.gov.kz

# Минимальная полнота карточки компании для индексации (4–10, рекомендуем 7).
# После изменения запустите backfill-company-quality при остановленном Node.js.
COMPANY_INDEX_MIN_SCORE=7

# Порт сервера (по умолчанию 3000)
PORT=3000

# Set to true for local smoke tests and CI: disables cron jobs, startup imports
# and Telegram long polling while keeping HTTP routes available.
DISABLE_BACKGROUND_JOBS=false

# Режим окружения
NODE_ENV=production

# CORS: домен для production
CORS_ORIGIN=https://zakonexpert.kz

# ─── АДМИНИСТРИРОВАНИЕ ───────────────────────────────────────
# Ключ для защиты admin-маршрутов (/api/news/import, /api/news/status и импорт реестров).
# Минимум 24 символа. Если не задан — admin API закрыт (503). Передавайте только
# в заголовке x-admin-key; не добавляйте ключ в URL, логи или историю браузера.
ADMIN_KEY=замените_на_случайный_ключ_32_символа

# Пароль для модерации комментариев (/admin/comments)
# Если не задан — маршрут полностью недоступен (403 для любого пароля)
ADMIN_PW=замените_на_свой_сложный_пароль

# Уведомления в Telegram о каждом посетителе создают лишнюю нагрузку и передают
# IP/устройство. Для заявок, звонков и чата Telegram продолжает работать.
TELEGRAM_VISIT_NOTIFICATIONS=false

# ─── ЛИЧНАЯ CRM ───────────────────────────────────────────────
# В production startup file Plesk должен быть crm-entry.js.
# Не присылайте реальные значения этих секретов в чат и не коммитьте их.
CRM_USERNAME=admin
CRM_PASSWORD=замените_на_уникальный_длинный_пароль
# Случайная строка минимум 24 символа для подписи HttpOnly-сессии.
CRM_SESSION_SECRET=замените_на_случайную_строку_32_символа
# Ключ для прямой интеграции генератора договоров с CRM.
# Один и тот же случайный ключ задаётся и в dogovora-zakon-Expert.
CRM_INTEGRATION_KEY=замените_на_другую_случайную_строку_32_символа
# Базовый URL FastAPI из dogovora-zakon-Expert, без завершающего /.
# Пример для отдельного локального сервиса: http://127.0.0.1:8000
CRM_GENERATOR_API_URL=
# По умолчанию CRM хранится в data/crm.db, загруженные договоры —
# data/crm-contracts/, резервные JSON — data/crm-backups/.
# CRM_DB_PATH=/absolute/path/data/crm.db
# CRM_CONTRACT_UPLOAD_DIR=/absolute/path/data/crm-contracts
# CRM_BACKUP_DIR=/absolute/path/data/crm-backups
CRM_BACKUP_KEEP_DAYS=30

# ─── WHATSAPP BUSINESS PLATFORM / CLOUD API ───────────────────
# Заполняйте только после подключения официального Meta WhatsApp Cloud API.
# Токены/секрет приложения никогда не вставляйте в клиентский JavaScript.
WHATSAPP_VERIFY_TOKEN=замените_на_случайный_verify_token
WHATSAPP_APP_SECRET=секрет_Meta_приложения
WHATSAPP_ACCESS_TOKEN=постоянный_токен_Cloud_API
WHATSAPP_PHONE_NUMBER_ID=id_номера_из_Meta
# Используйте поддерживаемую Graph API версию, указанную в текущей Meta документации.
WHATSAPP_GRAPH_VERSION=v25.0

# ─── НОВОСТИ ─────────────────────────────────────────────────
# Публиковать статьи автоматически при relevance_score >= NEWS_MIN_RELEVANCE
# true = авто-публикация, false = все статьи в draft (нужна ручная проверка)
AUTO_PUBLISH_NEWS=true

# Минимальный score для авто-публикации (0.0 – 1.0)
# 0.55 — рекомендуется, 0.75 — только очень релевантные
NEWS_MIN_RELEVANCE=0.55

# Максимум статей за один запуск импорта
NEWS_IMPORT_LIMIT=20

# Показывать изображения, объявленные издателем в RSS/Open Graph (true/false).
# Они не сохраняются на хостинге; при ошибке автоматически показывается
# уникальная SVG-обложка ZakonExpert для конкретной новости.
NEWS_USE_SOURCE_IMAGES=true

# Публичный официальный реестр «Е-Заң көмегі». Обычно менять не требуется.
# LAWYERS_REGISTRY_API_URL=https://eup.adilet.gov.kz/api/Lawyers

# Compact append-only NeDB files every six hours by default.
# The minimum accepted interval is five minutes.
# DB_AUTOCOMPACTION_MS=21600000