# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он добавлен в .gitignore.

# ─── ОСНОВНОЕ ────────────────────────────────────────────────
# API-ключ для доступа к data.egov.kz (AISOIP) — проверка ИИН
EGOV_API_KEY=ваш_ключ_здесь
# Ежедневное обновление полного компактного каталога data.egov.kz.
# Поставьте false, если обновление запускается внешним cron.
OPEN_DATA_AUTO_REFRESH=true
# Сохранять записи API в сжатом локальном кэше. Сначала прогреваются первые
# страницы всех наборов, затем полные таблицы — пока не достигнут лимит.
OPEN_DATA_RECORD_CACHE=true
OPEN_DATA_RECORD_CACHE_MAX_MB=700
# На диске всегда остаётся минимум 350 МБ для приложения, логов и обновлений.
OPEN_DATA_RECORD_CACHE_RESERVE_MB=350
OPEN_DATA_RECORD_CACHE_CONCURRENCY=2
OPEN_DATA_RECORD_CACHE_DELAY_MS=100
OPEN_DATA_RECORD_CACHE_MAX_AGE_HOURS=168
OPEN_DATA_AGGREGATE_REFRESH=false

KGD_API_TOKEN=ваш_токен_кгд_здесь
KGD_API_BASE_URL=https://portal.kgd.gov.kz
GOSZAKUP_API_TOKEN=ваш_токен_госзакуп_здесь
GOSZAKUP_API_BASE_URL=https://ows.goszakup.gov.kz
COMPANY_INDEX_MIN_SCORE=7
PORT=3000
DISABLE_BACKGROUND_JOBS=false
NODE_ENV=production
CORS_ORIGIN=https://zakonexpert.kz

# ─── АДМИНИСТРИРОВАНИЕ ───────────────────────────────────────
ADMIN_KEY=замените_на_случайный_ключ_32_символа
ADMIN_PW=замените_на_свой_сложный_пароль
TELEGRAM_VISIT_NOTIFICATIONS=false

# ─── ЛИЧНАЯ CRM ───────────────────────────────────────────────
# В production startup file Plesk должен быть crm-entry.js.
# Не присылайте реальные значения этих секретов в чат и не коммитьте их.
CRM_USERNAME=admin
CRM_PASSWORD=замените_на_уникальный_длинный_пароль
CRM_SESSION_SECRET=замените_на_случайную_строку_32_символа
# Один и тот же ключ задаётся здесь и в dogovora-zakon-Expert.
CRM_INTEGRATION_KEY=замените_на_другую_случайную_строку_32_символа
# Базовый URL FastAPI из dogovora-zakon-Expert, без завершающего /.
# Например, если сервис договоров доступен локально: http://127.0.0.1:8000
CRM_GENERATOR_API_URL=
# По умолчанию CRM хранится в data/crm.db, договоры — data/crm-contracts/,
# резервные JSON — data/crm-backups/.
# CRM_DB_PATH=/absolute/path/data/crm.db
# CRM_CONTRACT_UPLOAD_DIR=/absolute/path/data/crm-contracts
# CRM_BACKUP_DIR=/absolute/path/data/crm-backups
CRM_BACKUP_KEEP_DAYS=30

# ─── WHATSAPP BUSINESS PLATFORM / CLOUD API ───────────────────
WHATSAPP_VERIFY_TOKEN=замените_на_случайный_verify_token
WHATSAPP_APP_SECRET=секрет_Meta_приложения
WHATSAPP_ACCESS_TOKEN=постоянный_токен_Cloud_API
WHATSAPP_PHONE_NUMBER_ID=id_номера_из_Meta
WHATSAPP_GRAPH_VERSION=v25.0

# ─── НОВОСТИ ─────────────────────────────────────────────────
AUTO_PUBLISH_NEWS=true
NEWS_MIN_RELEVANCE=0.55
NEWS_IMPORT_LIMIT=20
NEWS_USE_SOURCE_IMAGES=true

# LAWYERS_REGISTRY_API_URL=https://eup.adilet.gov.kz/api/Lawyers
# DB_AUTOCOMPACTION_MS=21600000
