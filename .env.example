# Скопируйте этот файл в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в git — он добавлен в .gitignore.

# ─── ОСНОВНОЕ ────────────────────────────────────────────────
# API-ключ для доступа к data.egov.kz (AISOIP) — проверка ИИН
EGOV_API_KEY=ваш_ключ_здесь

# Порт сервера (по умолчанию 3000)
PORT=3000

# Set to true for local smoke tests and CI: disables cron jobs, startup imports
# and Telegram long polling while keeping HTTP routes available.
DISABLE_BACKGROUND_JOBS=false

# Режим окружения
NODE_ENV=production

# CORS: домен для production
CORS_ORIGIN=https://zakonexpertt.kz

# ─── АДМИНИСТРИРОВАНИЕ ───────────────────────────────────────
# Ключ для защиты admin-маршрутов (/api/news/import, /api/news/status)
# Если не задан — маршруты открыты (не рекомендуется для production)
ADMIN_KEY=замените_на_случайный_ключ_32_символа

# Пароль для модерации комментариев (/admin/comments)
# Если не задан — маршрут полностью недоступен (403 для любого пароля)
ADMIN_PW=замените_на_свой_сложный_пароль

# ─── НОВОСТИ ─────────────────────────────────────────────────
# Публиковать статьи автоматически при relevance_score >= NEWS_MIN_RELEVANCE
# true = авто-публикация, false = все статьи в draft (нужна ручная проверка)
AUTO_PUBLISH_NEWS=true

# Минимальный score для авто-публикации (0.0 – 1.0)
# 0.55 — рекомендуется, 0.75 — только очень релевантные
NEWS_MIN_RELEVANCE=0.55

# Максимум статей за один запуск импорта
NEWS_IMPORT_LIMIT=20

# Показывать изображения, объявленные издателем в RSS/Open Graph (true/false).
# Они не сохраняются на хостинге; при ошибке автоматически показывается
# уникальная SVG-обложка ZakonExpert для конкретной новости.
NEWS_USE_SOURCE_IMAGES=true
# Compact append-only NeDB files every six hours by default.
# The minimum accepted interval is five minutes.
# DB_AUTOCOMPACTION_MS=21600000
