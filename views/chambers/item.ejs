<%
const pageTitle = 'Нотариальная палата и палата ЧСИ — ' + chamber.region + ' | ZakonExpert';
const pageDesc  = chamber.notary_name + ' и ' + chamber.chsi_name + ': телефоны, контакты. Проблемы с нотариусом или ЧСИ в ' + chamber.region + '? ZakonExpert поможет.';
const canonical = 'https://zakonexpertt.kz/chambers/' + chamber.slug;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
    { '@type': 'ListItem', position: 2, name: 'Палаты нотариусов и ЧСИ', item: 'https://zakonexpertt.kz/chambers' },
    { '@type': 'ListItem', position: 3, name: chamber.region, item: canonical },
  ],
};

function fPhone(raw, display) {
  if (!display) return '<span style="color:#94a3b8;font-size:.85rem;">уточните на сайте палаты</span>';
  return '<a href="tel:' + raw + '" style="color:#1a56db;text-decoration:none;">' + display + '</a>';
}

const CSS = '<style>'
  + '.ch-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:1.5rem;}'
  + '.ch-panel{border-radius:14px;padding:20px 22px;}'
  + '.ch-panel-n{background:#eff6ff;border:1.5px solid #bfdbfe;}'
  + '.ch-panel-c{background:#f0fdf4;border:1.5px solid #bbf7d0;}'
  + '.ch-kicker{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;}'
  + '.ch-kicker-n{color:#0369a1;}'
  + '.ch-kicker-c{color:#166534;}'
  + '.ch-name{font-size:.9rem;font-weight:700;color:#0d1f3c;margin-bottom:10px;line-height:1.35;}'
  + '.ch-row{display:flex;gap:8px;font-size:.84rem;margin-bottom:5px;}'
  + '.ch-link{color:#1a56db;text-decoration:none;}'
  + '.ch-link:hover{text-decoration:underline;}'
  + '@media(max-width:580px){.ch-grid{grid-template-columns:1fr;}}'
  + '</style>';

const notaryPanel = '<div class="ch-panel ch-panel-n">'
  + '<div class="ch-kicker ch-kicker-n">📜 Нотариальная палата</div>'
  + '<div class="ch-name">' + chamber.notary_name + '</div>'
  + '<div class="ch-row">📞 ' + fPhone(chamber.notary_phoneRaw, chamber.notary_phone) + '</div>'
  + (chamber.notary_email ? '<div class="ch-row">✉️ <a href="mailto:' + chamber.notary_email + '" class="ch-link">' + chamber.notary_email + '</a></div>' : '')
  + (chamber.notary_web ? '<div class="ch-row">🌐 <a href="https://' + chamber.notary_web + '" target="_blank" rel="noopener" class="ch-link">' + chamber.notary_web + '</a></div>' : '')
  + '</div>';

const chsiPanel = '<div class="ch-panel ch-panel-c">'
  + '<div class="ch-kicker ch-kicker-c">⚖️ Палата ЧСИ</div>'
  + '<div class="ch-name">' + chamber.chsi_name + '</div>'
  + '<div class="ch-row">📞 ' + fPhone(chamber.chsi_phoneRaw, chamber.chsi_phone) + '</div>'
  + (chamber.chsi_email ? '<div class="ch-row">✉️ <a href="mailto:' + chamber.chsi_email + '" class="ch-link">' + chamber.chsi_email + '</a></div>' : '')
  + '</div>';

const ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">Проблемы с нотариусом или ЧСИ в ' + chamber.region + '?</h2>'
  + '<p class="npage-cta-sub">Поможем оспорить исполнительную надпись нотариуса и снять арест от ЧСИ. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Отмена надписи</span><span>Снятие ареста ЧСИ</span><span>Рассрочка долга</span></div></div>'
  + '<a href="https://wa.me/77000300024?text=Здравствуйте!+Проблема+с+нотариусом+или+ЧСИ,+нужна+помощь." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 700 030-00-24</span></span></a></div>';

const quickLinks = '<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:1.5rem;">'
  + '<a href="/notaries" style="display:inline-flex;align-items:center;gap:6px;background:#0d1f3c;color:#fff;border-radius:10px;padding:9px 16px;font-size:.85rem;font-weight:600;text-decoration:none;">📒 Каталог нотариусов</a>'
  + '<a href="/bailiffs" style="display:inline-flex;align-items:center;gap:6px;background:#0d1f3c;color:#fff;border-radius:10px;padding:9px 16px;font-size:.85rem;font-weight:600;text-decoration:none;">📒 Каталог ЧСИ</a>'
  + '</div>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><a href="/chambers">Палаты нот. и ЧСИ</a><span class="npage-bc-sep">/</span><span>' + chamber.region + '</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🏛 Палаты РК</span></div>'
  + '<h1 class="npage-h1">Палаты нотариусов и ЧСИ: ' + chamber.region + '</h1></div>'
  + '<div class="ch-grid">' + notaryPanel + chsiPanel + '</div>'
  + quickLinks + ctaHtml
  + '<div style="margin-top:1.5rem;"><a href="/chambers" style="color:#1a56db;font-size:.9rem;text-decoration:none;">← Все палаты Казахстана</a></div>'
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
