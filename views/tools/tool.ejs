<%
function esc(value) {
  return String(value == null ? '' : value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
const pageTitle = tool.title + ' | ZakonExpert';
const pageDesc = tool.description;
const canonical = 'https://zakonexpert.kz' + tool.href;
const schema = [
  { '@context':'https://schema.org','@type':'WebApplication',name:tool.title,description:tool.description,url:canonical,applicationCategory:'FinanceApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'KZT'} },
  { '@context':'https://schema.org','@type':'FAQPage',mainEntity:(tool.faq || []).map(function(item){return {'@type':'Question',name:item[0],acceptedAnswer:{'@type':'Answer',text:item[1]}};}) },
];
function inputHtml(field) {
  var attrs = ' id="' + esc(field.id) + '" class="tool-input" name="' + esc(field.id) + '"';
  if (field.type === 'select') {
    return '<select' + attrs + '>' + field.options.map(function(option){return '<option value="' + esc(option[0]) + '">' + esc(option[1]) + '</option>';}).join('') + '</select>';
  }
  attrs += ' type="' + esc(field.type || 'text') + '"';
  ['value','min','max','step'].forEach(function(key){if(field[key] !== undefined) attrs += ' ' + key + '="' + esc(field[key]) + '"';});
  if (field.readonly) attrs += ' readonly';
  return '<input' + attrs + '>';
}
const fields = tool.fields.map(function(field){return '<label class="tool-field"><span>' + esc(field.label) + '</span>' + inputHtml(field) + '</label>';}).join('');
const faqHtml = (tool.faq || []).map(function(item){return '<details><summary>' + esc(item[0]) + '</summary><p>' + esc(item[1]) + '</p></details>';}).join('');
const related = tools.filter(function(item){return item.href !== tool.href;}).slice(0,4).map(function(item){return '<a href="' + esc(item.href) + '"><i class="bi ' + esc(item.icon) + '"></i><span>' + esc(item.short) + '</span></a>';}).join('');
const configJson = JSON.stringify({ kind:tool.kind }).replace(/</g,'\\u003c');
const body = '<style>'
  + '.tool-shell{display:grid;grid-template-columns:minmax(0,760px) 310px;gap:24px;align-items:start;margin:24px 0 44px}.tool-main,.tool-side-card{background:#fff;border:1px solid #dbe4f0;border-radius:18px;box-shadow:0 8px 28px rgba(13,31,60,.06)}.tool-main{padding:28px}.tool-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.tool-field{display:grid;gap:7px}.tool-field span{color:#475569;font-size:.78rem;font-weight:750}.tool-input{width:100%;box-sizing:border-box;border:1.5px solid #dbe4f0;border-radius:11px;padding:12px 14px;background:#fff;color:#0d1f3c;font-size:.95rem}.tool-input:focus{outline:0;border-color:#1a56db;box-shadow:0 0 0 3px rgba(26,86,219,.1)}.tool-input[readonly]{background:#f8fafc}.tool-submit{grid-column:1/-1;border:0;border-radius:12px;background:#1a56db;color:#fff;padding:14px 18px;font-weight:800;font-size:.98rem;cursor:pointer}.tool-result{display:none;margin-top:18px;background:#effaf3;border:1px solid #b7e6c5;border-radius:14px;padding:20px}.tool-result.show{display:block}.tool-result h2{font-size:1rem;color:#166534;margin:0 0 12px}.result-grid{display:grid;gap:8px}.result-row{display:flex;justify-content:space-between;gap:14px;border-bottom:1px solid #d6efdd;padding:8px 0}.result-row span{color:#475569}.result-row strong{color:#0d1f3c;text-align:right}.result-total strong{color:#15803d;font-size:1.15rem}.tool-warning{margin-top:16px;background:#fff7ed;border:1px solid #fed7aa;border-radius:12px;padding:14px;color:#92400e;font-size:.82rem;line-height:1.55}.tool-side{display:grid;gap:14px}.tool-side-card{padding:19px}.tool-side-card h2{font-size:.95rem;color:#0d1f3c;margin:0 0 12px}.related-tools{display:grid;gap:8px}.related-tools a{display:flex;gap:9px;align-items:center;text-decoration:none;color:#1a56db;padding:8px 0;border-bottom:1px solid #eef2f7;font-size:.86rem}.tool-source{font-size:.8rem;line-height:1.55;color:#64748b}.tool-source a{color:#1a56db}.tool-faq{margin:34px 0}.tool-faq h2{font-family:Georgia,serif;color:#0d1f3c}.tool-faq details{background:#fff;border:1px solid #dbe4f0;border-radius:12px;padding:14px 16px;margin:9px 0}.tool-faq summary{font-weight:700;color:#0d1f3c;cursor:pointer}.tool-faq p{color:#64748b;line-height:1.6;margin:10px 0 0}@media(max-width:900px){.tool-shell{grid-template-columns:1fr}}@media(max-width:560px){.tool-main{padding:20px}.tool-form{grid-template-columns:1fr}.result-row{display:grid;gap:3px}}'
  + '</style><div class="npage-wrap"><div class="landing-container"><nav class="npage-breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><a href="/tools">Инструменты</a><span class="npage-bc-sep">/</span><span>' + esc(tool.short) + '</span></nav>'
  + '<section class="npage-hero"><div class="npage-badges"><span class="npage-badge">Бесплатный расчёт</span><span class="npage-badge npage-badge-active">Без регистрации</span></div><h1 class="npage-h1">' + esc(tool.title) + '</h1><p style="color:#64748b;max-width:800px;line-height:1.65;margin-top:10px">' + esc(tool.intro) + '</p></section>'
  + '<div class="tool-shell"><main class="tool-main"><form id="tool-form" class="tool-form">' + fields + '<button class="tool-submit" type="submit">Рассчитать</button></form><section id="tool-result" class="tool-result" aria-live="polite"><h2>Результат расчёта</h2><div id="tool-result-content" class="result-grid"></div></section>'
  + (tool.disclaimer ? '<div class="tool-warning"><strong>Важно:</strong> ' + esc(tool.disclaimer) + '</div>' : '') + '</main>'
  + '<aside class="tool-side"><div class="tool-side-card"><h2>Другие калькуляторы</h2><div class="related-tools">' + related + '</div></div>'
  + (tool.sourceUrl ? '<div class="tool-side-card tool-source"><strong>Источник данных</strong><p><a href="' + esc(tool.sourceUrl) + '" target="_blank" rel="noopener">' + esc(tool.sourceLabel) + ' ↗</a></p></div>' : '')
  + '<div class="tool-side-card"><h2>Нужна проверка юриста?</h2><p class="tool-source">Отправьте документы специалисту ZakonExpert. Сначала оценим ситуацию бесплатно.</p><a class="btn btn-success w-100" href="https://wa.me/77003097566?text=' + encodeURIComponent('Здравствуйте! Нужна помощь с расчётом: ' + tool.title) + '" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> Написать</a></div></aside></div>'
  + '<section class="tool-faq"><h2>Частые вопросы</h2>' + faqHtml + '</section></div></div>'
  + '<script>(function(){var config=' + configJson + ';function n(id){return Number(document.getElementById(id).value)||0}function money(v){return Math.round(v).toLocaleString("ru-RU")+" ₸"}function dateRu(d){return d.toLocaleDateString("ru-RU")}function row(label,value,total){return "<div class=\\"result-row"+(total?" result-total":"")+"\\"><span>"+label+"</span><strong>"+value+"</strong></div>"}document.getElementById("tool-form").addEventListener("submit",function(e){e.preventDefault();var html="";if(config.kind==="paymentPlan"){var amount=n("amount"),depositPct=n("deposit"),months=Math.max(1,Math.round(n("months"))),annual=n("annualRate"),first=amount*depositPct/100,principal=Math.max(0,amount-first),monthlyRate=annual/1200,monthly=monthlyRate?principal*monthlyRate*Math.pow(1+monthlyRate,months)/(Math.pow(1+monthlyRate,months)-1):principal/months,total=first+monthly*months;html=row("Первоначальный взнос",money(first))+row("Сумма после взноса",money(principal))+row("Ежемесячный платёж",money(monthly),true)+row("Всего по графику",money(total))+row("Переплата",money(Math.max(0,total-amount)));}else if(config.kind==="mrp"){var count=n("mrpCount"),value=n("mrpValue"),sum=count*value;html=row("Количество МРП",count.toLocaleString("ru-RU"))+row("Размер 1 МРП",money(value))+row("Сумма",money(sum),true);}else if(config.kind==="stateDuty"){var claim=n("claimAmount"),mrp=n("dutyMrp"),legal=document.getElementById("applicant").value==="company",rate=legal?3:1,capMrp=legal?20000:10000,duty=Math.min(claim*rate/100,mrp*capMrp);html=row("Цена иска",money(claim))+row("Применённая ставка",rate+"%")+row("Предельная сумма",capMrp.toLocaleString("ru-RU")+" МРП")+row("Предварительная госпошлина",money(duty),true);}else if(config.kind==="deadline"){var raw=document.getElementById("startDate").value,days=Math.max(1,Math.round(n("termDays"))),mode=document.getElementById("dayMode").value,start=new Date(raw+"T12:00:00");if(!raw||isNaN(start)){alert("Укажите начальную дату");return}var end=new Date(start),left=days;while(left>0){end.setDate(end.getDate()+1);if(mode==="calendar"||(end.getDay()!==0&&end.getDay()!==6))left--}html=row("Начало отсчёта",dateRu(new Date(start.getFullYear(),start.getMonth(),start.getDate()+1)))+row("Продолжительность",days+" дней")+row("Предварительная дата окончания",dateRu(end),true);}document.getElementById("tool-result-content").innerHTML=html;document.getElementById("tool-result").classList.add("show");if(window.ZE_trackEvent)window.ZE_trackEvent("calculator_completed",location.pathname);});})();</script>';
%>
