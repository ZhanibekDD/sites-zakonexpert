<%
const region = (selectedRegion || '').trim();
const currentRegion = regionPage || null;
const regions = allRegions || [];
const notaries = regionItems || [];
const paging = (typeof pagination !== 'undefined' && pagination)
  ? pagination
  : { page: 1, pageSize: notaries.length || 60, total: notaries.length, totalPages: 1 };
const pageSuffix = paging.page > 1 ? (' — страница ' + paging.page) : '';
const total = regions.reduce(function(sum, item) { return sum + (item.count || 0); }, 0);
const pageTitle = currentRegion
  ? ('Нотариусы ' + currentRegion.genitive + (paging.page > 1 ? pageSuffix : ': контакты') + ' | ZakonExpert')
  : 'Каталог нотариусов Казахстана — контакты и лицензии | ZakonExpert';
const pageDesc = currentRegion
  ? ('Список нотариусов ' + currentRegion.genitive + ': ' + paging.total + ' карточек, страница ' + paging.page + ' из ' + paging.totalPages + '. Телефоны, адреса и лицензии из ЕНИС.')
  : ('Каталог ' + total + ' нотариусов Казахстана. Актуальные контакты, адреса, лицензии и режим работы из официального реестра ЕНИС.');
const canonical = currentRegion
  ? ('https://zakonexpert.kz' + currentRegion.path + (paging.page > 1 ? '?page=' + paging.page : ''))
  : 'https://zakonexpert.kz/notaries';
const modifiedDate = lastUpdated ? new Date(lastUpdated).toISOString().substring(0, 10) : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': canonical + '#webpage',
      name: pageTitle,
      description: pageDesc,
      url: canonical,
      dateModified: modifiedDate,
      inLanguage: 'ru-KZ',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: currentRegion ? paging.total : total,
        itemListElement: notaries.map(function(item, index) {
          return { '@type': 'ListItem', position: ((paging.page - 1) * paging.pageSize) + index + 1, name: item.name, url: 'https://zakonexpert.kz/notary/' + item.slug };
        }),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: currentRegion ? [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Каталог нотариусов', item: 'https://zakonexpert.kz/notaries' },
        { '@type': 'ListItem', position: 3, name: currentRegion.displayName + pageSuffix, item: canonical },
      ] : [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Каталог нотариусов', item: canonical },
      ],
    },
  ],
};
const catalog = {
  type: 'notary',
  baseUrl: '/notaries',
  itemBaseUrl: '/notary/',
  searchAction: '/notary-search',
  searchLabel: 'Найти нотариуса по ФИО',
  searchPlaceholder: 'Введите фамилию или полное ФИО нотариуса',
  region,
  regionPage: currentRegion,
  regionBreadcrumbLabel: currentRegion ? (currentRegion.displayName + pageSuffix) : '',
  regions,
  items: notaries,
  pagination: paging,
  lastUpdated,
  pluralLabel: 'Каталог нотариусов',
  registryLabel: 'Официальные данные ЕНИС',
  title: 'Нотариусы Казахстана',
  regionTitle: currentRegion ? ('Нотариусы ' + currentRegion.genitive) : 'Нотариусы',
  regionListTitle: currentRegion ? ('Список нотариусов' + pageSuffix) : '',
  regionH1: currentRegion ? ('Нотариусы ' + currentRegion.genitive + ': список и контакты' + pageSuffix) : '',
  regionIntro: currentRegion
    ? ('В каталоге ' + paging.total + ' нотариусов. На странице показаны записи ' + (((paging.page - 1) * paging.pageSize) + 1) + '–' + Math.min(paging.page * paging.pageSize, paging.total) + '. Найдите специалиста по ФИО, проверьте лицензию, адрес и официальные контакты.')
    : '',
  regionEmblem: currentRegion ? getRegionEmblem(currentRegion.sourceName) : '',
  subtitle: 'Телефоны, email, адреса, лицензии и режим работы нотариусов по всем 20 территориальным палатам Казахстана.',
  countLabel: 'нотариусов',
  heroIcon: 'bi-journal-bookmark',
  cardIcon: 'bi-person-vcard',
  whatsappText: currentRegion
    ? ('Здравствуйте! Нотариус ' + currentRegion.genitive + ' совершил исполнительную надпись. Хочу проверить документ и возможный порядок отмены.')
    : 'Здравствуйте! Нужна помощь по исполнительной надписи нотариуса.',
  analyticsEvent: 'click_cta_notary',
  sourceUrl: 'https://enis.kz/NotarySearch',
  sourceName: 'Единая нотариальная информационная система Казахстана (ЕНИС)',
  sourceText: 'Данные автоматически сверяются со всеми 20 территориальными нотариальными палатами.',
  getRegionEmblem,
};
const body = '<link rel="stylesheet" href="/css/professional-catalog.css?v=20260824-4">'
  + include('../partials/professional-catalog-body', { catalog });
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
