<%
const region   = (selectedRegion || '').trim();
const regions  = allRegions  || [];
const notaries = regionItems || [];

const pageTitle = region
  ? ('Нотариусы ' + region + ' — контакты и адреса | ZakonExpert')
  : 'Нотариусы Казахстана — реестр всех регионов | ZakonExpert';
const pageDesc = region
  ? ('Нотариусы ' + region + ': ' + notaries.length + ' специалистов с адресами, телефонами и режимом работы. Реестр обновляется еженедельно с enis.kz.')
  : 'Реестр нотариусов Казахстана — 6314 нотариусов всех регионов. Адреса, телефоны, лицензии. Данные с enis.kz.';
const canonical = region
  ? ('https://zakonexpertt.kz/notaries?region=' + encodeURIComponent(region))
  : 'https://zakonexpertt.kz/notaries';
const schema = region
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Нотариусы', item: 'https://zakonexpertt.kz/notaries' },
        { '@type': 'ListItem', position: 3, name: 'Нотариусы ' + region, item: canonical },
      ],
    }
  : null;

function titleCase(s) {
  return (s || '').toLowerCase().split(' ').map(function(w){ return w ? w[0].toUpperCase() + w.slice(1) : ''; }).join(' ');
}
function fmtPhone(raw) {
  var d = (raw || '').replace(/\D/g, '');
  if (d.length === 11) return '+7 (' + d.slice(1,4) + ') ' + d.slice(4,7) + '-' + d.slice(7,9) + '-' + d.slice(9,11);
  if (d.length === 10) return '+7 (' + d.slice(0,3) + ') ' + d.slice(3,6) + '-' + d.slice(6,8) + '-' + d.slice(8,10);
  return raw;
}

var breadcrumb = '<nav class="npage-breadcrumb" aria-label="breadcrumb">'
  + '<a href="/">Главная</a><span class="npage-bc-sep">/</span>'
  + (region
    ? '<a href="/notaries">Нотариусы</a><span class="npage-bc-sep">/</span><span>' + region + '</span>'
    : '<span>Нотариусы</span>')
  + '</nav>';

var searchHtml = '<div class="catalog-search-block">'
  + '<p class="catalog-search-label">Найти нотариуса по ФИО</p>'
  + '<form method="GET" action="/notary-search" class="registry-search-form" style="margin-bottom:0;">'
  + '<div class="registry-search-row">'
  + '<input type="text" name="q" placeholder="Введите ФИО нотариуса..." class="registry-search-input" autocomplete="off">'
  + '<button type="submit" class="registry-search-btn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Найти</button>'
  + '</div></form></div>';

var heroHtml = '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">Реестр нотариусов</span></div>'
  + '<h1 class="npage-h1">'
  + (region ? 'Нотариусы — ' + region : 'Нотариусы Казахстана')
  + '</h1>'
  + '<p style="color:#475569;margin-top:0.5rem;">'
  + (region ? 'Найдено нотариусов в регионе: <strong>' + notaries.length + '</strong>' : 'База данных нотариусов по всем регионам Казахстана')
  + '</p></div>';

var contentHtml = '';

if (region) {
  if (notaries.length === 0) {
    contentHtml = '<div class="registry-empty"><p>Нотариусы в регионе <strong>' + region + '</strong> не найдены.</p></div>';
  } else {
    var items = '';
    for (var i = 0; i < notaries.length; i++) {
      var n = notaries[i];
      var name = titleCase(n.name);
      items += '<li class="registry-item"><a href="/notary/' + n.slug + '" class="registry-item-link">'
        + '<span class="registry-item-name">' + name + '</span>'
        + (n.phone ? '<span class="registry-item-region">' + fmtPhone(n.phone.split(/[;,]/)[0].trim()) + '</span>' : '')
        + '</a></li>';
    }
    contentHtml = '<ul class="registry-list">' + items + '</ul>';
  }
} else {
  var regionCards = '';
  for (var j = 0; j < regions.length; j++) {
    var r = regions[j];
    regionCards += '<a href="/notaries?region=' + encodeURIComponent(r.region) + '" class="catalog-region-card">'
      + '<span class="catalog-region-name">' + r.region + '</span>'
      + '<span class="catalog-region-count">' + r.count + ' нотариусов</span>'
      + '</a>';
  }
  contentHtml = '<div class="catalog-region-grid">' + regionCards + '</div>';
}

var ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p><h2 class="npage-cta-title">Нужна консультация нотариуса?</h2>'
  + '<p class="npage-cta-sub">Поможем разобраться с нотариальными документами и исполнительными надписями.</p></div>'
  + '<a href="https://wa.me/77000300024?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!+%D0%9D%D1%83%D0%B6%D0%BD%D0%B0+%D0%BF%D0%BE%D0%BC%D0%BE%D1%89%D1%8C+%D0%BF%D0%BE+%D0%BD%D0%BE%D1%82%D0%B0%D1%80%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE%D0%BC%D1%83+%D0%B4%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D1%83." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 700 030-00-24</span></span></a></div>';

const sourceHtml = '<div style="margin-top:2rem;padding:16px 20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;display:flex;align-items:flex-start;gap:12px;">'
  + '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
  + '<div style="font-size:.82rem;color:#64748b;line-height:1.6;">'
  + '<strong style="color:#374151;">Источник данных:</strong> Реестр нотариусов Министерства юстиции Республики Казахстан (<a href="https://minjust.gov.kz" target="_blank" rel="noopener" style="color:#1a56db;">minjust.gov.kz</a>). '
  + 'Сведения являются общедоступными в соответствии со <strong>ст. 7 Закона РК «О нотариате»</strong>. '
  + 'Данные носят справочный характер — актуальность рекомендуем уточнять на официальном сайте Министерства юстиции.'
  + '</div></div>';

const body = '<div class="npage-wrap"><div class="landing-container">'
  + breadcrumb
  + heroHtml
  + searchHtml
  + '<div class="registry-results" style="margin-top:1.5rem;">' + contentHtml + '</div>'
  + ctaHtml
  + sourceHtml
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
