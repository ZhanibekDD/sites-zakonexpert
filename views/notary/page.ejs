<%
// Title-case: ИВАНОВ ИВАН → Иванов Иван
const nameTitle = notary.name.toLowerCase()
  .split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1) : '').join(' ');

// City/district for subtitle — first meaningful token of address
const addrParts  = (notary.address || '').split(',');
const cityHint   = addrParts[0] ? addrParts[0].trim() : notary.region;

const pageTitle  = `Нотариус ${nameTitle} — ${notary.region} | ZakonExpert`;
const pageDesc   = `Контакты нотариуса ${nameTitle}: адрес, телефон, режим работы. ${notary.region}. Данные обновляются еженедельно с enis.kz.`;
const canonical  = `https://zakonexpertt.kz/notary/${notary.slug}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: `Нотариус ${nameTitle}`,
  description: `Частный нотариус. ${notary.region}.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: notary.address || '',
    addressRegion: notary.region,
    addressCountry: 'KZ',
  },
  ...(notary.phone ? { telephone: notary.phone.split(/[;,]/)[0].trim() } : {}),
  url: canonical,
};

// Format phone(s) into clickable links
function fmtPhones(raw) {
  if (!raw) return '';
  return raw.split(/[;,]+/)
    .map(p => p.trim()).filter(Boolean)
    .map(p => {
      const digits = p.replace(/[^\d+]/g, '');
      return `<a href="tel:${digits}" class="npage-phone-link">${p}</a>`;
    }).join(', ');
}

const body = `
<div class="npage-wrap">
  <div class="landing-container">

    <nav class="npage-breadcrumb" aria-label="breadcrumb">
      <a href="/">Главная</a>
      <span class="npage-bc-sep">/</span>
      <a href="/notary-search">Нотариусы</a>
      <span class="npage-bc-sep">/</span>
      <span>${nameTitle}</span>
    </nav>

    <div class="npage-hero">
      <div class="npage-badges">
        ${notary.active
          ? '<span class="npage-badge npage-badge--active"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Действующий нотариус</span>'
          : '<span class="npage-badge npage-badge--inactive"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Деятельность прекращена</span>'}
        <span class="npage-region-tag">${notary.region}</span>
      </div>
      <h1 class="npage-h1">${nameTitle}</h1>
    </div>

    <div class="npage-card">
      ${notary.address ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Адрес</span>
          <span class="npage-row-val">${notary.address}</span>
        </div>
      </div>` : ''}

      ${notary.phone ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.94 2 2 0 0 1 3.59 2.73h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10a16 16 0 0 0 6.12 6.12l.92-.93a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 17z"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Телефон</span>
          <span class="npage-row-val">${fmtPhones(notary.phone)}</span>
        </div>
      </div>` : ''}

      ${notary.email ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Email</span>
          <span class="npage-row-val">
            <a href="mailto:${notary.email}" class="npage-phone-link" title="Нажмите чтобы скопировать">${notary.email}</a>
          </span>
        </div>
      </div>` : ''}

      ${notary.schedule ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Режим работы</span>
          <span class="npage-row-val">${notary.schedule}</span>
        </div>
      </div>` : ''}

      ${notary.license ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Лицензия</span>
          <span class="npage-row-val">№ ${notary.license}${notary.licenseDate ? ' от ' + notary.licenseDate : ''}</span>
        </div>
      </div>` : ''}
    </div>

    <!-- CTA advertising block -->
    <div class="npage-cta">
      <div class="npage-cta-left">
        <p class="npage-cta-label">Юридическая помощь</p>
        <h2 class="npage-cta-title">Нотариус выдал исполнительную надпись?</h2>
        <p class="npage-cta-sub">Её можно оспорить! Поможем отменить надпись, снять арест со счёта и добиться рассрочки.</p>
        <div class="npage-cta-tags">
          <span>Снятие ареста со счёта</span>
          <span>Отмена исп. надписи</span>
          <span>Ограничения ЧСИ</span>
          <span>Запрет на авто</span>
        </div>
      </div>
      <a href="https://wa.me/77000300024?text=Здравствуйте!+Нотариус+выдал+исполнительную+надпись,+прошу+помочь+оспорить."
         class="npage-wa-btn" target="_blank" rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
        Написать в WhatsApp
      </a>
    </div>

    <p class="npage-source-note">
      Данные предоставлены
      <a href="https://enis.kz" target="_blank" rel="noopener noreferrer">Единой нотариальной информационной системой Казахстана (enis.kz)</a>.
      Обновляются еженедельно.
    </p>

  </div>
</div>
`;
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
