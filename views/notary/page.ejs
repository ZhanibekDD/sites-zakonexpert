        var stars = '★'.repeat(c.rating||5) + '☆'.repeat(5-(c.rating||5));
        var dt = new Date(c.createdAt).toLocaleDateString('ru-RU',{day:'2-digit',month:'long',year:'numeric'});
        return '<div style="background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;padding:16px 20px;margin-bottom:10px;">'
