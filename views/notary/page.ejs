<%
function titleCase(value) {
  return String(value || '').toLowerCase().split(' ').map(function(word) {
    return word ? word[0].toUpperCase() + word.slice(1) : '';
  }).join(' ');
}
function formatPhone(value) {
  var digits = String(value || '').replace(/\D/g, '');
  if (digits.length === 11 && digits[0] === '8') digits = '7' + digits.slice(1);
  if (digits.length === 10) digits = '7' + digits;
  return digits.length === 11 && digits[0] === '7'
    ? '+7 (' + digits.slice(1, 4) + ') ' + digits.slice(4, 7) + '-' + digits.slice(7, 9) + '-' + digits.slice(9, 11)
    : value;
}
var nameTitle = titleCase(notary.name);
var rawPhones = String(notary.phone || '').split(/[;,]+/).map(function(value) { return value.trim(); }).filter(Boolean);
var phoneText = rawPhones.map(formatPhone).join(' · ');
var firstPhone = rawPhones.length ? rawPhones[0].replace(/\D/g, '') : '';
if (firstPhone.length === 11 && firstPhone[0] === '8') firstPhone = '7' + firstPhone.slice(1);
if (firstPhone.length === 10) firstPhone = '7' + firstPhone;
var verifiedDate = notary.updatedAt
  ? new Date(notary.updatedAt).toLocaleDateString('ru-RU', { timeZone: 'Asia/Almaty' })
  : '';
var archiveSearchUrl = '/zamena-notariusa?q=' + encodeURIComponent(notary.name || '');
var detailRows = [
  { icon: 'bi-geo-alt', label: 'Адрес', value: notary.address },
  { icon: 'bi-telephone', label: 'Телефон нотариуса', value: phoneText || 'Не опубликован в ЕНИС', href: firstPhone ? 'tel:+' + firstPhone : '' },
  { icon: 'bi-envelope', label: 'Email', value: notary.email || 'Не опубликован в ЕНИС', href: notary.email ? 'mailto:' + notary.email : '' },
  { icon: 'bi-clock', label: 'Режим работы', value: notary.schedule },
  { icon: 'bi-file-earmark-check', label: 'Лицензия', value: notary.license ? ('№ ' + notary.license + (notary.licenseDate ? ' от ' + notary.licenseDate : '')) : 'Не опубликована в ЕНИС' },
];
if (Array.isArray(notary.archiveFor) && notary.archiveFor.length) {
  detailRows.push({ icon: 'bi-archive', label: 'Архивы по записи ЕНИС', value: notary.archiveFor.map(titleCase).join(' · '), href: '/zamena-notariusa' });
}
if (notary.active === false) {
  detailRows.push({ icon: 'bi-search', label: 'Кому передан архив', value: 'Проверить передачу архива', href: archiveSearchUrl });
}
detailRows.push({ icon: 'bi-database-check', label: 'Источник', value: 'Официальный реестр ЕНИС' + (verifiedDate ? ' · проверено ' + verifiedDate : ''), href: notary.sourceChamberUrl || 'https://enis.kz/NotarySearch', external: true });
var pageTitle = 'Нотариус ' + nameTitle + ' — контакты и лицензия | ZakonExpert';
var pageDesc = 'Нотариус ' + nameTitle + ' (' + notary.region + '): телефон, email, адрес, режим работы и номер лицензии из официального реестра ЕНИС.';
var canonical = 'https://zakonexpert.kz/notary/' + notary.slug;
var schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
      { '@type': 'ListItem', position: 2, name: 'Нотариусы', item: 'https://zakonexpert.kz/notaries' },
      { '@type': 'ListItem', position: 3, name: nameTitle, item: canonical },
    ] },
    { '@type': 'LegalService', name: 'Нотариус ' + nameTitle, url: canonical,
      address: notary.address ? { '@type': 'PostalAddress', streetAddress: notary.address, addressRegion: notary.region, addressCountry: 'KZ' } : undefined,
      telephone: rawPhones[0] || undefined, email: notary.email || undefined },
  ],
};
var reviewsHtml = include('../partials/professional-reviews', {
  itemType: 'notary', slug: notary.slug, backUrl: '/notary/' + notary.slug,
  subjectLabel: 'этим нотариусом', comments, commentStats, commentSent,
});
var detail = {
  name: nameTitle,
  subtitle: 'Нотариус · ' + notary.region,
  breadcrumbs: [{ href: '/notaries', label: 'Каталог нотариусов' }, { label: nameTitle }],
  badges: [
    { icon: 'bi-journal-bookmark', label: 'Данные ЕНИС' },
    { icon: notary.active === false ? 'bi-x-circle' : 'bi-check-circle', label: notary.active === false ? 'Деятельность прекращена' : 'Действующий нотариус', active: notary.active !== false },
  ],
  rows: detailRows,
  address: notary.address,
  mapLocation: [notary.address, notary.region].filter(Boolean).join(', '),
  help: notary.active === false ? {
    icon: 'bi-archive',
    title: 'Нужен документ из архива?',
    text: 'Проверим, опубликовано ли в ЕНИС, кому переданы документы, и подскажем контакты нотариальной палаты.',
    items: ['Найдём официальную запись о передаче', 'Проверим, действует ли хранитель', 'Подскажем порядок запроса документа'],
    whatsappText: 'Здравствуйте! Нужен документ из архива нотариуса ' + nameTitle + '.',
  } : {
    icon: 'bi-shield-check',
    title: 'Нотариус выдал исполнительную надпись?',
    text: 'Проверим соблюдение срока, уведомление и бесспорность требования, затем подскажем законный порядок отмены.',
    items: ['Проверим основания для взыскания', 'Подготовим возражение нотариусу', 'Поможем снять ограничения ЧСИ'],
    whatsappText: 'Здравствуйте! Нотариус ' + nameTitle + ' выдал исполнительную надпись, нужна консультация.',
  },
  diagnostic: notary.active === false ? null : {
    source: 'notary',
    entry: 'notary_profile',
    entityType: 'notary',
    title: 'Проверить маршрут отмены',
    note: '2 вопроса · основание «надпись» уже учтено',
  },
  analyticsEvent: 'click_cta_notary',
  analyticsEntityType: 'notary',
  warning: {
    title: 'Важно знать',
    text: 'Контакты и режим работы публикует сам официальный реестр ЕНИС. Если поле отсутствует, мы честно показываем, что оно не опубликовано, и не подставляем непроверенные данные.',
  },
  stepsTitle: notary.active === false ? 'Как найти документ прежнего нотариуса' : 'Что делать при исполнительной надписи',
  steps: notary.active === false ? [
    { icon: 'bi-search', title: 'Проверьте передачу', text: 'Найдите в ЕНИС явную запись, кому передан архив.' },
    { icon: 'bi-building', title: 'Подтвердите в палате', text: 'Если записи нет или хранитель тоже не работает, уточните место хранения в палате региона.' },
    { icon: 'bi-file-earmark-arrow-down', title: 'Запросите документ', text: 'Сообщите ФИО, примерную дату, вид документа и стороны нотариального действия.' },
  ] : [
    { icon: 'bi-file-earmark-text', title: 'Получите надпись', text: 'Уточните номер, дату, взыскателя и сумму требования.' },
    { icon: 'bi-search', title: 'Проверьте основания', text: 'Проверьте срок, уведомление и наличие спора по долгу.' },
    { icon: 'bi-shield-check', title: 'Подайте возражение', text: 'Направьте документы нотариусу и затем ЧСИ для снятия ограничений.' },
  ],
  moreHtml: reviewsHtml,
  backUrl: '/notaries',
  backLabel: 'Все нотариусы Казахстана',
};
var body = '<link rel="stylesheet" href="/css/registry-item.css?v=20260824-1">'
  + include('../partials/registry-item-body', { detail });
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
