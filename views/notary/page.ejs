<%
// Title-case: ИВАНОВ ИВАН → Иванов Иван
const nameTitle = notary.name.toLowerCase()
  .split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1) : '').join(' ');

// City/district for subtitle — first meaningful token of address
const addrParts  = (notary.address || '').split(',');
const cityHint   = addrParts[0] ? addrParts[0].trim() : notary.region;

const pageTitle  = `Нотариус ${nameTitle} — ${notary.region} | ZakonExpert`;
const _addrSnippet = notary.address ? `Адрес: ${notary.address.slice(0,60)}. ` : '';
const _phoneSnippet = notary.phone ? `Телефон: ${notary.phone.split(/[;,]/)[0].trim()}. ` : '';
const pageDesc   = `Нотариус ${nameTitle} — ${notary.region}. ${_addrSnippet}${_phoneSnippet}Режим работы, лицензия и контакты. ZakonExpert Казахстан.`;
const canonical  = `https://zakonexpertt.kz/notary/${notary.slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: `Нотариус ${nameTitle}`,
    description: pageDesc,
    address: {
      '@type': 'PostalAddress',
      streetAddress: notary.address || '',
      addressRegion: notary.region,
      addressCountry: 'KZ',
    },
    ...(notary.phone ? { telephone: notary.phone.split(/[;,]/)[0].trim() } : {}),
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
      { '@type': 'ListItem', position: 2, name: 'Нотариусы', item: 'https://zakonexpertt.kz/notaries' },
      { '@type': 'ListItem', position: 3, name: `Нотариус ${nameTitle}`, item: canonical },
    ],
  },
];

// Format KZ phone number: 87011234567 → +7 (701) 123-45-67
function fmtPhone(raw) {
  const d = (raw || '').replace(/\D/g, '');
  if (d.length === 11) return '+7 (' + d.slice(1,4) + ') ' + d.slice(4,7) + '-' + d.slice(7,9) + '-' + d.slice(9,11);
  if (d.length === 10) return '+7 (' + d.slice(0,3) + ') ' + d.slice(3,6) + '-' + d.slice(6,8) + '-' + d.slice(8,10);
  return raw;
}
// Format phone(s) into clickable links
function fmtPhones(raw) {
  if (!raw) return '';
  return raw.split(/[;,]+/)
    .map(p => p.trim()).filter(Boolean)
    .map(p => {
      const digits = p.replace(/[^\d+]/g, '');
      return `<a href="tel:${digits}" class="npage-phone-link">${fmtPhone(p)}</a>`;
    }).join(', ');
}

const body = `
<div class="npage-wrap">
