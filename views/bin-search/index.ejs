<%
const pageTitle = 'Поиск организации по БИН Казахстана | ZakonExpert';
const pageDesc  = 'Найдите банк, МФО, коллектора или страховую компанию по БИН. Реестры АРРФР, НБ РК.';
const canonical = 'https://zakonexpertt.kz/bin-search';
const schema = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{' @type':'ListItem',position:1,name:'Главная',item:'https://zakonexpertt.kz/'},{' @type':'ListItem',position:2,name:'Поиск по БИН',item:canonical}]};

const typeColor = {'Банк':'background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe','МФО':'background:#fef3c7;color:#92400e;border:1px solid #fde68a','Ломбард':'background:#f3e8ff;color:#6b21a8;border:1px solid #e9d5ff','Коллектор':'background:#fee2e2;color:#991b1b;border:1px solid #fecaca','Страховая':'background:#dcfce7;color:#166534;border:1px solid #bbf7d0','ГСИ':'background:#e0f2fe;color:#075985;border:1px solid #bae6fd'};

const CSS = '<style>'
  + '.bs-wrap{max-width:640px;margin:0 auto}'
  + '.bs-form{display:flex;gap:10px;margin:1.5rem 0;flex-wrap:wrap}'
  + '.bs-input{flex:1;min-width:200px;padding:12px 16px;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;outline:none}'
  + '.bs-input:focus{border-color:#1a56db}'
  + '.bs-btn{background:#1a56db;color:#fff;border:none;border-radius:12px;padding:12px 24px;font-size:.95rem;font-weight:700;cursor:pointer}'
  + '.bs-btn:hover{background:#1e40af}'
  + '.bs-result{background:#fff;border:1.5px solid #e2e8f0;border-radius:14px;padding:18px 22px;margin-bottom:10px}'
  + '.bs-type{display:inline-block;font-size:.7rem;font-weight:700;border-radius:6px;padding:2px 9px;margin-bottom:8px}'
  + '.bs-name{font-size:1rem;font-weight:700;color:#0d1f3c;margin-bottom:4px}'
  + '.bs-name a{color:inherit;text-decoration:none}'
  + '.bs-name a:hover{color:#1a56db}'
  + '.bs-bin{font-size:.78rem;color:#94a3b8}'
  + '.bs-empty{text-align:center;padding:40px 20px;color:#64748b;font-size:.95rem}'
  + '</style>';

var resultsHtml = '';
if (searched) {
  if (results.length === 0) {
    resultsHtml = '<div class="bs-empty">🔍 По БИН <strong>' + bin + '</strong> ничего не найдено в наших реестрах.<br><span style="font-size:.82rem;margin-top:8px;display:block;">Проверьте БИН на <a href="https://www.afsa.kz" target="_blank" rel="noopener" style="color:#1a56db;">afsa.kz</a> или <a href="https://egov.kz" target="_blank" rel="noopener" style="color:#1a56db;">egov.kz</a></span></div>';
  } else {
    results.forEach(function(r) {
      var tc = typeColor[r.type] || 'background:#f1f5f9;color:#475569';
      resultsHtml += '<div class="bs-result">'
        + '<span class="bs-type" style="' + tc + '">' + r.type + '</span>'
        + '<div class="bs-name"><a href="' + r.url + '">' + r.name + '</a></div>'
        + '<div class="bs-bin">БИН: ' + bin + '</div>'
        + '<a href="' + r.url + '" style="display:inline-block;margin-top:10px;font-size:.82rem;color:#1a56db;text-decoration:none;padding:5px 12px;border:1.5px solid #bfdbfe;border-radius:8px;background:#eff6ff;font-weight:500;">Подробнее →</a>'
        + '</div>';
    });
  }
}

const infoBox = '<div style="background:#f0fdf4;border:1.5px solid #bbf7d0;border-radius:12px;padding:14px 18px;font-size:.85rem;color:#166534;margin-top:1rem;line-height:1.6;">'
  + '✅ <strong>БИН (12 цифр)</strong> — бизнес-идентификационный номер организации. По нему можно проверить легальность МФО, банка или коллектора. '
  + 'Реестр охватывает: банки, МФО, ломбарды, коллекторов, страховые компании, департаменты юстиции.'
  + '</div>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><span>Поиск по БИН</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🔍 Поиск по реестрам</span></div>'
  + '<h1 class="npage-h1">Поиск организации по БИН</h1>'
  + '<p style="color:#475569;margin-top:.5rem;">Банки, МФО, коллекторы, страховые — все реестры АРРФР, НБ РК и Минюст</p></div>'
  + infoBox
  + '<div class="bs-wrap">'
  + '<form class="bs-form" action="/bin-search" method="GET">'
  + '<input class="bs-input" type="text" name="bin" value="' + bin + '" placeholder="Введите БИН (12 цифр)..." maxlength="12" pattern="[0-9]{9,12}" autocomplete="off">'
  + '<button class="bs-btn" type="submit">Найти</button>'
  + '</form>'
  + resultsHtml
  + '</div>'
  + '<div style="margin-top:2rem;"><a href="/" style="color:#1a56db;font-size:.9rem;text-decoration:none;">← На главную</a></div>'
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
