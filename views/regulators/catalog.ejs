    + (web ? '<div class="reg-row"><span class="reg-icon">🌐</span><a href="https://' + web + '" target="_blank" rel="noopener" class="reg-link">' + web + '</a></div>' : '')
    + (leader ? '<div class="reg-row"><span class="reg-icon">👤</span><span>' + leader + '</span></div>' : '')
    + '</div>';
