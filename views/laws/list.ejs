<%
const q      = locals.q      || '';
const code   = locals.code   || '';
const codes  = locals.codes  || [];
const articles = locals.articles || [];
const total  = locals.total  || 0;

const codeLabels = {
  uk:   'УК РК',
  upk:  'УПК РК',
  koap: 'КоАП РК',
  gk:   'ГК РК',
  sk:   'СК РК',
  tk:   'ТК РК',
};
const codeDesc = {
  uk:   'Уголовный кодекс — ответственность за преступления',
  upk:  'Уголовно-процессуальный кодекс — права участников процесса',
  koap: 'Кодекс об административных правонарушениях',
  gk:   'Гражданский кодекс — сделки, обязательства, собственность',
  sk:   'Семейный кодекс — брак, алименты, раздел имущества',
  tk:   'Трудовой кодекс — трудовые отношения',
};

const pageTitle = code
  ? `Статьи ${codeLabels[code] || code} | ZakonExpert Казахстан`
  : q
    ? `Поиск статей законов РК: "${q}" | ZakonExpert`
    : 'Все статьи законов РК — УК, УПК, КоАП, ГК, СК | ZakonExpert Казахстан';

const pageDesc = code
  ? `Все статьи ${codeLabels[code] || code} Республики Казахстан с текстом и разъяснением. Консультация адвоката и юриста по любой статье.`
  : 'Поиск статей законов Казахстана: УК РК, УПК РК, КоАП РК, ГК РК, СК РК. Текст статей, разъяснение, консультация адвоката.';

const canonical = 'https://zakonexpertt.kz/statyi' + (code ? `?code=${code}` : q ? `?q=${encodeURIComponent(q)}` : '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDesc,
  url: canonical,
  publisher: { '@type': 'LegalService', name: 'ZakonExpert', url: 'https://zakonexpertt.kz' },
};

const body = `
<section class="law-hero">
  <div class="landing-container">
    <div class="law-hero-kicker">Законодательство Казахстана</div>
    <h1 class="section-title" style="color:#fff;margin-bottom:8px;">
      ${code ? `Статьи ${codeLabels[code] || code}` : 'Все статьи законов РК'}
    </h1>
    <p style="color:rgba(255,255,255,0.65);font-size:1rem;max-width:640px;margin-bottom:0;">
      ${code ? (codeDesc[code] || '') : 'УК РК · УПК РК · КоАП РК · ГК РК · СК РК — поиск по номеру или названию статьи'}
    </p>
  </div>
</section>

<section class="law-body">
  <div class="landing-container">
    <div class="row g-4">
      <div class="col-lg-8">

        <!-- Search bar -->
        <form action="/statyi" method="get" class="law-search-bar">
          ${code ? `<input type="hidden" name="code" value="${code}">` : ''}
          <input class="law-search-input" type="text" name="q" value="${q.replace(/"/g,'&quot;')}"
                 placeholder="Поиск по номеру или названию статьи...">
          <button class="law-search-btn" type="submit"><i class="bi bi-search me-1"></i>Найти</button>
        </form>

        <!-- Code tabs -->
        <div class="law-code-tabs">
          <a href="/statyi" class="law-code-tab${!code ? ' active' : ''}">Все</a>
          ${codes.map(c => `<a href="/statyi?code=${c.code}" class="law-code-tab${code===c.code?' active':''}">${c.codeName}</a>`).join('')}
        </div>

        <!-- Results -->
        ${articles.length > 0 ? `
          <p style="font-size:0.85rem;color:#64748b;margin-bottom:14px;">
            Найдено: <strong>${articles.length}</strong> статей${q ? ` по запросу «${q}»` : ''}
          </p>
          <div class="law-results-grid">
            ${articles.map(a => `
            <a href="/statya/${a.slug}" class="law-result-card">
              <div class="law-result-num">Статья ${a.num} · ${a.codeName}</div>
              <div class="law-result-title">${a.title}</div>
              ${a.snippet ? `<div class="law-result-snippet">${a.snippet.slice(0,180)}…</div>` : ''}
            </a>`).join('')}
          </div>
        ` : (q || code) ? `
          <div style="text-align:center;padding:40px 0;color:#94a3b8;">
            <i class="bi bi-search" style="font-size:2rem;display:block;margin-bottom:12px;"></i>
            По запросу «${q || codeLabels[code]}» ничего не найдено.<br>
            <a href="/statyi" style="color:#1a56db;font-weight:600;">Очистить фильтр</a>
          </div>
        ` : `
          <div style="display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));margin-top:8px;">
            ${Object.entries(codeLabels).map(([c,name]) => `
            <a href="/statyi?code=${c}" style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:16px;padding:20px;text-decoration:none;color:#0f2044;transition:box-shadow .15s,border-color .15s;" onmouseover="this.style.borderColor='#1a56db'" onmouseout="this.style.borderColor='#e2e8f0'">
              <div style="font-weight:900;font-size:1.1rem;margin-bottom:4px;">${name}</div>
              <div style="font-size:0.82rem;color:#64748b;">${codeDesc[c] || ''}</div>
            </a>`).join('')}
          </div>
        `}
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="law-sidebar">
          <div class="law-cta-card">
            <div class="law-cta-title">Нужна консультация по статье?</div>
            <div class="law-cta-sub">Адвокат Маулен Ержанов — уголовные, гражданские, семейные и административные дела. ZakonExpert — аресты и ЧСИ.</div>
            <a href="https://wa.me/77000300024?text=Здравствуйте.+Нужна+консультация+по+статье+закона." class="law-cta-btn" target="_blank" rel="noopener">
              <i class="bi bi-whatsapp"></i> Написать в WhatsApp
            </a>
            <a href="tel:+77000300024" class="law-cta-btn" style="background:#0f2044;">
              <i class="bi bi-telephone"></i> +7 (700) 030-00-24
            </a>
          </div>

          <div class="law-nav-card">
            <div class="law-nav-title">Кодексы РК</div>
            ${Object.entries(codeLabels).map(([c,name]) => `
            <a href="/statyi?code=${c}" class="law-nav-link">
              <span class="num">${name.split(' ')[0]}</span>
              <span>${name.split(' ').slice(1).join(' ')}</span>
            </a>`).join('')}
          </div>

          <div class="law-nav-card">
            <div class="law-nav-title">Популярные статьи</div>
            <a href="/statya/uk-rk-96"  class="law-nav-link"><span class="num">96</span><span>УК РК — Убийство</span></a>
            <a href="/statya/uk-rk-175" class="law-nav-link"><span class="num">175</span><span>УК РК — Кража</span></a>
            <a href="/statya/uk-rk-228" class="law-nav-link"><span class="num">228</span><span>УК РК — Наркотики</span></a>
            <a href="/statya/uk-rk-120" class="law-nav-link"><span class="num">120</span><span>УК РК — Изнасилование</span></a>
            <a href="/statya/uk-rk-190" class="law-nav-link"><span class="num">190</span><span>УК РК — Мошенничество</span></a>
            <a href="/statya/koap-rk-73" class="law-nav-link"><span class="num">73</span><span>КоАП — Административный штраф</span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
`;
%>
<%- include('layout', {
  title: pageTitle,
  description: pageDesc,
  canonical,
  schema,
  activeNav: 'statyi',
  body
}) %>
