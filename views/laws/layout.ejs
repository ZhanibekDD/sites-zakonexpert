<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.png">
  <meta name="google-site-verification" content="rGbK9GM3kA42xzTzGMQs4VZju46dDdZjQdmOigQjnKY">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex,follow"><% } else { %><meta name="robots" content="index, follow"><% } %>
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'article' %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:locale" content="ru_KZ">
  <meta property="og:image" content="https://zakonexpertt.kz/img/brand/zakonexpert-logo-transparent-hd.png">
  <% if (typeof schema !== 'undefined' && schema) { %>
  <script type="application/ld+json"><%- JSON.stringify(schema).replace(/</g, '\\u003c') %></script>
  <% } %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/design-system.css?v=20260715-1">
  <link rel="stylesheet" href="/css/landing.css?v=20260619-1">
  <link rel="stylesheet" href="/css/style.css?v=20260619-1">
  <link rel="stylesheet" href="/css/legal.css?v=20260504-2">
  <style>
    .law-hero { background:linear-gradient(135deg,#0c1e3a,#0f2a4e); padding:52px 0 36px; color:#fff; }
    .law-hero-kicker { font-size:0.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; color:#d7a742; margin-bottom:10px; }
    .law-breadcrumb { font-size:0.82rem; color:rgba(255,255,255,0.5); margin-bottom:12px; }
    .law-breadcrumb a { color:rgba(255,255,255,0.55); text-decoration:none; }
    .law-breadcrumb a:hover { color:#fff; }
    .law-art-num { display:inline-block; background:rgba(215,167,66,0.18); border:1px solid rgba(215,167,66,0.4); color:#d7a742; border-radius:8px; padding:3px 12px; font-size:0.82rem; font-weight:700; margin-bottom:12px; }
    .law-art-title { font-size:clamp(1.5rem,3vw,2.2rem); font-weight:900; margin-bottom:8px; line-height:1.25; }
    .law-art-meta { font-size:0.85rem; color:rgba(255,255,255,0.5); }
    .law-body { background:#fff; padding:48px 0; }
    .law-text { font-size:1.05rem; line-height:1.85; color:#1e293b; white-space:pre-wrap; max-width:820px; }
    .law-text p { margin-bottom:1rem; }
    .law-sidebar { display:flex; flex-direction:column; gap:18px; }
    .law-cta-card { background:linear-gradient(135deg,#0f2044,#1a3a5c); border-radius:18px; padding:24px; color:#fff; }
    .law-cta-title { font-size:1rem; font-weight:800; margin-bottom:8px; }
    .law-cta-sub { font-size:0.85rem; color:rgba(255,255,255,0.6); margin-bottom:16px; line-height:1.5; }
    .law-cta-btn { display:flex; align-items:center; gap:8px; padding:11px 18px; background:#25d366; color:#fff; border-radius:10px; font-weight:700; font-size:0.9rem; text-decoration:none; margin-bottom:8px; }
    .law-cta-btn:hover { background:#1db954; color:#fff; }
    .law-nav-card { background:#f8fafc; border:1px solid #e2e8f0; border-radius:14px; padding:18px; }
    .law-nav-title { font-size:0.75rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:#64748b; margin-bottom:10px; }
    .law-nav-link { display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:1px solid #f1f5f9; color:#0f2044; text-decoration:none; font-size:0.9rem; font-weight:600; }
    .law-nav-link:last-child { border-bottom:none; }
    .law-nav-link:hover { color:#1a56db; }
    .law-nav-link .num { color:#d7a742; font-size:0.8rem; }
    .law-search-bar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px; }
    .law-search-input { flex:1; min-width:200px; padding:11px 16px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:0.95rem; outline:none; background:#fff; }
    .law-search-input:focus { border-color:#1a56db; }
    .law-search-btn { padding:11px 20px; background:#0f2044; color:#fff; border:none; border-radius:10px; font-weight:700; cursor:pointer; white-space:nowrap; }
    .law-search-btn:hover { background:#1a3560; }
    .law-code-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:20px; }
    .law-code-tab { padding:6px 14px; border-radius:20px; font-size:0.82rem; font-weight:700; border:1.5px solid #e2e8f0; background:#fff; cursor:pointer; color:#334155; transition:.15s; text-decoration:none; }
    .law-code-tab:hover, .law-code-tab.active { background:#0f2044; color:#fff; border-color:#0f2044; }
    .law-results-grid { display:grid; gap:10px; }
    .law-result-card { border:1px solid #e2e8f0; border-radius:12px; padding:14px 18px; text-decoration:none; color:inherit; transition:box-shadow .15s,border-color .15s; display:block; }
    .law-result-card:hover { border-color:#1a56db; box-shadow:0 4px 18px rgba(26,86,219,0.1); color:inherit; }
    .law-result-num { font-size:0.78rem; font-weight:800; color:#d7a742; margin-bottom:4px; }
    .law-result-title { font-size:0.97rem; font-weight:700; color:#0f2044; margin-bottom:2px; }
    .law-result-code { font-size:0.78rem; color:#64748b; }
    .law-result-snippet { font-size:0.8rem; color:#64748b; margin-top:5px; line-height:1.55; }
  </style>
