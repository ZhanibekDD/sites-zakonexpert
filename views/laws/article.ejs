const pageTitle = `Статья ${art.num} ${art.codeName} — ${art.title} | ZakonExpert Казахстан`;
const cleanDescription = String(art.text || '').replace(/\s+/g, ' ').trim().slice(0, 145);
const pageDescription = `Статья ${art.num} ${art.codeName}: ${art.title}. ${cleanDescription}${cleanDescription ? '…' : ''} Консультация адвоката.`;
const canonical = `https://zakonexpertt.kz/statya/${encodeURIComponent(art.slug)}`;
