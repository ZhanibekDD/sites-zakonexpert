// Bold only the most important punishment terms inline
function boldPunishments(text) {
  return text
    .replace(/(пожизненным лишением свободы)/gi, '<strong>$1</strong>')
    .replace(/(лишением свободы)/gi, '<strong>$1</strong>')
    .replace(/(ограничением свободы)/gi, '<strong>$1</strong>')
    .replace(/(смертной казнью)/gi, '<strong>$1</strong>')
    .replace(/(\bарестом\b)/gi, '<strong>$1</strong>')
    .replace(/(\bштрафом\b)/gi, '<strong>$1</strong>')
    .replace(/(конфискацией имущества)/gi, '<strong>$1</strong>');
}

// Format article text — clean, readable
function formatLawText(text) {
  if (!text) return '<p style="color:#94a3b8;">Текст статьи не загружен. Запустите <code>npm run scrape-laws</code></p>';
  const lines = text.split('\n').filter(l => l.trim());
  let html = '';
  let partOpen = false;

  for (const line of lines) {
    const l = line.trim();

    // Skip footnote/amendment lines
    if (/^Сноска/i.test(l)) continue;

    // Numbered main part: "1. Текст части..."
    const partM = l.match(/^(\d+)\.\s+([\s\S]+)/);
    if (partM) {
      if (partOpen) html += '</div>';
      html += `<div class="lp-block">`;
      html += `<span class="lp-num">Часть ${partM[1]}</span>`;
      const body = partM[2];
      if (/^наказывается|^наказываются|^влечёт|^влечет/i.test(body.trim())) {
        html += `<p class="lp-sanction"><i class="bi bi-chevron-right"></i>${boldPunishments(body)}</p>`;
      } else {
        html += `<p class="lp-text">${boldPunishments(body)}</p>`;
      }
      partOpen = true;
      continue;
    }

    // Sub-items: "1) ..." or "а) ..."
    if (/^\d+\)\s/.test(l) || /^[а-яёa-z]\)\s/i.test(l)) {
      html += `<p class="lp-item">${boldPunishments(l)}</p>`;
      continue;
    }

    // Standalone sanction
    if (/^наказывается|^наказываются|^влечёт|^влечет/i.test(l)) {
      html += `<p class="lp-sanction"><i class="bi bi-chevron-right"></i>${boldPunishments(l)}</p>`;
      continue;
    }

    html += `<p class="lp-text">${boldPunishments(l)}</p>`;
  }

  if (partOpen) html += '</div>';
  return html || '<p style="color:#94a3b8;">Нет текста.</p>';
}

const textFormatted = formatLawText(art.text);

