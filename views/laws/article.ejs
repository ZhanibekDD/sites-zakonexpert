          </footer>
        </article>

        ${related.length ? `<section class="law-related" aria-labelledby="related-laws-title"><h2 class="law-related-title" id="related-laws-title">Другие статьи рядом в кодексе</h2><div class="law-results-grid">${related.map(item => `
