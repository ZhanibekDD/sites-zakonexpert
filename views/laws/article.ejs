  legislationIdentifier: `Статья ${art.num} ${art.codeName}`,
  legislationJurisdiction: 'Республика Казахстан',
  inLanguage: 'ru-KZ',
  publisher: { '@type': 'GovernmentOrganization', name: 'Республика Казахстан' },
  reviewedBy: {
    '@type': 'Attorney',
    name: 'Ержанов Маулен Ержанович',
    telephone: '+77777457577',
    url: 'https://zakonexpertt.kz/advocate',
  },
};

function highlightPunishments(value) {
  return esc(value)
    .replace(/(пожизненным лишением свободы)/gi, '<strong>$1</strong>')
    .replace(/(лишением свободы)/gi, '<strong>$1</strong>')
    .replace(/(ограничением свободы)/gi, '<strong>$1</strong>')
    .replace(/(смертной казнью)/gi, '<strong>$1</strong>')
    .replace(/(\bарестом\b)/gi, '<strong>$1</strong>')
    .replace(/(\bштрафом\b)/gi, '<strong>$1</strong>')
    .replace(/(конфискацией имущества)/gi, '<strong>$1</strong>');
}

function formatLawText(text) {
  if (!text) return '<p class="lp-text">Текст статьи временно недоступен. Проверьте актуальную редакцию на adilet.zan.kz.</p>';
  const lines = String(text).split('\n').filter(line => line.trim());
  let html = '';
  let partOpen = false;

  for (const line of lines) {
    const value = line.trim();
    if (/^Сноска/i.test(value)) continue;
    const part = value.match(/^(\d+)\.\s+([\s\S]+)/);
    if (part) {
      if (partOpen) html += '</div>';
      html += `<div class="lp-block"><span class="lp-num">Часть ${esc(part[1])}</span>`;
      if (/^наказывается|^наказываются|^влечёт|^влечет/i.test(part[2].trim())) {
        html += `<p class="lp-sanction"><i class="bi bi-chevron-right" aria-hidden="true"></i>${highlightPunishments(part[2])}</p>`;
      } else {
        html += `<p class="lp-text">${highlightPunishments(part[2])}</p>`;
      }
      partOpen = true;
      continue;
    }
    if (/^\d+\)\s/.test(value) || /^[а-яёa-z]\)\s/i.test(value)) {
      html += `<p class="lp-item">${highlightPunishments(value)}</p>`;
      continue;
    }
    if (/^наказывается|^наказываются|^влечёт|^влечет/i.test(value)) {
      html += `<p class="lp-sanction"><i class="bi bi-chevron-right" aria-hidden="true"></i>${highlightPunishments(value)}</p>`;
      continue;
    }
    html += `<p class="lp-text">${highlightPunishments(value)}</p>`;
  }
  if (partOpen) html += '</div>';
  return html || '<p class="lp-text">Текст статьи временно недоступен.</p>';
}

const textFormatted = formatLawText(art.text);
