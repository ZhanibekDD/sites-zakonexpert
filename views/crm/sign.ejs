<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Договор №<%= contract.number || '' %> · ZakonExpert</title>
  <style>
    :root{--navy:#0b365e;--gold:#c59324;--bg:#f4f7fb;--text:#1d2939;--muted:#667085;--line:#e3e8ef;--green:#067647;--red:#b42318}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:var(--text)}
    .wrap{max-width:860px;margin:32px auto;padding:0 16px}.head{display:flex;align-items:center;gap:14px;margin-bottom:18px}.mark{width:50px;height:50px;border-radius:14px;background:var(--navy);display:grid;place-items:center;color:#fff;font-weight:900;font-size:20px}.brand b{display:block;color:var(--navy);font-size:20px}.brand span{color:var(--muted);font-size:12px}.card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 18px 55px rgba(11,54,94,.08);overflow:hidden}.hero{padding:28px 30px;background:linear-gradient(135deg,#0b365e,#154f84);color:#fff}.eyebrow{color:#f3ca65;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.hero h1{font-size:28px;margin:8px 0 6px}.hero p{margin:0;color:#d6e2ef}.body{padding:26px 30px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px}.box{border:1px solid var(--line);border-radius:14px;padding:14px}.label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:800;margin-bottom:5px}.value{font-weight:750}.key{display:grid;grid-template-columns:150px 1fr;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:8px}.key b,.key span{padding:11px 13px}.key b{background:#f8fafc;color:var(--navy);font-size:12px}.muted{color:var(--muted);font-size:13px}.notice{border-radius:14px;padding:14px 16px;margin:18px 0;background:#fffbeb;border:1px solid #fde68a}.ok{background:#ecfdf3;border-color:#abefc6;color:var(--green)}.err{background:#fef3f2;border-color:#fecdca;color:var(--red)}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{border:0;border-radius:12px;padding:12px 16px;font-weight:800;text-decoration:none;cursor:pointer}.primary{background:var(--navy);color:#fff}.secondary{background:#fff;border:1px solid var(--line);color:var(--navy)}.check{display:flex;gap:10px;align-items:flex-start;margin-top:16px}.check input{margin-top:4px}.foot{padding:18px 30px;background:#f8fafc;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}
    @media(max-width:640px){.wrap{margin:14px auto}.hero,.body{padding:20px}.grid{grid-template-columns:1fr}.key{grid-template-columns:1fr}.key b{padding-bottom:4px}.key span{padding-top:4px}.hero h1{font-size:23px}}
  </style>
</head>
<body>
<div class="wrap">
  <div class="head"><div class="mark">ZE</div><div class="brand"><b>ZakonExpert</b><span>Персональная страница договора</span></div></div>
  <main class="card">
    <section class="hero"><div class="eyebrow">Договор оказания услуг</div><h1>№ <%= contract.number || '—' %></h1><p><%= contract.date || '' %> · <%= contract.city || 'г. Талдыкорган' %></p></section>
    <section class="body">
      <div class="grid">
        <div class="box"><div class="label">Клиент</div><div class="value"><%= client.name || contract.clientSnapshot?.name || 'Не указан' %></div><div class="muted">ИИН: <%= client.iin || contract.clientSnapshot?.iin || '—' %></div><div class="muted"><%= client.phone || contract.clientSnapshot?.phone || '' %></div></div>
        <div class="box"><div class="label">Стоимость</div><div class="value"><%= Number(contract.amount || 0).toLocaleString('ru-RU') %> ₸</div><div class="muted"><%= contract.paymentTerms || '' %></div></div>
      </div>
      <div class="key"><b>УСЛУГА</b><span><%= contract.serviceSubject || contract.title || 'Договор оказания услуг' %></span></div>
      <div class="key"><b>РЕЗУЛЬТАТ</b><span><%= contract.resultDefinition || 'Согласно условиям договора' %></span></div>
      <div class="key"><b>СРОК</b><span><%= contract.workPeriod || '30 календарных дней' %></span></div>

      <% if (signed) { %>
        <div class="notice ok"><b>Договор подтверждён клиентом.</b><br>Дата и время, IP-адрес и хеш документа зафиксированы системой ZakonExpert.</div>
        <div class="actions"><a class="btn primary" href="/contract/sign/<%= encodeURIComponent(token) %>/file.pdf" target="_blank">Открыть подписанный PDF</a></div>
      <% } else { %>
        <% if (error) { %><div class="notice err">Для подписания необходимо поставить отметку согласия.</div><% } %>
        <div class="notice">Перед подтверждением откройте PDF и проверьте ФИО, ИИН, услугу, стоимость, срок и порядок оплаты.</div>
        <div class="actions"><a class="btn secondary" href="/contract/sign/<%= encodeURIComponent(token) %>/file.pdf" target="_blank">Открыть PDF договора</a></div>
        <form method="post" action="/contract/sign/<%= encodeURIComponent(token) %>">
          <label class="check"><input type="checkbox" name="agree" value="yes" required><span>Я подтверждаю, что ознакомился(ась) с договором, его стоимостью, сроками, объёмом услуг и порядком оплаты и согласен(на) заключить договор в электронной форме.</span></label>
          <div class="actions"><button class="btn primary" type="submit">Подтвердить и подписать</button></div>
        </form>
      <% } %>
    </section>
    <div class="foot">ZakonExpert · Доступ к странице предоставляется только по персональной ссылке. Не пересылайте её посторонним.</div>
  </main>
</div>
</body>
</html>
