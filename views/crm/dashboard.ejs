<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>ZakonExpert CRM</title>
  <style>
    :root{--navy:#0b365e;--navy2:#082944;--gold:#c59324;--teal:#0f766e;--bg:#f2f5f9;--panel:#fff;--line:#e3e8ef;--text:#182230;--muted:#667085;--danger:#b42318;--success:#067647;--warn:#b54708;--shadow:0 12px 36px rgba(11,54,94,.08)}
    *{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:var(--text);background:var(--bg)}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{min-height:100vh;display:grid;grid-template-columns:250px 1fr}.sidebar{background:linear-gradient(180deg,var(--navy2),var(--navy));color:#fff;padding:22px 16px;position:sticky;top:0;height:100vh}.logo{display:flex;align-items:center;gap:11px;padding:4px 8px 22px}.logo-mark{width:42px;height:42px;border:1px solid rgba(255,255,255,.25);border-radius:13px;display:grid;place-items:center;color:#f2c65f;font-weight:950}.logo b{display:block;font-size:18px;letter-spacing:.02em}.logo span{font-size:11px;color:#b9cadb}.nav{display:flex;flex-direction:column;gap:6px}.nav button{border:0;background:transparent;color:#cbd8e5;text-align:left;padding:12px 13px;border-radius:12px;font-weight:700;display:flex;justify-content:space-between}.nav button.active,.nav button:hover{background:rgba(255,255,255,.1);color:#fff}.nav .count{font-size:11px;background:rgba(255,255,255,.12);padding:2px 7px;border-radius:99px}.side-note{position:absolute;left:16px;right:16px;bottom:20px;border-top:1px solid rgba(255,255,255,.12);padding-top:14px;font-size:11px;color:#b9cadb}.side-note .dots{display:flex;gap:10px;margin-bottom:8px}.dot{width:8px;height:8px;border-radius:50%;background:#64748b;display:inline-block}.dot.on{background:#34d399}.main{min-width:0}.topbar{height:72px;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:20}.topbar h1{font-size:19px;margin:0;color:var(--navy)}.top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.content{padding:24px 28px 38px;max-width:1700px;margin:auto}.btn{border:1px solid var(--line);background:#fff;color:#344054;border-radius:10px;padding:9px 12px;font-weight:750;text-decoration:none;display:inline-flex;gap:7px;align-items:center;justify-content:center}.btn:hover{border-color:#bac6d5}.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff}.btn.gold{background:#fff8e6;border-color:#ecd18e;color:#7a4f00}.btn.danger{color:var(--danger);border-color:#f3c5c1}.btn.small{padding:6px 8px;font-size:12px}.stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:var(--shadow)}.stat .label{font-size:11px;color:var(--muted);font-weight:700}.stat .value{font-size:25px;font-weight:900;margin-top:7px;color:#101828}.stat .hint{font-size:11px;margin-top:4px;color:var(--muted)}.stat.alert .hint{color:var(--danger)}.panel{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.toolbar{padding:12px;display:flex;gap:10px;align-items:center;margin-bottom:12px}.field{width:100%;border:1px solid #d0d5dd;background:#fff;border-radius:10px;padding:10px 11px;color:#101828;outline:none}.field:focus{border-color:#7aa4c8;box-shadow:0 0 0 3px rgba(11,54,94,.08)}textarea.field{resize:vertical;min-height:90px}.search{flex:1}.client-list{overflow:hidden}.client-head,.client-row{display:grid;grid-template-columns:minmax(260px,1.5fr) 150px minmax(220px,1fr) 170px 130px 90px 120px;gap:10px;align-items:center}.client-head{padding:10px 15px;background:#f8fafc;color:#667085;text-transform:uppercase;font-size:10px;font-weight:800;letter-spacing:.05em;border-bottom:1px solid var(--line)}.client-row{padding:13px 15px;border-bottom:1px solid #edf1f5;cursor:pointer}.client-row:last-child{border-bottom:0}.client-row:hover{background:#f9fbfd}.person{min-width:0}.person b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person .meta{font-size:12px;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{display:inline-flex;align-items:center;border-radius:99px;padding:5px 8px;font-size:11px;font-weight:850;background:#eef2f6;color:#344054}.badge.new{background:#eef2ff;color:#4338ca}.badge.contacted{background:#e0f2fe;color:#0369a1}.badge.agreed{background:#dcfce7;color:#166534}.badge.declined,.badge.lost,.badge.cancelled{background:#fee2e2;color:#991b1b}.badge.in_work{background:#fef3c7;color:#92400e}.badge.waiting_payment,.badge.sent,.badge.signed{background:#ffedd5;color:#9a3412}.badge.paid,.badge.done{background:#d1fae5;color:#065f46}.badge.draft{background:#f2f4f7;color:#475467}.muted{color:var(--muted)}.late{color:var(--danger);font-weight:800}.empty{padding:44px;text-align:center;color:var(--muted)}.view{display:none}.view.active{display:block}.lead-grid,.contract-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.lead-card,.contract-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:15px;box-shadow:var(--shadow)}.lead-card h3,.contract-card h3{margin:0 0 6px;font-size:15px}.lead-card p,.contract-card p{margin:5px 0;color:var(--muted);font-size:12px}.lead-card .question{color:#344054;min-height:38px}.section-title{display:flex;justify-content:space-between;align-items:center;margin:0 0 12px}.section-title h2{font-size:18px;margin:0;color:var(--navy)}.overlay{position:fixed;inset:0;background:rgba(15,23,42,.46);display:none;z-index:60}.overlay.show{display:block}.drawer{position:absolute;right:0;top:0;height:100%;width:min(900px,98vw);background:#f7f9fc;box-shadow:-25px 0 80px rgba(15,23,42,.25);overflow:auto}.drawer-head{position:sticky;top:0;z-index:3;background:#fff;border-bottom:1px solid var(--line);padding:14px 18px;display:flex;justify-content:space-between;align-items:center}.drawer-head h2{margin:0;color:var(--navy);font-size:19px}.drawer-body{padding:14px}.section{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:11px}.section h3{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--navy);margin:0 0 12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.label2{display:block;font-size:11px;color:var(--muted);font-weight:750;margin:0 0 5px}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.contract-item{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:9px;background:#fbfcfe}.contract-top{display:flex;justify-content:space-between;gap:12px}.contract-top b{color:#101828}.contract-meta{font-size:11px;color:var(--muted);margin-top:4px}.contract-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.status-select{max-width:170px}.messages{display:flex;flex-direction:column;gap:7px;max-height:300px;overflow:auto}.msg{max-width:84%;padding:8px 10px;border-radius:11px;font-size:12px;white-space:pre-wrap}.msg.in{align-self:flex-start;background:#eef2ff}.msg.out{align-self:flex-end;background:#dcfce7}.timeline{display:flex;flex-direction:column;gap:7px;max-height:340px;overflow:auto}.event{border-left:3px solid #cbd5e1;background:#fafcff;padding:8px 10px;border-radius:8px}.event .date{font-size:10px;color:var(--muted)}.event .text{font-size:12px;white-space:pre-wrap;margin-top:3px}.modal{position:fixed;inset:0;background:rgba(15,23,42,.5);display:none;place-items:center;z-index:80;padding:18px}.modal.show{display:grid}.modal-card{width:min(780px,100%);max-height:94vh;overflow:auto;background:#fff;border-radius:18px;padding:20px;box-shadow:0 30px 90px rgba(15,23,42,.25)}.modal-card h2{margin:0 0 14px;color:var(--navy)}.generator-card{width:min(980px,100%)}.generator-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.generator-side{background:#f8fafc;border:1px solid var(--line);border-radius:14px;padding:14px}.generator-side h3{margin:0 0 10px;font-size:14px;color:var(--navy)}.drop{border:2px dashed #b9c7d7;border-radius:14px;padding:24px;text-align:center;color:var(--muted);background:#fafcff}.toast{position:fixed;right:22px;bottom:22px;background:#101828;color:#fff;padding:11px 14px;border-radius:11px;opacity:0;transform:translateY(8px);transition:.2s;z-index:100;max-width:420px}.toast.show{opacity:1;transform:none}.mobile-menu{display:none}
    @media(max-width:1250px){.stats{grid-template-columns:repeat(3,1fr)}.lead-grid,.contract-grid{grid-template-columns:repeat(2,1fr)}.client-head,.client-row{grid-template-columns:minmax(240px,1.5fr) 140px minmax(180px,1fr) 150px 110px 75px}.client-head>*:nth-child(7),.client-row>*:nth-child(7){display:none}}
    @media(max-width:850px){.app{grid-template-columns:1fr}.sidebar{display:none}.topbar{padding:0 14px}.content{padding:14px}.mobile-menu{display:inline-flex}.stats{grid-template-columns:repeat(2,1fr)}.lead-grid,.contract-grid{grid-template-columns:1fr}.client-head{display:none}.client-row{grid-template-columns:1fr auto;padding:14px}.client-row>*:not(:first-child):not(:nth-child(2)){display:none}.toolbar{flex-wrap:wrap}.search{flex-basis:100%}.grid2,.grid3,.generator-grid{grid-template-columns:1fr}.drawer{width:100%}}
  </style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="logo"><div class="logo-mark">ZE</div><div><b>ZakonExpert</b><span>Private CRM</span></div></div>
    <nav class="nav">
      <button class="active" data-view="clients">Клиенты <span class="count" id="sideClients">0</span></button>
      <button data-view="leads">Лиды с сайта <span class="count" id="sideLeads">0</span></button>
      <button data-view="contracts">Договоры <span class="count" id="sideContracts">0</span></button>
    </nav>
    <div class="side-note"><div class="dots"><span><i class="dot <%= integrations.telegram ? 'on' : '' %>"></i> Telegram</span><span><i class="dot <%= integrations.whatsapp ? 'on' : '' %>"></i> WhatsApp</span></div>Данные CRM и договоры хранятся в закрытой части сервера, а не в публичном GitHub.</div>
  </aside>

  <main class="main">
    <header class="topbar"><h1 id="pageTitle">Клиенты</h1><div class="top-actions"><button class="btn gold" id="importPdf">Импорт старых PDF</button><input id="pdfFiles" type="file" accept="application/pdf" multiple hidden><button class="btn primary" id="addClient">+ Клиент</button><a class="btn small" href="/api/crm/export.csv">CSV</a><a class="btn small" href="/api/crm/export.json">Backup</a><form method="post" action="/crm/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small">Выйти</button></form></div></header>
    <div class="content">
      <section class="stats">
        <div class="stat"><div class="label">Клиенты</div><div class="value" data-stat="total">—</div><div class="hint">Без мусорных лидов</div></div>
        <div class="stat"><div class="label">В работе</div><div class="value" data-stat="in_work">—</div><div class="hint">Активные дела</div></div>
        <div class="stat"><div class="label">Ждём оплату</div><div class="value" data-stat="waiting_payment">—</div><div class="hint">Нужно дожать</div></div>
        <div class="stat alert"><div class="label">Обещано</div><div class="value" data-stat="promiseTotal">—</div><div class="hint" data-stat="overdue">—</div></div>
        <div class="stat"><div class="label">Оплачено</div><div class="value" data-stat="paidTotal">—</div><div class="hint">По карточкам CRM</div></div>
        <div class="stat"><div class="label">Договоры</div><div class="value" data-stat="contractsTotal">—</div><div class="hint" data-stat="contractsWaiting">—</div></div>
      </section>

      <section class="view active" id="view-clients">
        <div class="panel toolbar"><div class="search"><input class="field" id="search" placeholder="ФИО, ИИН, телефон, работа, заметка…"></div><select class="field" id="statusFilter" style="max-width:210px"><option value="">Все статусы</option><% Object.entries(statusLabels).forEach(([key,label]) => { %><option value="<%= key %>"><%= label %></option><% }) %></select><button class="btn" id="refresh">Обновить</button></div>
        <div class="panel client-list"><div class="client-head"><div>Клиент</div><div>Статус</div><div>Работа / следующее действие</div><div>Обещание</div><div>Оплачено</div><div>Договоры</div><div>Обновлено</div></div><div id="clientRows"></div><div id="clientEmpty" class="empty" hidden>Клиентов по этому фильтру нет.</div></div>
      </section>

      <section class="view" id="view-leads"><div class="section-title"><h2>Входящие заявки с сайта</h2><button class="btn" id="refreshLeads">Обновить</button></div><div class="lead-grid" id="leadGrid"></div><div id="leadEmpty" class="panel empty" hidden>Новых заявок нет.</div></section>
      <section class="view" id="view-contracts"><div class="section-title"><h2>Все активные договоры</h2><div class="muted">Черновики, отправленные, подписанные, ожидающие оплату и работа</div></div><div class="contract-grid" id="contractGrid"></div><div id="contractEmpty" class="panel empty" hidden>Договоров пока нет.</div></section>
    </div>
  </main>
</div>

<div class="overlay" id="overlay"><aside class="drawer"><div class="drawer-head"><h2 id="drawerTitle">Клиент</h2><button class="btn small" id="closeDrawer">Закрыть</button></div><div class="drawer-body" id="drawerBody"></div></aside></div>

<div class="modal" id="newModal"><div class="modal-card"><h2>Новый клиент</h2><div class="grid2"><div><label class="label2">ФИО</label><input class="field" id="newName"></div><div><label class="label2">ИИН</label><input class="field" id="newIin" maxlength="12"></div><div><label class="label2">Телефон</label><input class="field" id="newPhone" placeholder="+7 700 000 00 00"></div><div><label class="label2">Адрес</label><input class="field" id="newAddress"></div></div><div style="margin-top:9px"><label class="label2">Что нужно сделать</label><input class="field" id="newIssue"></div><div class="actions" style="margin-top:14px"><button class="btn primary" id="createClient">Создать</button><button class="btn" data-close="newModal">Отмена</button></div></div></div>

<div class="modal" id="generatorModal"><div class="modal-card generator-card"><h2>Создать договор</h2><div class="generator-grid"><div>
  <div class="grid3"><div><label class="label2">Номер</label><input class="field" id="gNumber" placeholder="автоматически"></div><div><label class="label2">Дата</label><input class="field" type="date" id="gDate"></div><div><label class="label2">Сумма, ₸</label><input class="field" type="number" id="gAmount"></div></div>
  <div class="grid2" style="margin-top:9px"><div><label class="label2">Тип услуги</label><select class="field" id="gPreset"><% Object.entries(servicePresets).forEach(([key,p]) => { %><option value="<%= key %>"><%= p.label %></option><% }) %></select></div><div><label class="label2">Срок работы</label><input class="field" id="gPeriod" value="30 календарных дней"></div></div>
  <div style="margin-top:9px"><label class="label2">Услуга / предмет</label><textarea class="field" id="gSubject"></textarea></div>
  <div style="margin-top:9px"><label class="label2">Что входит в работу</label><textarea class="field" id="gActions"></textarea></div>
  <div style="margin-top:9px"><label class="label2">Проверяемый результат</label><textarea class="field" id="gResult"></textarea></div>
  <div style="margin-top:9px"><label class="label2">Порядок оплаты</label><select class="field" id="gPaymentPreset"><option>100% оплата до начала оказания услуг</option><option>50% предоплата, 50% после завершения согласованного объёма работ</option><option>Оплата в течение 24 часов после достижения результата по договору</option><option value="custom">Другой порядок оплаты</option></select><input class="field" id="gPaymentCustom" placeholder="Введите свой порядок оплаты" style="margin-top:7px;display:none"></div>
  <div class="actions" style="margin-top:14px"><button class="btn primary" id="generateContract">Создать PDF + DOCX</button><button class="btn" data-close="generatorModal">Отмена</button></div>
</div><div class="generator-side"><h3>Клиент</h3><div id="generatorClient" class="muted">—</div><h3 style="margin-top:18px">После создания</h3><p class="muted">Договор автоматически появится в карточке. Можно скачать PDF/DOCX, отправить PDF в Telegram, получить персональную ссылку на электронное подписание и при необходимости удалить несостоявшийся договор.</p><div id="generatorResult"></div></div></div></div></div>
<div class="toast" id="toast"></div>

<script>
(() => {
  const CSRF=<%- JSON.stringify(csrf) %>;
  const STATUS=<%- JSON.stringify(statusLabels) %>;
  const CONTRACT_STATUS=<%- JSON.stringify(contractStatusLabels) %>;
  const PRESETS=<%- JSON.stringify(servicePresets) %>;
  const WHATSAPP=<%= integrations.whatsapp ? 'true' : 'false' %>;
  const TELEGRAM=<%= integrations.telegram ? 'true' : 'false' %>;
  const $=s=>document.querySelector(s); let currentId=''; let currentClient=null; let searchTimer=null; let cachedClients=[];
  const money=v=>Number(v||0).toLocaleString('ru-RU')+' ₸';
  const dt=v=>v?new Date(Number(v)||v).toLocaleString('ru-RU',{dateStyle:'short',timeStyle:'short'}):'—';
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const attr=v=>esc(v).replace(/`/g,'&#96;');
  const activeContracts=c=>(c.contracts||[]).filter(x=>!x.deletedAt);
  const isLate=c=>c.promiseDate && c.promiseDate < new Date().toISOString().slice(0,10) && c.paymentStatus!=='paid';
  function toast(text){const el=$('#toast');el.textContent=text;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2600)}
  async function api(url,opt={}){const headers={'Accept':'application/json',...(opt.headers||{})};if(opt.body!==undefined){headers['Content-Type']='application/json';headers['X-CSRF-Token']=CSRF;opt.body=JSON.stringify(opt.body)}const r=await fetch(url,{credentials:'same-origin',...opt,headers});if(r.status===401){location.href='/crm/login';throw new Error('Сессия завершена')}const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Ошибка');return data}
  function input(id,label,value='',type='text'){return `<div><label class="label2" for="${id}">${label}</label><input class="field" id="${id}" type="${type}" value="${attr(value)}"></div>`}
  function textArea(id,label,value=''){return `<div><label class="label2" for="${id}">${label}</label><textarea class="field" id="${id}">${esc(value||'')}</textarea></div>`}
  function setView(name){document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+name));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===name));$('#pageTitle').textContent=name==='clients'?'Клиенты':name==='leads'?'Лиды с сайта':'Договоры';if(name==='leads')loadLeads();if(name==='contracts')renderAllContracts()}

  async function loadSummary(){const s=await api('/api/crm/summary');$('[data-stat=total]').textContent=s.total||0;$('[data-stat=in_work]').textContent=s.byStatus?.in_work||0;$('[data-stat=waiting_payment]').textContent=s.byStatus?.waiting_payment||0;$('[data-stat=promiseTotal]').textContent=money(s.promiseTotal);$('[data-stat=paidTotal]').textContent=money(s.paidTotal);$('[data-stat=overdue]').textContent=s.overduePromises?`Просрочено: ${s.overduePromises}`:'Без просрочки';$('[data-stat=contractsTotal]').textContent=s.contractsTotal||0;$('[data-stat=contractsWaiting]').textContent=s.contractsWaiting?`Ожидают действия: ${s.contractsWaiting}`:'Нет зависших';$('#sideClients').textContent=s.total||0;$('#sideContracts').textContent=s.contractsTotal||0}
  function renderClients(clients){cachedClients=clients;const root=$('#clientRows');root.innerHTML='';$('#clientEmpty').hidden=clients.length>0;for(const c of clients){const count=activeContracts(c).length;const row=document.createElement('div');row.className='client-row';row.innerHTML=`<div class="person"><b>${esc(c.name||'Без имени')}</b><div class="meta">${esc(c.iin?`ИИН ${c.iin} · `:'')}${esc(c.phone||'без телефона')}</div><div class="meta">${esc(c.issue||c.source||'')}</div></div><div><span class="badge ${esc(c.status)}">${esc(STATUS[c.status]||c.status)}</span></div><div><div>${esc(c.nextAction||c.work||c.question||'—')}</div><div class="muted">${esc(c.nextActionDate||'')}</div></div><div><div>${c.promiseAmount?money(c.promiseAmount):'—'}</div><div class="${isLate(c)?'late':'muted'}">${esc(c.promiseDate||'')}</div></div><div>${c.paidAmount?money(c.paidAmount):'—'}</div><div><b>${count}</b></div><div class="muted">${dt(c.updatedAt)}</div>`;row.onclick=()=>openClient(c._id);root.appendChild(row)}}
  async function loadClients(){const q=encodeURIComponent($('#search').value.trim());const status=encodeURIComponent($('#statusFilter').value);const d=await api(`/api/crm/clients?q=${q}&status=${status}&limit=3000`);renderClients(d.clients||[]);return d.clients||[]}
  async function reload(){await Promise.all([loadSummary(),loadClients()]);const active=document.querySelector('.nav button.active')?.dataset.view;if(active==='contracts')renderAllContracts()}

  function renderAllContracts(){const root=$('#contractGrid');root.innerHTML='';const items=[];for(const c of cachedClients)for(const x of activeContracts(c))items.push({client:c,contract:x});items.sort((a,b)=>Number(b.contract.updatedAt||b.contract.createdAt)-Number(a.contract.updatedAt||a.contract.createdAt));$('#contractEmpty').hidden=items.length>0;for(const {client,contract:x} of items){const card=document.createElement('div');card.className='contract-card';card.innerHTML=`<div class="actions" style="justify-content:space-between"><span class="badge ${esc(x.status||'draft')}">${esc(CONTRACT_STATUS[x.status]||x.status||'Черновик')}</span><span class="muted">№ ${esc(x.number||'—')}</span></div><h3>${esc(client.name||client.phone||'Клиент')}</h3><p>${esc(x.title||'Договор')} · ${x.amount?money(x.amount):'сумма не указана'}</p><p>${esc(x.serviceSubject||x.workPeriod||'')}</p><div class="actions" style="margin-top:10px"><button class="btn small" data-open="${attr(client._id)}">Открыть карточку</button>${x.fileKey?`<a class="btn small" href="/api/crm/clients/${encodeURIComponent(client._id)}/contracts/${encodeURIComponent(x.id)}/file/pdf">PDF</a>`:''}</div>`;card.querySelector('[data-open]').onclick=()=>openClient(client._id);root.appendChild(card)}}

  async function loadLeads(){const d=await api('/api/crm/leads?limit=1000');const leads=d.leads||[];$('#sideLeads').textContent=leads.filter(x=>!x.promoted).length;const root=$('#leadGrid');root.innerHTML='';$('#leadEmpty').hidden=leads.length>0;for(const lead of leads){const card=document.createElement('div');card.className='lead-card';card.innerHTML=`<div class="actions" style="justify-content:space-between"><span class="badge ${lead.promoted?'done':'new'}">${lead.promoted?'В CRM':'Новый лид'}</span><span class="muted">${dt(lead.ts)}</span></div><h3>${esc(lead.name||'Без имени')}</h3><p>${esc(lead.phone||'без телефона')} · ${esc(lead.issue||'обращение')}</p><p class="question">${esc(lead.question||'')}</p><p>${esc(lead.page||'')}</p><div class="actions" style="margin-top:10px">${lead.promoted?'<span class="muted">Уже переведён в клиентов</span>':`<button class="btn primary small" data-promote="${attr(lead._id)}">Взять в работу</button>`}</div>`;const b=card.querySelector('[data-promote]');if(b)b.onclick=async()=>{try{const r=await api(`/api/crm/leads/${encodeURIComponent(lead._id)}/promote`,{method:'POST',body:{}});toast('Лид добавлен в клиентов');await reload();await loadLeads();await openClient(r.client._id)}catch(e){toast(e.message)}};root.appendChild(card)}}

  function contractHtml(c,x){const urlBase=`/api/crm/clients/${encodeURIComponent(c._id)}/contracts/${encodeURIComponent(x.id)}`;return `<div class="contract-item"><div class="contract-top"><div><b>${esc(x.title||'Договор')}${x.number?' №'+esc(x.number):''}</b><div class="contract-meta">${esc(x.date||'')} · ${x.amount?money(x.amount):'без суммы'} · ${esc(x.source||'')}</div></div><span class="badge ${esc(x.status||'draft')}">${esc(CONTRACT_STATUS[x.status]||x.status||'Черновик')}</span></div>${x.serviceSubject?`<div class="muted" style="margin-top:7px">${esc(x.serviceSubject)}</div>`:''}<div class="contract-actions">${x.fileKey?`<a class="btn small" href="${urlBase}/file/pdf">PDF</a><a class="btn small" href="${urlBase}/file/docx">DOCX</a>`:''}<button class="btn small" data-sign="${attr(x.id)}">Ссылка на подпись</button>${TELEGRAM&&x.fileKey?`<button class="btn small" data-telegram="${attr(x.id)}">В Telegram</button>`:''}<select class="field status-select" data-contract-status="${attr(x.id)}">${Object.entries(CONTRACT_STATUS).map(([k,v])=>`<option value="${k}" ${x.status===k?'selected':''}>${esc(v)}</option>`).join('')}</select><button class="btn small danger" data-delete-contract="${attr(x.id)}">Удалить</button></div></div>`}
  function renderClient(c){currentId=c._id;currentClient=c;$('#drawerTitle').textContent=c.name||c.phone||c.iin||'Клиент';const statusOptions=Object.entries(STATUS).map(([k,v])=>`<option value="${k}" ${c.status===k?'selected':''}>${esc(v)}</option>`).join('');const contracts=activeContracts(c).slice().reverse().map(x=>contractHtml(c,x)).join('')||'<div class="muted">Активных договоров нет</div>';const deleted=(c.contracts||[]).filter(x=>x.deletedAt).slice().reverse().map(x=>`<div class="contract-item"><b>${esc(x.title||'Договор')} ${x.number?'№'+esc(x.number):''}</b><div class="contract-meta">Удалён: ${dt(x.deletedAt)} · ${esc(x.deletedReason||'')}</div><div class="actions" style="margin-top:8px"><button class="btn small" data-restore-contract="${attr(x.id)}">Восстановить</button></div></div>`).join('');const messages=(c.messages||[]).slice().sort((a,b)=>Number(a.at)-Number(b.at)).slice(-100).map(m=>`<div class="msg ${m.direction==='out'?'out':'in'}"><div>${esc(m.text||'')}</div><div class="muted" style="font-size:10px;margin-top:4px">${dt(m.at)} · ${esc(m.channel||'')}</div></div>`).join('')||'<div class="muted">Переписка появится после подключения официального WhatsApp API.</div>';const timeline=(c.timeline||[]).slice().sort((a,b)=>Number(b.at)-Number(a.at)).slice(0,120).map(e=>`<div class="event"><div class="date">${dt(e.at)} · ${esc(e.source||'')}</div><div class="text">${esc(e.text||'')}</div></div>`).join('')||'<div class="muted">История пуста</div>';
    $('#drawerBody').innerHTML=`<section class="section"><h3>Карточка клиента</h3><div class="grid3">${input('cName','ФИО',c.name)}${input('cIin','ИИН',c.iin)}${input('cPhone','Телефон',c.phone)}${input('cBirthDate','Дата рождения',c.birthDate,'date')}${input('cAddress','Адрес',c.address)}<div><label class="label2">Статус</label><select class="field" id="cStatus">${statusOptions}</select></div>${input('cSource','Источник',c.source)}${input('cManager','Ответственный',c.manager)}${input('cNextDate','Следующее действие — дата',c.nextActionDate,'date')}</div><div style="margin-top:9px">${textArea('cIssue','Что нужно сделать',c.issue)}</div><div style="margin-top:9px">${textArea('cWork','Что делаем сейчас',c.work)}</div><div style="margin-top:9px">${textArea('cNextAction','Следующее действие',c.nextAction)}</div><div style="margin-top:9px">${textArea('cNotes','Договорённости / заметки',c.notes)}</div><div class="actions" style="margin-top:10px"><button class="btn primary" id="saveClient">Сохранить</button></div></section>
    <section class="section"><h3>Деньги</h3><div class="grid3">${input('pAmount','Обещал оплатить, ₸',c.promiseAmount||'','number')}${input('pDate','Дата обещания',c.promiseDate||'','date')}${input('pNote','Комментарий',c.promiseNote||'')}</div><div class="actions" style="margin-top:9px"><button class="btn" id="savePromise">Записать обещание</button>${isLate(c)?'<span class="late">Просрочено</span>':''}</div><div class="grid2" style="margin-top:12px">${input('payAmount','Добавить оплату, ₸','','number')}${input('payDate','Дата/время','','datetime-local')}</div><div class="actions" style="margin-top:9px"><button class="btn" id="addPayment">Добавить оплату</button><span class="muted">Всего оплачено: <b>${money(c.paidAmount||0)}</b></span></div></section>
    <section class="section"><h3>Договоры</h3><div class="actions" style="margin-bottom:11px"><button class="btn primary" id="openGenerator">+ Создать договор</button><button class="btn gold" id="importClientPdf">Импорт PDF в эту карточку</button><input id="clientPdfFiles" type="file" accept="application/pdf" multiple hidden></div>${contracts}${deleted?`<details style="margin-top:12px"><summary class="muted">Удалённые договоры (${(c.contracts||[]).filter(x=>x.deletedAt).length})</summary><div style="margin-top:8px">${deleted}</div></details>`:''}</section>
    <section class="section"><h3>WhatsApp</h3><div class="messages">${messages}</div>${WHATSAPP?'<div style="margin-top:10px"><textarea class="field" id="waText" placeholder="Сообщение клиенту"></textarea></div><div class="actions" style="margin-top:8px"><button class="btn primary" id="sendWa">Отправить WhatsApp</button></div>':'<div class="muted" style="margin-top:10px">Для будущих сообщений подключим официальный WhatsApp Cloud API. Старые удалённые переписки WhatsApp API назад не восстановит.</div>'}</section>
    <section class="section"><h3>История</h3><div class="timeline">${timeline}</div></section>`;bindClientActions()}
  async function openClient(id){$('#overlay').classList.add('show');$('#drawerBody').innerHTML='<div class="empty">Загрузка…</div>';try{const d=await api('/api/crm/clients/'+encodeURIComponent(id));renderClient(d.client)}catch(e){toast(e.message)}}

  function openGenerator(){if(!currentClient)return;$('#generatorModal').classList.add('show');$('#generatorClient').innerHTML=`<b>${esc(currentClient.name||'Без имени')}</b><br>ИИН: ${esc(currentClient.iin||'—')}<br>${esc(currentClient.phone||'')}`;$('#gNumber').value='';$('#gDate').value=new Date().toISOString().slice(0,10);$('#gAmount').value='';$('#gPeriod').value='30 календарных дней';$('#gPreset').value='arrest';applyPreset();$('#gPaymentPreset').value='100% оплата до начала оказания услуг';$('#gPaymentCustom').style.display='none';$('#generatorResult').innerHTML=''}
  function applyPreset(){const p=PRESETS[$('#gPreset').value]||{};$('#gSubject').value=p.subject||'';$('#gActions').value=p.actions||'';$('#gResult').value=p.result||''}
  async function generateContract(){const payment=$('#gPaymentPreset').value==='custom'?$('#gPaymentCustom').value:$('#gPaymentPreset').value;if(!$('#gAmount').value)return toast('Укажите стоимость договора');if(!$('#gSubject').value.trim())return toast('Укажите предмет договора');const body={number:$('#gNumber').value,date:$('#gDate').value,amount:$('#gAmount').value,presetKey:$('#gPreset').value,workPeriod:$('#gPeriod').value,serviceSubject:$('#gSubject').value,serviceActions:$('#gActions').value,resultDefinition:$('#gResult').value,paymentTerms:payment};try{$('#generateContract').disabled=true;$('#generateContract').textContent='Формирую…';const r=await api(`/api/crm/clients/${currentId}/contracts/generate`,{method:'POST',body});$('#generatorResult').innerHTML=`<div class="contract-item" style="margin-top:14px"><b>Готов договор №${esc(r.contract.number)}</b><div class="contract-meta">${money(r.contract.amount)} · PDF + DOCX</div><div class="actions" style="margin-top:8px"><a class="btn small" href="${attr(r.pdfUrl)}">PDF</a><a class="btn small" href="${attr(r.docxUrl)}">DOCX</a><button class="btn small" id="copyGeneratedLink">Скопировать ссылку на подпись</button></div></div>`;$('#copyGeneratedLink').onclick=()=>copyText(r.signUrl,'Ссылка скопирована');toast('Договор создан');await reload();await openClient(currentId)}catch(e){toast(e.message)}finally{$('#generateContract').disabled=false;$('#generateContract').textContent='Создать PDF + DOCX'}}
  async function copyText(text,msg){try{await navigator.clipboard.writeText(text);toast(msg)}catch(_){prompt('Скопируйте ссылку',text)}}
  function bindClientActions(){
    $('#saveClient').onclick=async()=>{try{const d=await api(`/api/crm/clients/${currentId}`,{method:'PATCH',body:{name:$('#cName').value,iin:$('#cIin').value,phone:$('#cPhone').value,birthDate:$('#cBirthDate').value,address:$('#cAddress').value,status:$('#cStatus').value,source:$('#cSource').value,manager:$('#cManager').value,issue:$('#cIssue').value,work:$('#cWork').value,nextAction:$('#cNextAction').value,nextActionDate:$('#cNextDate').value,notes:$('#cNotes').value}});renderClient(d.client);toast('Карточка сохранена');reload()}catch(e){toast(e.message)}};
    $('#savePromise').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/promise`,{method:'POST',body:{amount:$('#pAmount').value,date:$('#pDate').value,note:$('#pNote').value}});renderClient(d.client);toast('Обещание записано');reload()};
    $('#addPayment').onclick=async()=>{if(!$('#payAmount').value)return toast('Укажите сумму');const d=await api(`/api/crm/clients/${currentId}/payment`,{method:'POST',body:{amount:$('#payAmount').value,paidAt:$('#payDate').value}});renderClient(d.client);toast('Оплата добавлена');reload()};
    $('#openGenerator').onclick=openGenerator;$('#importClientPdf').onclick=()=>$('#clientPdfFiles').click();$('#clientPdfFiles').onchange=()=>importPdfs($('#clientPdfFiles').files,currentId);
    document.querySelectorAll('[data-contract-status]').forEach(el=>el.onchange=async()=>{try{const d=await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(el.dataset.contractStatus)}`,{method:'PATCH',body:{status:el.value}});renderClient(d.client);reload()}catch(e){toast(e.message)}});
    document.querySelectorAll('[data-delete-contract]').forEach(el=>el.onclick=async()=>{const reason=prompt('Причина удаления из активных договоров','Клиент не оплатил, работа не началась');if(reason===null)return;if(!confirm('Убрать этот договор из активных? Его можно будет восстановить.'))return;try{const d=await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(el.dataset.deleteContract)}`,{method:'DELETE',body:{reason}});renderClient(d.client);toast('Договор убран');reload()}catch(e){toast(e.message)}});
    document.querySelectorAll('[data-restore-contract]').forEach(el=>el.onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(el.dataset.restoreContract)}/restore`,{method:'POST',body:{}});renderClient(d.client);toast('Договор восстановлен');reload()});
    document.querySelectorAll('[data-sign]').forEach(el=>el.onclick=async()=>{try{const r=await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(el.dataset.sign)}/sign-link`,{method:'POST',body:{}});copyText(r.signUrl,'Ссылка на подпись скопирована')}catch(e){toast(e.message)}});
    document.querySelectorAll('[data-telegram]').forEach(el=>el.onclick=async()=>{try{await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(el.dataset.telegram)}/telegram`,{method:'POST',body:{}});toast('PDF отправлен в Telegram');const d=await api(`/api/crm/clients/${currentId}`);renderClient(d.client);reload()}catch(e){toast(e.message)}});
    const sw=$('#sendWa');if(sw)sw.onclick=async()=>{const text=$('#waText').value.trim();if(!text)return;try{await api(`/api/crm/clients/${currentId}/whatsapp`,{method:'POST',body:{text}});toast('WhatsApp отправлен');const d=await api(`/api/crm/clients/${currentId}`);renderClient(d.client);reload()}catch(e){toast(e.message)}}
  }

  async function importPdfs(fileList,clientId=''){const files=[...fileList||[]];if(!files.length)return;let ok=0;for(const file of files){if(file.type!=='application/pdf'){toast(`${file.name}: нужен PDF`);continue}try{const bytes=await file.arrayBuffer();const nameB64=btoa(unescape(encodeURIComponent(file.name)));const url='/api/crm/contracts/import'+(clientId?`?clientId=${encodeURIComponent(clientId)}`:'');const r=await fetch(url,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/pdf','X-CSRF-Token':CSRF,'X-File-Name-B64':nameB64,'Accept':'application/json'},body:bytes});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Ошибка импорта');ok++;toast(`${file.name}: импортирован`)}catch(e){toast(`${file.name}: ${e.message}`)}}$('#pdfFiles').value='';const cp=$('#clientPdfFiles');if(cp)cp.value='';await reload();if(clientId)await openClient(clientId);if(ok>1)toast(`Импортировано договоров: ${ok}`)}

  document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>setView(b.dataset.view));$('#closeDrawer').onclick=()=>$('#overlay').classList.remove('show');$('#overlay').onclick=e=>{if(e.target===$('#overlay'))$('#overlay').classList.remove('show')};$('#refresh').onclick=reload;$('#refreshLeads').onclick=loadLeads;$('#statusFilter').onchange=loadClients;$('#search').oninput=()=>{clearTimeout(searchTimer);searchTimer=setTimeout(loadClients,250)};$('#addClient').onclick=()=>$('#newModal').classList.add('show');document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>$('#'+b.dataset.close).classList.remove('show'));$('#createClient').onclick=async()=>{try{const d=await api('/api/crm/clients',{method:'POST',body:{name:$('#newName').value,iin:$('#newIin').value,phone:$('#newPhone').value,address:$('#newAddress').value,issue:$('#newIssue').value,source:'manual'}});$('#newModal').classList.remove('show');await reload();await openClient(d.client._id);toast('Клиент создан')}catch(e){toast(e.message)}};$('#importPdf').onclick=()=>$('#pdfFiles').click();$('#pdfFiles').onchange=()=>importPdfs($('#pdfFiles').files);$('#gPreset').onchange=applyPreset;$('#gPaymentPreset').onchange=()=>$('#gPaymentCustom').style.display=$('#gPaymentPreset').value==='custom'?'block':'none';$('#generateContract').onclick=generateContract;reload().then(loadLeads).catch(e=>toast(e.message));
})();
</script>
</body>
</html>
