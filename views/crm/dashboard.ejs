<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>ZakonExpert CRM</title>
  <style>
    :root{--bg:#f3f6fa;--panel:#fff;--line:#dde5ef;--text:#142033;--muted:#6c788b;--accent:#0f766e;--accent2:#115e59;--danger:#b42318;--shadow:0 8px 26px rgba(31,42,68,.08)}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{padding:18px;min-height:100vh}.top{display:flex;gap:14px;justify-content:space-between;align-items:center;margin-bottom:12px}.brand h1{margin:0;font-size:25px}.brand p{margin:4px 0 0;color:var(--muted);font-size:13px}.top-actions,.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 12px;font-weight:750;color:#24324a;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px}.btn:hover{border-color:#aab8c9}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.primary:hover{background:var(--accent2)}.btn.danger{color:var(--danger)}.btn.small{padding:7px 9px;font-size:12px}.integration{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);padding:6px 8px;background:#fff;border:1px solid var(--line);border-radius:99px}.dot{width:8px;height:8px;border-radius:50%;background:#cbd5e1}.dot.on{background:#10b981}
    .stats{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px;margin-bottom:10px}.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:11px 13px;box-shadow:var(--shadow)}.stat .k{font-size:11px;color:var(--muted)}.stat .v{font-size:21px;font-weight:850;margin-top:5px}.stat .s{font-size:10px;color:var(--danger);margin-top:2px}.toolbar{display:flex;gap:9px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px;margin-bottom:10px;box-shadow:var(--shadow)}.field{width:100%;border:1px solid #cfd8e6;border-radius:9px;background:#fff;padding:9px 10px;outline:none}.field:focus{border-color:#5bb6b0;box-shadow:0 0 0 3px rgba(15,118,110,.10)}.search{flex:1;min-width:220px}
    .board-wrap{overflow-x:auto;overflow-y:hidden;padding-bottom:10px}.board{display:flex;gap:10px;align-items:flex-start;min-height:calc(100vh - 225px)}.column{width:305px;min-width:305px;background:#e9eef5;border:1px solid #d7e0eb;border-radius:14px;padding:8px;min-height:calc(100vh - 240px);transition:.15s}.column.drag-over{outline:3px solid rgba(15,118,110,.22);background:#e3f1ef}.column-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 7px 10px;font-weight:850;font-size:13px}.column-count{min-width:25px;height:25px;border-radius:99px;background:#fff;display:grid;place-items:center;color:#536176;font-size:11px}.column-cards{display:flex;flex-direction:column;gap:7px;min-height:90px}.deal{background:#fff;border:1px solid #dbe3ed;border-radius:11px;padding:11px;box-shadow:0 3px 10px rgba(31,42,68,.06);cursor:grab;transition:transform .12s,box-shadow .12s}.deal:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(31,42,68,.10)}.deal.dragging{opacity:.5;transform:rotate(1deg)}.deal-name{font-weight:850;font-size:14px;line-height:1.25}.deal-meta{font-size:11px;color:var(--muted);margin-top:4px;display:flex;gap:7px;flex-wrap:wrap}.deal-issue{font-size:12px;margin-top:8px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.deal-foot{display:flex;justify-content:space-between;align-items:end;gap:8px;margin-top:9px}.money{font-weight:850;font-size:12px}.tiny{font-size:10px;color:var(--muted)}.tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:7px}.tag{font-size:10px;font-weight:750;padding:3px 6px;border-radius:99px;background:#eef2f7;color:#506078}.tag.contract{background:#e0f2fe;color:#0369a1}.tag.late{background:#fee2e2;color:#991b1b}.tag.paid{background:#dcfce7;color:#166534}.empty-col{border:1px dashed #c6d0dd;border-radius:10px;padding:18px 8px;text-align:center;color:#8a96a8;font-size:11px}
    .overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;z-index:50}.overlay.show{display:block}.drawer{position:absolute;right:0;top:0;width:min(850px,98vw);height:100%;background:#f8fafc;overflow:auto;box-shadow:-25px 0 80px rgba(15,23,42,.25)}.drawer-head{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:14px 17px;display:flex;justify-content:space-between;align-items:center;z-index:2}.drawer-head h2{margin:0;font-size:19px}.drawer-body{padding:13px}.section{background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px;margin-bottom:10px;box-shadow:var(--shadow)}.section h3{font-size:13px;margin:0 0 10px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.label{display:block;font-size:10px;color:var(--muted);font-weight:750;margin-bottom:4px}.textarea{min-height:80px;resize:vertical}.contracts,.timeline,.messages{display:flex;flex-direction:column;gap:7px}.contract,.event{border:1px solid #e4eaf2;border-radius:9px;padding:9px;background:#fafcff}.contract-top{display:flex;justify-content:space-between;gap:8px}.contract b{font-size:12px}.contract .service{font-size:11px;margin-top:5px;color:#334155}.event{border-left:3px solid #cbd5e1}.event .date{font-size:10px;color:var(--muted);margin-bottom:3px}.event .text{font-size:11px;white-space:pre-wrap}.messages{max-height:240px;overflow:auto}.msg{max-width:85%;border-radius:10px;padding:8px 10px;font-size:11px;white-space:pre-wrap}.msg.in{background:#eef2ff;align-self:flex-start}.msg.out{background:#dcfce7;align-self:flex-end}.late-text{color:var(--danger);font-weight:800}
    .modal{position:fixed;inset:0;background:rgba(15,23,42,.48);display:none;place-items:center;z-index:70;padding:18px}.modal.show{display:grid}.modal-card{width:min(580px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:15px;padding:18px;box-shadow:0 30px 90px rgba(15,23,42,.28)}.modal-card h2{margin:0 0 6px;font-size:20px}.modal-card p{margin:0 0 13px;color:var(--muted);font-size:12px;line-height:1.45}.upload-zone{border:2px dashed #cbd5e1;border-radius:12px;padding:22px;text-align:center;background:#f8fafc}.upload-zone input{max-width:100%}.progress{height:7px;border-radius:99px;background:#e8edf3;overflow:hidden;margin-top:12px;display:none}.progress>div{height:100%;width:35%;background:var(--accent);animation:move 1s linear infinite}@keyframes move{from{transform:translateX(-100%)}to{transform:translateX(300%)}}.toast{position:fixed;right:18px;bottom:18px;background:#111827;color:#fff;padding:10px 13px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;z-index:90;max-width:420px;font-size:12px}.toast.show{opacity:1;transform:none}
    @media(max-width:1180px){.stats{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.shell{padding:9px}.top{align-items:flex-start;flex-direction:column}.top-actions{width:100%}.stats{grid-template-columns:repeat(2,1fr)}.toolbar{flex-wrap:wrap}.search{flex-basis:100%}.board{min-height:70vh}.column{width:280px;min-width:280px;min-height:65vh}.grid2,.grid3{grid-template-columns:1fr}.drawer{width:100%}}
  </style>
</head>
<body>
<div class="shell">
  <header class="top">
    <div class="brand"><h1>ZakonExpert CRM</h1><p>Сделки, договоры, оплаты и работа с клиентами</p></div>
    <div class="top-actions">
      <span class="integration"><span class="dot <%= integrations.generator ? 'on' : '' %>"></span>Генератор договоров</span>
      <span class="integration"><span class="dot <%= integrations.whatsapp ? 'on' : '' %>"></span>WhatsApp</span>
      <a class="btn small" href="/api/crm/export.csv">CSV</a>
      <button class="btn" id="importContract">↑ Загрузить договор</button>
      <button class="btn primary" id="addClient">+ Сделка</button>
      <form method="post" action="/crm/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger">Выйти</button></form>
    </div>
  </header>

  <section class="stats">
    <div class="stat"><div class="k">Все сделки</div><div class="v" data-k="total">—</div></div>
    <div class="stat"><div class="k">Новые</div><div class="v" data-k="new">—</div></div>
    <div class="stat"><div class="k">Договор создан</div><div class="v" data-k="contract">—</div></div>
    <div class="stat"><div class="k">В работе</div><div class="v" data-k="in_work">—</div></div>
    <div class="stat"><div class="k">Оплачено</div><div class="v" data-k="paidTotal">—</div></div>
    <div class="stat"><div class="k">Обещано</div><div class="v" data-k="promiseTotal">—</div><div class="s" data-k="overdue">—</div></div>
  </section>

  <section class="toolbar">
    <div class="search"><input id="search" class="field" placeholder="Поиск: ФИО, ИИН, телефон, работа, заметка…"></div>
    <button class="btn" id="refresh">Обновить</button>
  </section>

  <div class="board-wrap"><main class="board" id="board"></main></div>
</div>

<div class="overlay" id="overlay"><aside class="drawer" role="dialog" aria-modal="true"><div class="drawer-head"><h2 id="drawerTitle">Сделка</h2><button class="btn small" id="closeDrawer">Закрыть</button></div><div class="drawer-body" id="drawerBody"></div></aside></div>

<div class="modal" id="newModal"><div class="modal-card"><h2>Новая сделка</h2><p>Для ручной карточки достаточно имени и телефона. Данные можно дополнить позже.</p><div class="grid2"><div><label class="label">ФИО</label><input class="field" id="newName"></div><div><label class="label">Телефон *</label><input class="field" id="newPhone" placeholder="+7 700 000 00 00"></div></div><div style="margin-top:8px"><label class="label">Что нужно сделать</label><input class="field" id="newIssue"></div><div style="margin-top:8px"><label class="label">Источник</label><input class="field" id="newSource" value="manual"></div><div class="actions" style="margin-top:12px"><button class="btn primary" id="createClient">Создать</button><button class="btn" data-close="newModal">Отмена</button></div></div></div>

<div class="modal" id="importModal"><div class="modal-card"><h2>Загрузить договор</h2><p>PDF или DOCX разбирается системой договоров. CRM автоматически найдёт или создаст клиента по ИИН/телефону и заполнит ФИО, ИИН, телефон, адрес, номер, сумму и услугу, если они есть в документе.</p><div class="upload-zone"><input id="contractFile" type="file" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"><div class="tiny" style="margin-top:8px">Максимум 10 МБ. Файл хранится приватно и не публикуется на сайте.</div><div class="progress" id="importProgress"><div></div></div></div><div class="actions" style="margin-top:12px"><button class="btn primary" id="doImport">Разобрать и добавить</button><button class="btn" data-close="importModal">Отмена</button></div></div></div>
<div class="toast" id="toast"></div>

<script>
(() => {
  const CSRF=<%- JSON.stringify(csrf) %>;
  const STATUS=<%- JSON.stringify(statusLabels) %>;
  const STAGES=<%- JSON.stringify(pipelineStages) %>;
  const WHATSAPP=<%= integrations.whatsapp ? 'true' : 'false' %>;
  const GENERATOR=<%= integrations.generator ? 'true' : 'false' %>;
  const $=s=>document.querySelector(s); let currentId=''; let timer=null; let clientsCache=[];
  const money=v=>Number(v||0).toLocaleString('ru-RU')+' ₸';
  const dt=v=>v?new Date(Number(v)||v).toLocaleString('ru-RU',{dateStyle:'short',timeStyle:'short'}):'—';
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const attr=v=>String(v??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  const isLate=c=>c.promiseDate && c.promiseDate < new Date().toISOString().slice(0,10) && c.paymentStatus!=='paid';
  function toast(t){const el=$('#toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2600)}
  async function api(url,opt={}){const headers={'Accept':'application/json',...(opt.headers||{})};if(opt.body && !(opt.body instanceof FormData)){headers['Content-Type']='application/json';headers['X-CSRF-Token']=CSRF;opt.body=JSON.stringify(opt.body)}const r=await fetch(url,{credentials:'same-origin',...opt,headers});if(r.status===401){location.href='/crm/login';throw new Error('Сессия завершена')}const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Ошибка');return data}
  function input(id,label,value='',type='text'){return `<div><label class="label" for="${id}">${label}</label><input class="field" id="${id}" type="${type}" value="${attr(value)}"></div>`}
  function selected(k,v){return k===v?'selected':''}

  async function loadSummary(){const s=await api('/api/crm/summary');document.querySelector('[data-k=total]').textContent=s.total||0;document.querySelector('[data-k=new]').textContent=s.byStatus?.new||0;document.querySelector('[data-k=contract]').textContent=s.byStatus?.contract||0;document.querySelector('[data-k=in_work]').textContent=s.byStatus?.in_work||0;document.querySelector('[data-k=paidTotal]').textContent=money(s.paidTotal);document.querySelector('[data-k=promiseTotal]').textContent=money(s.promiseTotal);document.querySelector('[data-k=overdue]').textContent=s.overduePromises?`Просрочено: ${s.overduePromises}`:'Нет просрочек'}

  function dealAmount(c){const contracts=c.contracts||[];if(contracts.length){return Number(contracts[contracts.length-1].amount||0)}return Number(c.promiseAmount||0)}
  function latestService(c){const contracts=c.contracts||[];for(let i=contracts.length-1;i>=0;i--){if(contracts[i].service)return contracts[i].service}return c.work||c.issue||c.question||''}
  function cardHtml(c){const contracts=c.contracts||[];const amount=dealAmount(c);return `<article class="deal" draggable="true" data-id="${attr(c._id)}"><div class="deal-name">${esc(c.name||'Без имени')}</div><div class="deal-meta">${c.phone?`<span>${esc(c.phone)}</span>`:''}${c.iin?`<span>ИИН ${esc(c.iin)}</span>`:''}</div><div class="deal-issue">${esc(latestService(c)||'Работа не указана')}</div><div class="tags">${contracts.length?`<span class="tag contract">📄 ${contracts.length}</span>`:''}${c.paymentStatus==='paid'?'<span class="tag paid">Оплачено</span>':''}${isLate(c)?'<span class="tag late">Просрочка</span>':''}</div><div class="deal-foot"><div class="money">${amount?money(amount):'—'}</div><div class="tiny">${dt(c.updatedAt)}</div></div></article>`}

  function renderBoard(clients){clientsCache=clients;const board=$('#board');board.innerHTML='';for(const stage of STAGES){const items=clients.filter(c=>c.status===stage);const col=document.createElement('section');col.className='column';col.dataset.stage=stage;col.innerHTML=`<div class="column-head"><span>${esc(STATUS[stage]||stage)}</span><span class="column-count">${items.length}</span></div><div class="column-cards">${items.map(cardHtml).join('')||'<div class="empty-col">Перетащите сделку сюда</div>'}</div>`;board.appendChild(col)}bindKanban()}

  function bindKanban(){document.querySelectorAll('.deal').forEach(card=>{card.addEventListener('click',e=>{if(!card.classList.contains('dragging'))openClient(card.dataset.id)});card.addEventListener('dragstart',e=>{card.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',card.dataset.id)});card.addEventListener('dragend',()=>{card.classList.remove('dragging');document.querySelectorAll('.column').forEach(c=>c.classList.remove('drag-over'))})});document.querySelectorAll('.column').forEach(col=>{col.addEventListener('dragover',e=>{e.preventDefault();e.dataTransfer.dropEffect='move';col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',async e=>{e.preventDefault();col.classList.remove('drag-over');const id=e.dataTransfer.getData('text/plain');const client=clientsCache.find(c=>c._id===id);const stage=col.dataset.stage;if(!client||client.status===stage)return;const old=client.status;client.status=stage;renderBoard(clientsCache);try{await api(`/api/crm/clients/${encodeURIComponent(id)}/stage`,{method:'PATCH',body:{stage}});loadSummary();toast(`Перемещено: ${STATUS[stage]}`)}catch(err){client.status=old;renderBoard(clientsCache);toast(err.message)}})})}

  async function loadClients(){const q=encodeURIComponent($('#search').value.trim());const d=await api(`/api/crm/clients?q=${q}&limit=5000`);renderBoard(d.clients||[])}
  async function reload(){await Promise.all([loadSummary(),loadClients()])}

  function renderContracts(c){const contracts=(c.contracts||[]).slice().reverse();if(!contracts.length)return '<div class="tiny">Договоров пока нет</div>';return contracts.map(x=>{const files=[];if(x.storedFile)files.push(`<a class="btn small" href="/api/crm/contracts/${attr(x.id)}/file">Файл</a>`);else{if(x.hasPdf)files.push(`<a class="btn small" href="/api/crm/contracts/${attr(x.id)}/file?kind=pdf">PDF</a>`);if(x.hasDocx)files.push(`<a class="btn small" href="/api/crm/contracts/${attr(x.id)}/file?kind=docx">DOCX</a>`)}return `<div class="contract"><div class="contract-top"><div><b>${esc(x.title)}${x.number?' №'+esc(x.number):''}</b><div class="tiny">${esc(x.date||'')}${x.amount?' · '+money(x.amount):''}${x.source?' · '+esc(x.source):''}</div></div><div class="actions">${files.join('')}${x.contractStatus!=='cancelled'?`<button class="btn small danger cancel-contract" data-contract="${attr(x.id)}">Отменить</button>`:''}</div></div>${x.service?`<div class="service">${esc(x.service)}</div>`:''}</div>`}).join('')}

  function renderClient(c){currentId=c._id;$('#drawerTitle').textContent=c.name||c.phone||c.iin||'Сделка';const statusOptions=STAGES.map(k=>`<option value="${k}" ${selected(k,c.status)}>${esc(STATUS[k]||k)}</option>`).join('');const timeline=(c.timeline||[]).slice().sort((a,b)=>Number(b.at)-Number(a.at)).slice(0,120).map(e=>`<div class="event"><div class="date">${dt(e.at)} · ${esc(e.source||'')}</div><div class="text">${esc(e.text||'')}</div></div>`).join('')||'<div class="tiny">История пуста</div>';const messages=(c.messages||[]).slice().sort((a,b)=>Number(a.at)-Number(b.at)).slice(-100).map(m=>`<div class="msg ${m.direction==='out'?'out':'in'}"><div>${esc(m.text||'')}</div><div class="tiny" style="margin-top:4px">${dt(m.at)}</div></div>`).join('')||'<div class="tiny">Сообщений пока нет</div>';
    $('#drawerBody').innerHTML=`
      <section class="section"><h3>Карточка сделки</h3><div class="grid2">${input('cName','ФИО',c.name)}${input('cIin','ИИН',c.iin)}${input('cPhone','Телефон',c.phone)}${input('cAddress','Адрес',c.address)}<div><label class="label">Стадия</label><select class="field" id="cStatus">${statusOptions}</select></div>${input('cSource','Источник',c.source)}</div><div style="margin-top:8px"><label class="label">Что нужно сделать</label><textarea class="field textarea" id="cIssue">${esc(c.issue||'')}</textarea></div><div style="margin-top:8px"><label class="label">Какая работа выполняется</label><textarea class="field textarea" id="cWork">${esc(c.work||'')}</textarea></div><div style="margin-top:8px"><label class="label">Примечания / договорённости</label><textarea class="field textarea" id="cNotes">${esc(c.notes||'')}</textarea></div><div class="actions" style="margin-top:9px"><button class="btn primary" id="saveClient">Сохранить</button></div></section>
      <section class="section"><h3>Договоры (${(c.contracts||[]).length})</h3><div class="contracts">${renderContracts(c)}</div><div class="grid3" style="margin-top:10px">${input('dTitle','Название','Договор на услуги')}${input('dNumber','Номер','')}${input('dAmount','Сумма, ₸','','number')}</div><div style="margin-top:8px"><label class="label">Услуга / предмет</label><input class="field" id="dService"></div><div class="actions" style="margin-top:9px"><button class="btn" id="addContract">Добавить вручную</button></div></section>
      <section class="section"><h3>Обещание оплаты</h3><div class="grid3">${input('pAmount','Сумма, ₸',c.promiseAmount||'','number')}${input('pDate','Дата обещания',c.promiseDate||'','date')}${input('pNote','Комментарий',c.promiseNote||'')}</div><div class="actions" style="margin-top:9px"><button class="btn" id="savePromise">Записать обещание</button>${isLate(c)?'<span class="late-text">Просрочено</span>':''}</div></section>
      <section class="section"><h3>Оплата</h3><div class="tiny" style="margin-bottom:8px">Уже оплачено: <b>${money(c.paidAmount||0)}</b></div><div class="grid2">${input('payAmount','Добавить оплату, ₸','','number')}${input('payDate','Дата/время','','datetime-local')}</div><div class="actions" style="margin-top:9px"><button class="btn" id="addPayment">Добавить оплату</button></div></section>
      <section class="section"><h3>WhatsApp</h3><div class="messages">${messages}</div>${WHATSAPP?'<div style="margin-top:9px"><textarea class="field textarea" id="waText" placeholder="Сообщение клиенту"></textarea></div><div class="actions" style="margin-top:8px"><button class="btn primary" id="sendWa">Отправить WhatsApp</button></div>':'<div class="tiny" style="margin-top:8px">WhatsApp Cloud API не подключён.</div>'}</section>
      <section class="section"><h3>История</h3><div class="timeline">${timeline}</div></section>`;
    bindDrawerActions()
  }

  async function openClient(id){$('#overlay').classList.add('show');$('#drawerBody').innerHTML='<div style="padding:40px;text-align:center" class="tiny">Загрузка…</div>';try{const d=await api('/api/crm/clients/'+encodeURIComponent(id));renderClient(d.client)}catch(e){toast(e.message)}}
  function bindDrawerActions(){
    $('#saveClient').onclick=async()=>{try{const d=await api(`/api/crm/clients/${currentId}`,{method:'PATCH',body:{name:$('#cName').value,iin:$('#cIin').value,phone:$('#cPhone').value,address:$('#cAddress').value,status:$('#cStatus').value,source:$('#cSource').value,issue:$('#cIssue').value,work:$('#cWork').value,notes:$('#cNotes').value}});renderClient(d.client);toast('Сохранено');reload()}catch(e){toast(e.message)}};
    $('#savePromise').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/promise`,{method:'POST',body:{amount:$('#pAmount').value,date:$('#pDate').value,note:$('#pNote').value}});renderClient(d.client);toast('Обещание записано');reload()};
    $('#addPayment').onclick=async()=>{if(!$('#payAmount').value)return toast('Укажите сумму');const d=await api(`/api/crm/clients/${currentId}/payment`,{method:'POST',body:{amount:$('#payAmount').value,paidAt:$('#payDate').value}});renderClient(d.client);toast('Оплата добавлена');reload()};
    $('#addContract').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/contracts`,{method:'POST',body:{title:$('#dTitle').value,number:$('#dNumber').value,amount:$('#dAmount').value,service:$('#dService').value}});renderClient(d.client);toast('Договор добавлен');reload()};
    document.querySelectorAll('.cancel-contract').forEach(btn=>btn.onclick=async()=>{if(!confirm('Отменить этот договор и перенести сделку в «Отменено»?'))return;const d=await api(`/api/crm/clients/${currentId}/contracts/${encodeURIComponent(btn.dataset.contract)}/cancel`,{method:'POST',body:{}});renderClient(d.client);toast('Договор отменён');reload()});
    const sw=$('#sendWa');if(sw)sw.onclick=async()=>{const text=$('#waText').value.trim();if(!text)return;await api(`/api/crm/clients/${currentId}/whatsapp`,{method:'POST',body:{text}});toast('WhatsApp отправлен');const d=await api(`/api/crm/clients/${currentId}`);renderClient(d.client)}
  }

  function modal(id,show){$('#'+id).classList.toggle('show',show)}
  async function fileBase64(file){return new Promise((resolve,reject)=>{const r=new FileReader();r.onerror=()=>reject(new Error('Не удалось прочитать файл'));r.onload=()=>{const s=String(r.result||'');resolve(s.includes(',')?s.split(',')[1]:s)};r.readAsDataURL(file)})}

  $('#closeDrawer').onclick=()=>$('#overlay').classList.remove('show');$('#overlay').onclick=e=>{if(e.target===$('#overlay'))$('#overlay').classList.remove('show')};$('#refresh').onclick=reload;$('#search').oninput=()=>{clearTimeout(timer);timer=setTimeout(loadClients,220)};$('#addClient').onclick=()=>modal('newModal',true);$('#importContract').onclick=()=>{if(!GENERATOR)toast('Сначала подключите API генератора договоров');modal('importModal',true)};document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>modal(b.dataset.close,false));document.querySelectorAll('.modal').forEach(m=>m.onclick=e=>{if(e.target===m)m.classList.remove('show')});
  $('#createClient').onclick=async()=>{try{const d=await api('/api/crm/clients',{method:'POST',body:{name:$('#newName').value,phone:$('#newPhone').value,issue:$('#newIssue').value,source:$('#newSource').value}});modal('newModal',false);await reload();await openClient(d.client._id);toast('Сделка создана')}catch(e){toast(e.message)}};
  $('#doImport').onclick=async()=>{const file=$('#contractFile').files?.[0];if(!file)return toast('Выберите договор');if(file.size>10*1024*1024)return toast('Файл больше 10 МБ');$('#importProgress').style.display='block';$('#doImport').disabled=true;try{const dataBase64=await fileBase64(file);const d=await api('/api/crm/import-contract',{method:'POST',body:{filename:file.name,mimeType:file.type,dataBase64}});modal('importModal',false);$('#contractFile').value='';await reload();await openClient(d.clientId);const p=d.parsed||{};toast(`Договор добавлен${p.name?' · '+p.name:''}${p.number?' · №'+p.number:''}`)}catch(e){toast(e.message)}finally{$('#importProgress').style.display='none';$('#doImport').disabled=false}};
  reload().catch(e=>toast(e.message));
})();
</script>
</body>
</html>
