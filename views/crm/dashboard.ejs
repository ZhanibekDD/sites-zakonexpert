<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>ZakonExpert CRM</title>
  <style>
    :root{--bg:#f4f7fb;--panel:#fff;--line:#e3e9f2;--text:#172033;--muted:#68758a;--accent:#0f766e;--danger:#b42318;--shadow:0 12px 35px rgba(31,42,68,.08)}
    *{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}.shell{max-width:1540px;margin:auto;padding:20px}.top{display:flex;gap:14px;justify-content:space-between;align-items:center;margin-bottom:16px}.brand h1{margin:0;font-size:26px}.brand p{margin:4px 0 0;color:var(--muted);font-size:13px}.top-actions,.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:10px 13px;font-weight:750;color:#24324a;text-decoration:none}.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}.btn.danger{color:var(--danger)}.btn.small{padding:7px 9px;font-size:12px}.cards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:14px}.card,.section,.toolbar,.table-wrap{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}.card{padding:14px}.card .k{font-size:12px;color:var(--muted)}.card .v{font-size:24px;font-weight:850;margin-top:7px}.card .s{font-size:11px;color:var(--danger);margin-top:4px}.toolbar{padding:11px;display:flex;gap:9px;margin-bottom:11px}.field{width:100%;border:1px solid #cfd8e6;border-radius:10px;background:#fff;padding:10px 11px;outline:none}.field:focus{border-color:#5bb6b0;box-shadow:0 0 0 3px rgba(15,118,110,.10)}.search{flex:1}.table-wrap{overflow:auto;max-height:calc(100vh - 290px)}table{width:100%;border-collapse:collapse;min-width:1080px}th{position:sticky;top:0;background:#f8fafc;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#728096;padding:11px;border-bottom:1px solid var(--line);z-index:1}td{padding:11px;border-bottom:1px solid #edf1f6;vertical-align:top;font-size:13px}tr.client-row:hover{background:#f8fbfd}.name{font-weight:800;font-size:14px}.phone,.muted{color:var(--muted)}.ellipsis{max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.badge{display:inline-flex;border-radius:99px;padding:5px 8px;font-size:11px;font-weight:800;background:#eef2f7}.badge.new{background:#eef2ff;color:#4338ca}.badge.contacted{background:#e0f2fe;color:#0369a1}.badge.agreed{background:#dcfce7;color:#166534}.badge.declined,.badge.lost{background:#fee2e2;color:#991b1b}.badge.in_work{background:#fef3c7;color:#92400e}.badge.waiting_payment{background:#ffedd5;color:#9a3412}.badge.paid,.badge.done{background:#d1fae5;color:#065f46}.late{color:var(--danger);font-weight:800}.empty{padding:42px;text-align:center;color:var(--muted)}.integration{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}.dot{width:8px;height:8px;border-radius:50%;background:#cbd5e1}.dot.on{background:#10b981}
    .overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;z-index:50}.overlay.show{display:block}.drawer{position:absolute;right:0;top:0;width:min(760px,97vw);height:100%;background:#f8fafc;overflow:auto;box-shadow:-25px 0 80px rgba(15,23,42,.25)}.drawer-head{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:15px 18px;display:flex;justify-content:space-between;align-items:center;z-index:2}.drawer-head h2{margin:0;font-size:19px}.drawer-body{padding:14px}.section{padding:14px;margin-bottom:11px}.section h3{font-size:14px;margin:0 0 11px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px}.label{display:block;font-size:11px;color:var(--muted);font-weight:750;margin-bottom:5px}.textarea{min-height:88px;resize:vertical}.contracts,.timeline,.messages{display:flex;flex-direction:column;gap:7px}.contract,.event{border:1px solid #e5eaf1;border-radius:9px;padding:9px;background:#fafcff}.event{border-left:3px solid #cbd5e1}.event .date{font-size:10px;color:var(--muted);margin-bottom:3px}.event .text{font-size:12px;white-space:pre-wrap}.messages{max-height:260px;overflow:auto}.msg{max-width:85%;border-radius:10px;padding:8px 10px;font-size:12px;white-space:pre-wrap}.msg.in{background:#eef2ff;align-self:flex-start}.msg.out{background:#dcfce7;align-self:flex-end}.modal{position:fixed;inset:0;background:rgba(15,23,42,.45);display:none;place-items:center;z-index:70;padding:20px}.modal.show{display:grid}.modal-card{width:min(520px,100%);background:#fff;border-radius:16px;padding:20px}.toast{position:fixed;right:20px;bottom:20px;background:#111827;color:#fff;padding:11px 14px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;z-index:80}.toast.show{opacity:1;transform:none}
    @media(max-width:1100px){.cards{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.shell{padding:11px}.top{align-items:flex-start;flex-direction:column}.cards{grid-template-columns:repeat(2,1fr)}.toolbar{flex-wrap:wrap}.search{flex-basis:100%}.grid2,.grid3{grid-template-columns:1fr}.table-wrap{max-height:none}.drawer{width:100%}}
  </style>
</head>
<body>
<div class="shell">
  <header class="top">
    <div class="brand"><h1>ZakonExpert CRM</h1><p>Клиенты, работа, обещания оплаты, договоры и переписка</p></div>
    <div class="top-actions">
      <span class="integration"><span class="dot <%= integrations.telegram ? 'on' : '' %>"></span>Telegram</span>
      <span class="integration"><span class="dot <%= integrations.whatsapp ? 'on' : '' %>"></span>WhatsApp API</span>
      <a class="btn small" href="/api/crm/export.csv">CSV</a>
      <a class="btn small" href="/api/crm/export.json">Backup JSON</a>
      <button class="btn primary" id="addClient">+ Клиент</button>
      <form method="post" action="/crm/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small danger">Выйти</button></form>
    </div>
  </header>

  <section class="cards">
    <div class="card"><div class="k">Все клиенты</div><div class="v" data-k="total">—</div></div>
    <div class="card"><div class="k">Новые</div><div class="v" data-k="new">—</div></div>
    <div class="card"><div class="k">В работе</div><div class="v" data-k="in_work">—</div></div>
    <div class="card"><div class="k">Ждём оплату</div><div class="v" data-k="waiting_payment">—</div></div>
    <div class="card"><div class="k">Обещано</div><div class="v" data-k="promiseTotal">—</div><div class="s" data-k="overdue">—</div></div>
    <div class="card"><div class="k">Оплачено</div><div class="v" data-k="paidTotal">—</div></div>
  </section>

  <section class="toolbar">
    <div class="search"><input id="search" class="field" placeholder="Поиск: имя, номер, работа, заметка…"></div>
    <select id="statusFilter" class="field" style="width:210px"><option value="">Все статусы</option><% Object.entries(statusLabels).forEach(([key,label]) => { %><option value="<%= key %>"><%= label %></option><% }) %></select>
    <button class="btn" id="refresh">Обновить</button>
  </section>

  <section class="table-wrap">
    <table><thead><tr><th>Клиент</th><th>Статус</th><th>Работа</th><th>Обещание</th><th>Оплачено</th><th>Договоры</th><th>Обновлено</th></tr></thead><tbody id="clientRows"></tbody></table>
    <div id="empty" class="empty" hidden>По этому фильтру клиентов нет.</div>
  </section>
</div>

<div class="overlay" id="overlay"><aside class="drawer" role="dialog" aria-modal="true"><div class="drawer-head"><h2 id="drawerTitle">Клиент</h2><button class="btn small" id="closeDrawer">Закрыть</button></div><div class="drawer-body" id="drawerBody"></div></aside></div>

<div class="modal" id="newModal"><div class="modal-card"><h2>Новый клиент</h2><div class="grid2"><div><label class="label">Имя</label><input class="field" id="newName"></div><div><label class="label">Телефон *</label><input class="field" id="newPhone" placeholder="+7 700 000 00 00"></div></div><div style="margin-top:9px"><label class="label">Что нужно сделать</label><input class="field" id="newIssue"></div><div style="margin-top:9px"><label class="label">Источник</label><input class="field" id="newSource" value="manual"></div><div class="actions" style="margin-top:12px"><button class="btn primary" id="createClient">Создать</button><button class="btn" id="cancelNew">Отмена</button></div></div></div>
<div class="toast" id="toast"></div>

<script>
(() => {
  const CSRF=<%- JSON.stringify(csrf) %>;
  const STATUS=<%- JSON.stringify(statusLabels) %>;
  const WHATSAPP=<%= integrations.whatsapp ? 'true' : 'false' %>;
  const $=s=>document.querySelector(s); let currentId=''; let timer=null;
  const money=v=>Number(v||0).toLocaleString('ru-RU')+' ₸';
  const dt=v=>v?new Date(Number(v)||v).toLocaleString('ru-RU',{dateStyle:'short',timeStyle:'short'}):'—';
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  const attr=v=>String(v??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  const isLate=c=>c.promiseDate && c.promiseDate < new Date().toISOString().slice(0,10) && c.paymentStatus!=='paid';
  function toast(t){const el=$('#toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2200)}
  async function api(url,opt={}){const headers={'Accept':'application/json',...(opt.headers||{})};if(opt.body){headers['Content-Type']='application/json';headers['X-CSRF-Token']=CSRF;opt.body=JSON.stringify(opt.body)}const r=await fetch(url,{credentials:'same-origin',...opt,headers});if(r.status===401){location.href='/crm/login';throw new Error('Сессия завершена')}const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Ошибка');return data}
  function input(id,label,value='',type='text'){return `<div><label class="label" for="${id}">${label}</label><input class="field" id="${id}" type="${type}" value="${attr(value)}"></div>`}

  async function loadSummary(){const s=await api('/api/crm/summary');document.querySelector('[data-k=total]').textContent=s.total||0;document.querySelector('[data-k=new]').textContent=s.byStatus?.new||0;document.querySelector('[data-k=in_work]').textContent=s.byStatus?.in_work||0;document.querySelector('[data-k=waiting_payment]').textContent=s.byStatus?.waiting_payment||0;document.querySelector('[data-k=promiseTotal]').textContent=money(s.promiseTotal);document.querySelector('[data-k=paidTotal]').textContent=money(s.paidTotal);document.querySelector('[data-k=overdue]').textContent=s.overduePromises?`Просрочено обещаний: ${s.overduePromises}`:'Нет просроченных обещаний'}
  function renderClients(clients){const rows=$('#clientRows');rows.innerHTML='';$('#empty').hidden=clients.length>0;for(const c of clients){const tr=document.createElement('tr');tr.className='client-row';tr.style.cursor='pointer';tr.innerHTML=`<td><div class="name">${esc(c.name||'Без имени')}</div><div class="phone">${esc(c.phone||'—')}</div><div class="muted ellipsis">${esc(c.issue||c.source||'')}</div></td><td><span class="badge ${esc(c.status)}">${esc(STATUS[c.status]||c.status)}</span></td><td class="ellipsis">${esc(c.work||c.question||'—')}</td><td><div>${c.promiseAmount?money(c.promiseAmount):'—'}</div><div class="${isLate(c)?'late':'muted'}">${esc(c.promiseDate||'')}</div></td><td>${c.paidAmount?money(c.paidAmount):'—'}</td><td>${(c.contracts||[]).length}</td><td class="muted">${dt(c.updatedAt)}</td>`;tr.onclick=()=>openClient(c._id);rows.appendChild(tr)}}
  async function loadClients(){const q=encodeURIComponent($('#search').value.trim());const status=encodeURIComponent($('#statusFilter').value);const d=await api(`/api/crm/clients?q=${q}&status=${status}&limit=2000`);renderClients(d.clients||[])}
  async function reload(){await Promise.all([loadSummary(),loadClients()])}

  function renderClient(c){currentId=c._id;$('#drawerTitle').textContent=c.name||c.phone||'Клиент';const statusOptions=Object.entries(STATUS).map(([k,v])=>`<option value="${k}" ${c.status===k?'selected':''}>${esc(v)}</option>`).join('');const contracts=(c.contracts||[]).slice().reverse().map(x=>`<div class="contract"><b>${esc(x.title)}${x.number?' №'+esc(x.number):''}</b><div class="muted">${esc(x.date||'')}${x.amount?' · '+money(x.amount):''}${x.source?' · '+esc(x.source):''}</div>${x.fileUrl?`<a href="${attr(x.fileUrl)}" target="_blank" rel="noopener">Открыть файл</a>`:''}</div>`).join('')||'<div class="muted">Договоров пока нет</div>';const timeline=(c.timeline||[]).slice().sort((a,b)=>Number(b.at)-Number(a.at)).slice(0,100).map(e=>`<div class="event"><div class="date">${dt(e.at)} · ${esc(e.source||'')}</div><div class="text">${esc(e.text||'')}</div></div>`).join('')||'<div class="muted">История пуста</div>';const messages=(c.messages||[]).slice().sort((a,b)=>Number(a.at)-Number(b.at)).slice(-100).map(m=>`<div class="msg ${m.direction==='out'?'out':'in'}"><div>${esc(m.text||'')}</div><div class="muted" style="font-size:10px;margin-top:4px">${dt(m.at)}</div></div>`).join('')||'<div class="muted">Сообщений в CRM пока нет</div>';
    $('#drawerBody').innerHTML=`
      <section class="section"><h3>Карточка клиента</h3><div class="grid2">${input('cName','ФИО',c.name)}${input('cPhone','Телефон',c.phone)}<div><label class="label">Статус</label><select class="field" id="cStatus">${statusOptions}</select></div>${input('cSource','Источник',c.source)}${input('cIssue','Что нужно сделать',c.issue)}${input('cCampaign','Кампания',c.campaign)}</div><div style="margin-top:9px"><label class="label">Какая работа выполняется</label><textarea class="field textarea" id="cWork">${esc(c.work||'')}</textarea></div><div style="margin-top:9px"><label class="label">Примечания / договорённости</label><textarea class="field textarea" id="cNotes">${esc(c.notes||'')}</textarea></div><div class="actions" style="margin-top:10px"><button class="btn primary" id="saveClient">Сохранить</button></div></section>
      <section class="section"><h3>Обещание оплаты</h3><div class="grid3">${input('pAmount','Сумма, ₸',c.promiseAmount||'','number')}${input('pDate','Дата обещания',c.promiseDate||'','date')}${input('pNote','Комментарий',c.promiseNote||'')}</div><div class="actions" style="margin-top:10px"><button class="btn" id="savePromise">Записать обещание</button>${isLate(c)?'<span class="late">Обещание просрочено</span>':''}</div></section>
      <section class="section"><h3>Оплата</h3><div class="muted" style="margin-bottom:8px">Уже оплачено: <b>${money(c.paidAmount||0)}</b></div><div class="grid2">${input('payAmount','Добавить оплату, ₸','','number')}${input('payDate','Дата/время','','datetime-local')}</div><div class="actions" style="margin-top:10px"><button class="btn" id="addPayment">Добавить оплату</button></div></section>
      <section class="section"><h3>Договоры (${(c.contracts||[]).length})</h3><div class="contracts">${contracts}</div><div class="grid3" style="margin-top:10px">${input('dTitle','Название','Договор на услуги')}${input('dNumber','Номер','')}${input('dAmount','Сумма, ₸','','number')}</div><div class="actions" style="margin-top:10px"><button class="btn" id="addContract">Добавить договор</button></div></section>
      <section class="section"><h3>WhatsApp</h3><div class="messages">${messages}</div>${WHATSAPP?'<div style="margin-top:10px"><textarea class="field textarea" id="waText" placeholder="Сообщение клиенту"></textarea></div><div class="actions" style="margin-top:9px"><button class="btn primary" id="sendWa">Отправить WhatsApp</button></div>':'<div class="muted" style="margin-top:10px">Официальный WhatsApp Cloud API ещё не подключён.</div>'}</section>
      <section class="section"><h3>История</h3><div class="timeline">${timeline}</div></section>`;
    bindActions()
  }
  async function openClient(id){$('#overlay').classList.add('show');$('#drawerBody').innerHTML='<div class="empty">Загрузка…</div>';const d=await api('/api/crm/clients/'+encodeURIComponent(id));renderClient(d.client)}
  function bindActions(){
    $('#saveClient').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}`,{method:'PATCH',body:{name:$('#cName').value,phone:$('#cPhone').value,status:$('#cStatus').value,source:$('#cSource').value,issue:$('#cIssue').value,campaign:$('#cCampaign').value,work:$('#cWork').value,notes:$('#cNotes').value}});renderClient(d.client);toast('Сохранено');reload()};
    $('#savePromise').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/promise`,{method:'POST',body:{amount:$('#pAmount').value,date:$('#pDate').value,note:$('#pNote').value}});renderClient(d.client);toast('Обещание записано');reload()};
    $('#addPayment').onclick=async()=>{if(!$('#payAmount').value)return toast('Укажите сумму');const d=await api(`/api/crm/clients/${currentId}/payment`,{method:'POST',body:{amount:$('#payAmount').value,paidAt:$('#payDate').value}});renderClient(d.client);toast('Оплата добавлена');reload()};
    $('#addContract').onclick=async()=>{const d=await api(`/api/crm/clients/${currentId}/contracts`,{method:'POST',body:{title:$('#dTitle').value,number:$('#dNumber').value,amount:$('#dAmount').value}});renderClient(d.client);toast('Договор добавлен');reload()};
    const sw=$('#sendWa');if(sw)sw.onclick=async()=>{const text=$('#waText').value.trim();if(!text)return;await api(`/api/crm/clients/${currentId}/whatsapp`,{method:'POST',body:{text}});toast('WhatsApp отправлен');const d=await api(`/api/crm/clients/${currentId}`);renderClient(d.client);reload()}
  }
  $('#closeDrawer').onclick=()=>$('#overlay').classList.remove('show');$('#overlay').onclick=e=>{if(e.target===$('#overlay'))$('#overlay').classList.remove('show')};$('#refresh').onclick=reload;$('#statusFilter').onchange=loadClients;$('#search').oninput=()=>{clearTimeout(timer);timer=setTimeout(loadClients,250)};$('#addClient').onclick=()=>$('#newModal').classList.add('show');$('#cancelNew').onclick=()=>$('#newModal').classList.remove('show');$('#newModal').onclick=e=>{if(e.target===$('#newModal'))$('#newModal').classList.remove('show')};$('#createClient').onclick=async()=>{try{const d=await api('/api/crm/clients',{method:'POST',body:{name:$('#newName').value,phone:$('#newPhone').value,issue:$('#newIssue').value,source:$('#newSource').value}});$('#newModal').classList.remove('show');await reload();await openClient(d.client._id);toast('Клиент создан')}catch(e){toast(e.message)}};reload().catch(e=>toast(e.message));
})();
</script>
</body>
</html>
