<%
function esc(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function formatDate(value) {
  const raw = String(value == null ? '' : value).trim();
  if (!raw) return '';
  const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
  const dmy = raw.match(/^(\d{2})\.(\d{2})\.(\d{4})/);
  const date = iso
    ? new Date(Date.UTC(Number(iso[1]), Number(iso[2]) - 1, Number(iso[3])))
    : (dmy ? new Date(Date.UTC(Number(dmy[3]), Number(dmy[2]) - 1, Number(dmy[1]))) : null);
  return date && !isNaN(date.getTime())
    ? date.toLocaleDateString(locale.hreflang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
    : raw;
}
function contactHref(contact) {
  if (['phone', 'mobile_phone', 'fax'].includes(contact.type)) {
    return 'tel:' + String(contact.normalized || contact.value).replace(/[^\d+]/g, '');
  }
  if (contact.type === 'whatsapp') {
    return 'https://wa.me/' + String(contact.normalized || contact.value).replace(/\D/g, '');
  }
  if (contact.type === 'email') return 'mailto:' + contact.value;
  if ([
    'website', 'telegram', 'vkontakte', 'odnoklassniki',
    'youtube', 'rutube', 'yandex_zen',
  ].includes(contact.type) && /^https?:\/\//i.test(contact.value)) return contact.value;
  return null;
}

const displayNameKk = company.display_name_kk || null;
const name = locale.code === 'kk'
  ? (displayNameKk || company.name_ru)
  : (company.name_ru || displayNameKk);
const official = Boolean(company.is_official_source);
const hasVerifiedBin = /^\d{12}$/.test(String(company.bin || '').trim());
const quality = companyQuality || { score: 0, minScore: 7, indexable: false };
const canonical = 'https://zakonexpertt.kz/company/' + company.slug;
const pageTitle = name + (company.bin ? ' — ' + copy.bin + ' ' + company.bin : '');
const pageDesc = name + (company.bin ? ' — ' + copy.bin + ' ' + company.bin : '')
  + (company.address_ru ? '. ' + copy.legalAddress + ': ' + company.address_ru : '')
  + '. ' + (official ? copy.officialNotice : copy.directoryNotice);

const aliases = (company.names || [])
  .map(item => item.value)
  .concat([company.name_ru, displayNameKk])
  .filter(function(value, index, values) {
    return value && value !== name && values.indexOf(value) === index;
  });
const addresses = company.addresses || [];
const additionalAddresses = addresses.filter(function(address) {
  return address.value && address.value !== company.address_ru;
});
const contacts = company.contacts || [];
const publicAttributes = company.attributes || [];

const schemaAddresses = addresses.slice(0, 10).map(function(address) {
  return {
    '@type': 'PostalAddress',
    streetAddress: address.value,
    addressLocality: address.city || undefined,
    postalCode: address.postalCode || undefined,
    addressRegion: address.regionSlug || undefined,
    addressCountry: 'KZ',
  };
});
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name,
  alternateName: aliases.length ? aliases.slice(0, 20) : undefined,
  mainEntityOfPage: canonical,
  identifier: hasVerifiedBin ? {
    '@type': 'PropertyValue',
    propertyID: 'KZ BIN',
    value: company.bin,
  } : undefined,
  foundingDate: company.registration_date || undefined,
  dissolutionDate: company.dissolution_date || undefined,
  address: schemaAddresses.length ? schemaAddresses : undefined,
  telephone: contacts
    .filter(contact => ['phone', 'mobile_phone'].includes(contact.type))
    .map(contact => contact.normalized || contact.value)
    .slice(0, 10),
  email: contacts.filter(contact => contact.type === 'email').map(contact => contact.value).slice(0, 10),
  sameAs: contacts
    .filter(contact => [
      'website', 'telegram', 'vkontakte', 'odnoklassniki',
      'youtube', 'rutube', 'yandex_zen',
    ].includes(contact.type) && /^https?:\/\//i.test(contact.value))
    .map(contact => contact.value)
    .slice(0, 10),
};

const infoRows = official
  ? [
    ['bi-building', copy.bin, company.bin],
    ['bi-calendar3', copy.registrationDate, formatDate(company.registration_date)],
    ['bi-briefcase', copy.activity, company.activity_ru],
    ['bi-person-badge', copy.leader, company.leader_display || company.leader],
    ['bi-geo-alt', copy.legalAddress, company.address_ru],
    ['bi-translate', copy.kazakhName, displayNameKk && displayNameKk !== name ? displayNameKk : null],
    ['bi-map', copy.region, regionName],
  ]
  : [
    ['bi-briefcase', copy.category, company.activity_ru],
    ['bi-geo-alt', copy.directoryAddress, company.address_ru],
    ['bi-map', copy.region, regionName],
  ].filter(row => row[2]);

const missingOfficialFields = official
  ? infoRows.filter(row => !row[2]).map(row => row[1])
  : [];

const infoHtml = infoRows.map(function(row) {
  return '<div class="company-info-row">'
    + '<i class="bi ' + row[0] + ' company-info-row__icon" aria-hidden="true"></i>'
    + '<div class="company-info-row__label">' + esc(row[1]) + '</div>'
    + '<div class="company-info-row__value' + (row[2] ? '' : ' company-info-row__value--missing') + '">'
    + esc(row[2] || copy.notPublishedBySource) + '</div></div>';
}).join('');

const missingOfficialHtml = missingOfficialFields.length
  ? '<div style="margin:12px 0 4px;padding:12px 14px;border-radius:10px;background:#fff7ed;color:#9a3412;font-size:.78rem;line-height:1.5;"><i class="bi bi-info-circle" aria-hidden="true"></i> '
    + esc(copy.missingOfficialFields) + ': ' + esc(missingOfficialFields.join(', ')) + '.</div>'
  : '';

const contactHtml = contacts.length || publicAttributes.length
  ? '<section class="company-detail-card"><h2 class="company-detail-card__title">' + esc(copy.contacts) + '</h2>'
    + contacts.map(function(contact) {
      const href = contactHref(contact);
      const value = href
        ? '<a href="' + esc(href) + '"' + (/^https?:/i.test(href) ? ' target="_blank" rel="noopener"' : '') + ' style="color:#1a56db;font-weight:650;text-decoration:none;">' + esc(contact.value) + '</a>'
        : esc(contact.value);
      return '<div class="company-contact-row">'
        + '<div class="company-contact-row__label">' + esc(copy[contact.type] || contact.type) + '</div>'
        + '<div class="company-contact-row__value">' + value
        + (contact.sourceLabel ? '<div style="font-size:.7rem;color:#94a3b8;margin-top:3px;">' + esc(copy.source) + ': ' + esc(contact.sourceLabel) + '</div>' : '')
        + '</div></div>';
    }).join('')
    + publicAttributes.map(function(attribute) {
      return '<div class="company-contact-row">'
        + '<div class="company-contact-row__label">' + esc(copy[attribute.type] || attribute.type) + '</div>'
        + '<div class="company-contact-row__value">' + esc(attribute.value) + '</div></div>';
    }).join('')
    + '</section>'
  : '';

const aliasesHtml = aliases.length
  ? '<section style="background:#fff;border:1px solid #dbe4f0;border-radius:16px;padding:20px 24px;margin-top:18px;"><h2 style="font-size:1.08rem;color:#0d1f3c;">' + esc(copy.aliases) + '</h2><ul style="margin:10px 0 0;padding-left:20px;color:#475569;">'
    + aliases.slice(0, 20).map(alias => '<li>' + esc(alias) + '</li>').join('') + '</ul></section>'
  : '';

const categoriesHtml = company.categories && company.categories.length
  ? '<section style="margin-top:18px;"><h2 style="font-size:1.08rem;color:#0d1f3c;">' + esc(copy.categories) + '</h2><div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:10px;">'
    + company.categories.slice(0, 30).map(function(category) {
      return '<span style="background:#eef5ff;color:#164a8a;border-radius:999px;padding:7px 11px;font-size:.78rem;">'
        + esc(category.category + (category.subcategory ? ' — ' + category.subcategory : '')) + '</span>';
    }).join('') + '</div></section>'
  : '';

const addressesHtml = additionalAddresses.length
  ? '<section style="background:#fff;border:1px solid #dbe4f0;border-radius:16px;padding:20px 24px;margin-top:18px;"><h2 style="font-size:1.08rem;color:#0d1f3c;">' + esc(copy.additionalAddresses) + '</h2>'
    + additionalAddresses.slice(0, 20).map(function(address) {
      return '<div style="padding:11px 0;border-bottom:1px solid #edf2f7;color:#475569;"><i class="bi bi-geo-alt" aria-hidden="true"></i> ' + esc(address.value)
        + (address.sourceLabel ? '<div style="font-size:.7rem;color:#94a3b8;margin:3px 0 0 22px;">' + esc(copy.source) + ': ' + esc(address.sourceLabel) + '</div>' : '') + '</div>';
    }).join('') + '</section>'
  : '';

const statusRaw = String(company.status_ru || '');
const statusState = /(ликвид|прекращ|реорганиз|исключен|недейств)/i.test(statusRaw)
  ? 'liquidated'
  : (statusRaw ? 'active' : 'unknown');
const correction = company.correction || null;
const statusNote = correction && correction.statusNote
  ? correction.statusNote
  : (official ? copy.officialStatusNote : copy.directoryStatusNote);
const correctionHtml = correction
  ? '<section style="margin:0 0 18px;padding:18px 20px;border:1px solid #f0c36b;border-left:5px solid #c88712;border-radius:14px;background:#fff9e9;color:#5d410b;">'
    + '<div style="display:flex;gap:11px;align-items:flex-start;"><i class="bi bi-patch-check-fill" style="font-size:1.25rem;color:#b7790b;margin-top:1px;"></i><div>'
    + '<h2 style="margin:0 0 7px;font-size:1rem;color:#4b3308;">' + esc(correction.title || 'Сведения актуализированы') + '</h2>'
    + '<p style="margin:0;color:#6f5118;font-size:.84rem;line-height:1.62;">' + esc(correction.summary || '') + '</p>'
    + '<p style="margin:9px 0 0;color:#8a6a2d;font-size:.72rem;line-height:1.5;"><strong>Основание:</strong> ' + esc(correction.sourceLabel || '')
    + (correction.sourceDate ? ' от ' + esc(formatDate(correction.sourceDate)) : '')
    + (correction.verifiedAt ? '. Проверено ZakonExpert: ' + esc(formatDate(correction.verifiedAt)) : '') + '.</p>'
    + '</div></div></section>'
  : '';
const statusStyle = statusState === 'active'
  ? { bg: '#f0fdf4', border: '#bbf7d0', fg: '#166534', icon: 'bi-check-circle-fill' }
  : (statusState === 'liquidated'
    ? { bg: '#fef2f2', border: '#fecaca', fg: '#991b1b', icon: 'bi-x-circle-fill' }
    : { bg: '#f1f5f9', border: '#e2e8f0', fg: '#64748b', icon: 'bi-question-circle-fill' });

const reportText = encodeURIComponent(copy.report + ': "' + name + '" (' + copy.bin + ' ' + (company.bin || '—') + ', ' + canonical + ').');
const consultationText = encodeURIComponent(
  copy.consultation + ': «' + name + '». '
  + copy.bin + ': ' + (company.bin || '—') + '. '
  + canonical + '\n' + copy.itemHelpText
);
const consultationHref = 'https://wa.me/77003097566?text=' + consultationText;
const sourceNotice = official ? copy.officialNotice : copy.directoryNotice;
const languageLinks = languages.map(function(language) {
  return { ...language, href: language.companyHref };
});
const relatedHelpHtml = '<section style="background:#fff;border:1px solid #dbe4f0;border-radius:16px;padding:20px 24px;margin-top:18px;">'
  + '<h2 style="font-size:1.08rem;color:#0d1f3c;margin:0 0 12px;">' + esc(copy.relatedHelp) + '</h2>'
  + '<div style="display:grid;gap:9px;">'
  + '<a href="/snyatie-ogranichenii-chsi" style="color:#1a56db;text-decoration:none;font-weight:650;">' + esc(copy.helpArrest) + ' →</a>'
  + '<a href="/otmena-ispolnitelnoi-nadpisi" style="color:#1a56db;text-decoration:none;font-weight:650;">' + esc(copy.helpInscription) + ' →</a>'
  + '<a href="/grafik-oplaty-zadolzhennosti" style="color:#1a56db;text-decoration:none;font-weight:650;">' + esc(copy.helpSchedule) + ' →</a>'
  + '<a href="/marshrut-dolzhnika" style="color:#1a56db;text-decoration:none;font-weight:650;">' + esc(copy.helpRoute) + ' →</a>'
  + '</div></section>';

const body = '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb"><a href="/">' + esc(copy.home) + '</a><span class="npage-bc-sep">/</span><a href="' + companyCatalogPath + '">' + esc(copy.companies) + '</a><span class="npage-bc-sep">/</span><span>' + esc(name) + '</span></nav>'
  + '<section class="npage-hero"><div class="npage-badges"><span class="npage-badge">' + esc(official ? copy.officialBadge : copy.directoryBadge) + '</span></div>'
  + '<h1 class="npage-h1" style="max-width:1050px;">' + esc(name) + '</h1>'
  + (company.bin ? '<p style="font-size:1.08rem;color:#1a56db;font-weight:700;margin-top:10px;">' + esc(copy.bin) + ' ' + esc(company.bin) + '</p>' : '') + '</section>'
  + correctionHtml
  + '<div class="company-item-grid">'
  + '<div><div class="company-info-card"><h2 class="company-info-card__title">' + esc(official ? copy.officialDetails : copy.directoryDetails) + '</h2>' + infoHtml + missingOfficialHtml + '</div>'
  + contactHtml + addressesHtml + aliasesHtml + categoriesHtml + relatedHelpHtml
  + '<div style="margin-top:18px;padding:15px 18px;border:1px solid #dbe4f0;border-radius:12px;background:#f8fafc;color:#475569;font-size:.82rem;line-height:1.55;">' + esc(sourceNotice)
  + (sourceUpdatedAt ? ' ' + esc(copy.updated) + ': ' + esc(formatDate(sourceUpdatedAt)) + '.' : '') + '</div></div>'
  + '<aside style="display:grid;gap:14px;">'
  + '<div style="background:' + statusStyle.bg + ';border:1px solid ' + statusStyle.border + ';border-radius:14px;padding:18px;"><h2 style="font-size:.96rem;color:#0d1f3c;">' + esc(copy.status) + '</h2>'
  + '<div style="display:flex;gap:9px;color:' + statusStyle.fg + ';font-weight:750;"><i class="bi ' + statusStyle.icon + '"></i>' + esc(statusRaw || copy.notPublished) + '</div>'
  + '<p style="margin:8px 0 0;color:#475569;font-size:.79rem;line-height:1.5;">' + esc(statusNote) + '</p></div>'
  + '<section class="company-conversion-card" aria-label="' + esc(copy.legalHelp) + '">'
  + '<p class="company-conversion-card__eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> ' + esc(copy.legalHelp) + '</p>'
  + '<h2 class="company-conversion-card__title" data-company-offer data-offer-a="' + esc(copy.offerTitleA) + '" data-offer-b="' + esc(copy.offerTitleB) + '">' + esc(copy.offerTitleA) + '</h2>'
  + '<p class="company-conversion-card__text" data-company-offer data-offer-a="' + esc(copy.offerTextA) + '" data-offer-b="' + esc(copy.offerTextB) + '">' + esc(copy.offerTextA) + '</p>'
  + '<a class="company-conversion-card__button" href="' + consultationHref + '" target="_blank" rel="noopener" data-company-whatsapp data-cta-position="sidebar"><i class="bi bi-whatsapp" aria-hidden="true"></i><span data-company-offer data-offer-a="' + esc(copy.offerButtonA) + '" data-offer-b="' + esc(copy.offerButtonB) + '">' + esc(copy.offerButtonA) + '</span></a>'
  + '<p class="company-conversion-card__trust"><i class="bi bi-lock" aria-hidden="true"></i> ' + esc(copy.offerTrust) + '</p></section>'
  + '<div style="background:#fff;border:1px solid #dbe4f0;border-radius:14px;padding:18px;display:grid;gap:10px;">'
  + (locale.code === 'ru' && hasVerifiedBin ? '<a href="/proverka-kontragenta#bin=' + esc(company.bin) + '" style="color:#0d1f3c;text-decoration:none;font-size:.84rem;font-weight:700;"><i class="bi bi-shield-check" style="color:#16845b;"></i> Проверить сведения КГД по БИН</a>' : '')
  + '<a href="' + companyCatalogPath + '" style="color:#0d1f3c;text-decoration:none;font-size:.84rem;"><i class="bi bi-search" style="color:#1a56db;"></i> ' + esc(copy.anotherCompany) + '</a>'
  + '<a href="https://wa.me/77003097566?text=' + reportText + '" target="_blank" rel="noopener" style="color:#0d1f3c;text-decoration:none;font-size:.84rem;"><i class="bi bi-flag" style="color:#1a56db;"></i> ' + esc(copy.report) + '</a></div>'
  + '</aside></div>'
  + '<div class="npage-cta" style="margin-top:28px;"><div class="npage-cta-left"><p class="npage-cta-label">' + esc(copy.legalHelp) + '</p>'
  + '<h2 class="npage-cta-title" data-company-offer data-offer-a="' + esc(copy.offerTitleA) + '" data-offer-b="' + esc(copy.offerTitleB) + '">' + esc(copy.offerTitleA) + '</h2><p class="npage-cta-sub" data-company-offer data-offer-a="' + esc(copy.offerTextA) + '" data-offer-b="' + esc(copy.offerTextB) + '">' + esc(copy.offerTextA) + '</p></div>'
  + '<a class="npage-wa-btn" href="' + consultationHref + '" target="_blank" rel="noopener" data-company-whatsapp data-cta-position="bottom"><span data-company-offer data-offer-a="' + esc(copy.offerButtonA) + '" data-offer-b="' + esc(copy.offerButtonB) + '">' + esc(copy.offerButtonA) + '</span></a></div>'
  + '</div></div>';
%>
<%- include('./layout', {
  title: pageTitle,
  description: pageDesc,
  canonical,
  noindex: localized || !name || !quality.indexable,
  schema,
  alternates: [],
  locale,
  copy,
  languages: languageLinks,
  companyCatalogPath,
  whatsappHref: consultationHref,
  companyCta: true,
  companyPageType: 'company_card',
  body
}) %>
