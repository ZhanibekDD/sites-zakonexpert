<%
function esc(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function number(value) { return new Intl.NumberFormat('ru-RU').format(value || 0); }

const pageTitle = 'Компании Казахстана — поиск по БИН и названию | ZakonExpert';
const pageDesc = 'Официальные регистрационные данные юридических лиц, филиалов и представительств Казахстана. Поиск компании по БИН или названию.';
const canonical = 'https://zakonexpertt.kz/companies';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage',
  name: 'Компании Казахстана', url: canonical, description: pageDesc,
};

let resultsHtml = '';
if (query && results.items.length === 0) {
  resultsHtml = '<div class="npage-card" style="padding:24px;text-align:center;color:#64748b;">По запросу <strong>' + esc(query) + '</strong> ничего не найдено.</div>';
} else if (results.items.length) {
  resultsHtml = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px;">'
    + results.items.map(function(company) {
      return '<a href="/company/' + esc(company.slug) + '" style="display:block;background:#fff;border:1px solid #dbe4f0;border-radius:14px;padding:18px;text-decoration:none;color:#0d1f3c;">'
        + '<div style="font-weight:750;font-size:1rem;line-height:1.35;">' + esc(company.name_ru || company.name_kk) + '</div>'
        + (company.bin ? '<div style="margin-top:8px;color:#1a56db;font-size:.88rem;">БИН ' + esc(company.bin) + '</div>' : '')
        + (company.status_ru ? '<div style="margin-top:7px;color:#64748b;font-size:.82rem;">' + esc(company.status_ru) + '</div>' : '')
        + (company.address_ru ? '<div style="margin-top:7px;color:#475569;font-size:.84rem;line-height:1.45;">📍 ' + esc(company.address_ru) + '</div>' : '')
        + '</a>';
    }).join('') + '</div>';
}

let paginationHtml = '';
if (query && (results.page > 1 || results.hasMore)) {
  paginationHtml = '<div style="display:flex;gap:10px;justify-content:center;margin-top:22px;">'
    + (results.page > 1 ? '<a class="btn btn-outline-primary" href="/companies?q=' + encodeURIComponent(query) + '&page=' + (results.page - 1) + '">← Назад</a>' : '')
    + (results.hasMore ? '<a class="btn btn-primary" href="/companies?q=' + encodeURIComponent(query) + '&page=' + (results.page + 1) + '">Дальше →</a>' : '')
    + '</div>';
}

const catalogLinks = [
  ['/banks', '🏦', 'Банки'], ['/mfo', '💳', 'МФО'], ['/collectors', '⚖️', 'Коллекторы'],
  ['/lombards', '🏪', 'Ломбарды'], ['/insurance', '🛡️', 'Страховые компании'],
];
const linksHtml = catalogLinks.map(function(item) {
  return '<a href="' + item[0] + '" style="background:#fff;border:1px solid #dbe4f0;border-radius:12px;padding:15px;text-decoration:none;color:#0d1f3c;font-weight:650;">'
    + '<span style="font-size:1.25rem;margin-right:8px;">' + item[1] + '</span>' + item[2] + '</a>';
}).join('');

const countText = stats.available ? number(stats.count) + ' организаций' : 'База подготавливается';
const body = '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><span>Компании Казахстана</span></nav>'
  + '<section class="npage-hero"><div class="npage-badges"><span class="npage-badge">Официальные открытые данные</span></div>'
  + '<h1 class="npage-h1">Компании Казахстана</h1>'
  + '<p style="color:#475569;max-width:760px;">Поиск юридических лиц, филиалов и представительств по названию или БИН. Источник — Министерство юстиции РК через data.egov.kz.</p>'
  + '<div style="margin-top:16px;color:#0d1f3c;font-weight:700;">' + countText + '</div></section>'
  + '<form action="/companies" method="get" style="display:flex;gap:10px;background:#fff;border:1px solid #dbe4f0;border-radius:14px;padding:14px;margin:22px 0;box-shadow:0 8px 24px rgba(13,31,60,.06);">'
  + '<label class="visually-hidden" for="company-q">Название или БИН</label>'
  + '<input id="company-q" name="q" value="' + esc(query) + '" minlength="2" placeholder="Введите название или БИН компании" style="flex:1;min-width:0;border:1px solid #cbd5e1;border-radius:10px;padding:12px 14px;font-size:1rem;">'
  + '<button type="submit" class="btn btn-primary" style="padding:0 24px;">Найти</button></form>'
  + (!query ? '<a href="/companies/regions" style="display:inline-flex;align-items:center;gap:8px;color:#1a56db;font-weight:650;font-size:.88rem;text-decoration:none;margin-bottom:18px;">🗺️ Смотреть компании по регионам</a>' : '')
  + resultsHtml + paginationHtml
  + '<section style="margin-top:34px;"><h2 style="color:#0d1f3c;font-size:1.35rem;">Отдельные финансовые реестры</h2>'
  + '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-top:14px;">' + linksHtml + '</div></section>'
  + '<div class="npage-cta" style="margin-top:34px;"><div class="npage-cta-left"><p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">Компания требует оплату или арестовала счёт?</h2><p class="npage-cta-sub">Проверим основания взыскания и поможем защитить ваши права.</p></div>'
  + '<a class="npage-wa-btn" href="https://wa.me/77479957635?text=Здравствуйте!+Нужна+проверка+компании+и+юридическая+помощь." target="_blank" rel="noopener">Написать в WhatsApp</a></div>'
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: !stats.available || Boolean(query), body }) %>
