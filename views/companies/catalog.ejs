<%
function esc(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function number(value) { return new Intl.NumberFormat(locale.hreflang).format(value || 0); }

const currentPage = results.page || 1;
const canonicalPath = companyCatalogPath + (!query && currentPage > 1 ? '?page=' + currentPage : '');
const canonical = 'https://zakonexpertt.kz' + canonicalPath;
const pageTitle = copy.title;
const pageDesc = copy.description;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.h1,
  url: canonical,
  description: pageDesc,
  inLanguage: locale.hreflang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'ZakonExpert',
    url: 'https://zakonexpertt.kz/',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://zakonexpertt.kz' + companyCatalogPath + '?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
};

let resultsHtml = '';
if (query && results.items.length === 0) {
  resultsHtml = '<div class="npage-card" style="padding:24px;text-align:center;color:#64748b;">'
    + esc(copy.noResults) + ': <strong>' + esc(query) + '</strong>.</div>';
} else if (results.items.length) {
  resultsHtml = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px;">'
    + results.items.map(function(company) {
      const official = Boolean(company.is_official_source);
      return '<a href="' + companyItemPrefix + esc(company.slug) + '" style="display:block;background:#fff;border:1px solid #dbe4f0;border-radius:14px;padding:18px;text-decoration:none;color:#0d1f3c;">'
        + '<div style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;">'
        + '<div style="font-weight:750;font-size:1rem;line-height:1.35;">' + esc(company.name_ru || company.name_kk) + '</div>'
        + '<span style="flex:0 0 auto;font-size:.68rem;border-radius:999px;padding:4px 8px;background:' + (official ? '#e8f7ee' : '#f1f5f9') + ';color:' + (official ? '#166534' : '#475569') + ';">'
        + esc(official ? copy.officialBadge : copy.directoryBadge) + '</span></div>'
        + (company.bin ? '<div style="margin-top:8px;color:#1a56db;font-size:.88rem;">' + esc(copy.bin) + ' ' + esc(company.bin) + '</div>' : '')
        + (company.status_ru ? '<div style="margin-top:7px;color:#64748b;font-size:.82rem;">' + esc(company.status_ru) + '</div>' : '')
        + (company.address_ru ? '<div style="margin-top:7px;color:#475569;font-size:.84rem;line-height:1.45;">📍 ' + esc(company.address_ru) + '</div>' : '')
        + '</a>';
    }).join('') + '</div>';
}

let paginationHtml = '';
if (results.page > 1 || results.hasMore) {
  const queryPart = query ? '?q=' + encodeURIComponent(query) + '&page=' : '?page=';
  paginationHtml = '<nav aria-label="Pagination" style="display:flex;gap:10px;justify-content:center;margin-top:22px;">'
    + (results.page > 1 ? '<a class="btn btn-outline-primary" href="' + companyCatalogPath + queryPart + (results.page - 1) + '">' + esc(copy.previous) + '</a>' : '')
    + (results.hasMore ? '<a class="btn btn-primary" href="' + companyCatalogPath + queryPart + (results.page + 1) + '">' + esc(copy.next) + '</a>' : '')
    + '</nav>';
}

const statsHtml = stats.available
  ? '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-top:18px;">'
    + [
      [stats.count, copy.totalCount],
      [stats.officialCount, copy.officialCount],
      [stats.directoryOnlyCount, copy.directoryCount],
      [stats.withContactsCount, copy.contactsCount],
    ].filter(function(stat) {
      return stat[0] !== null && stat[0] !== undefined;
    }).map(function(stat) {
      return '<div style="background:#fff;border:1px solid #dbe4f0;border-radius:12px;padding:13px 15px;">'
        + '<strong style="display:block;color:#0d1f3c;font-size:1.12rem;">' + number(stat[0]) + '</strong>'
        + '<span style="color:#64748b;font-size:.78rem;">' + esc(stat[1]) + '</span></div>';
    }).join('') + '</div>'
  : '';

const body = '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb"><a href="/">' + esc(copy.home) + '</a><span class="npage-bc-sep">/</span><span>' + esc(copy.companies) + '</span></nav>'
  + '<section class="npage-hero"><div class="npage-badges"><span class="npage-badge">' + esc(copy.eyebrow) + '</span></div>'
  + '<h1 class="npage-h1">' + esc(copy.h1) + '</h1>'
  + '<p style="color:#475569;max-width:850px;">' + esc(copy.intro) + '</p>' + statsHtml + '</section>'
  + (locale.code === 'ru' ? '<a href="/proverka-kontragenta" style="display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px;margin:20px 0;border-radius:14px;background:#0d2d59;color:#fff;text-decoration:none;box-shadow:0 10px 28px rgba(13,45,89,.16);"><span><strong style="display:block;font-size:1.02rem;">Проверить актуальные сведения КГД по БИН</strong><small style="display:block;color:#dbeafe;margin-top:4px;">Налоги, НДС, задолженность и неблагоприятные признаки — в одном отчёте</small></span><b style="white-space:nowrap;">Проверить →</b></a>' : '')
  + '<form action="' + companyCatalogPath + '" method="get" style="display:flex;gap:10px;background:#fff;border:1px solid #dbe4f0;border-radius:14px;padding:14px;margin:22px 0;box-shadow:0 8px 24px rgba(13,31,60,.06);">'
  + '<label class="visually-hidden" for="company-q">' + esc(copy.searchLabel) + '</label>'
  + '<input id="company-q" name="q" value="' + esc(query) + '" minlength="2" autocomplete="off" placeholder="' + esc(copy.placeholder) + '" style="flex:1;min-width:0;border:1px solid #cbd5e1;border-radius:10px;padding:12px 14px;font-size:1rem;">'
  + '<button type="submit" class="btn btn-primary" style="padding:0 24px;">' + esc(copy.find) + '</button></form>'
  + (!query && locale.code === 'ru' ? '<a href="/companies/regions" style="display:inline-flex;align-items:center;gap:8px;color:#1a56db;font-weight:650;font-size:.88rem;text-decoration:none;margin-bottom:18px;">🗺️ ' + esc(copy.regions) + '</a>' : '')
  + '<section aria-labelledby="company-results-title"><h2 id="company-results-title" style="font-size:1.28rem;color:#0d1f3c;margin:6px 0 16px;">' + esc(query ? copy.find : copy.browse) + '</h2>'
  + resultsHtml + paginationHtml + '</section>'
  + '<div style="margin-top:28px;padding:16px 18px;border:1px solid #dbe4f0;border-radius:12px;background:#f8fafc;color:#475569;font-size:.84rem;line-height:1.55;"><i class="bi bi-shield-check" aria-hidden="true"></i> ' + esc(copy.sourcePolicy) + '</div>'
  + '</div></div>';
%>
<%- include('./layout', {
  title: pageTitle,
  description: pageDesc,
  canonical,
  noindex: Boolean(query) || currentPage > 1 || !stats.available,
  schema,
  alternates: (!query && currentPage === 1) ? alternates : [],
  locale,
  copy,
  languages,
  companyCatalogPath,
  body
}) %>
