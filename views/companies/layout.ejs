<%
const resolvedOgImage = 'https://zakonexpertt.kz/img/brand/zakonexpert-logo-transparent-hd.png';
const safeSchemaJson = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : '';
%><!DOCTYPE html>
<html lang="<%= locale.hreflang %>" dir="<%= locale.dir %>" data-suppress-zakonexpert-contacts>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="rGbK9GM3kA42xzTzGMQs4VZju46dDdZjQdmOigQjnKY">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.png">
  <title><%= title %> | ZakonExpert</title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="<%= noindex ? 'noindex,follow' : 'index,follow' %>">
  <link rel="canonical" href="<%= canonical %>">
  <% (alternates || []).forEach(function(alternate) { %>
  <link rel="alternate" hreflang="<%= alternate.hreflang %>" href="<%= alternate.href %>">
  <% }); %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:locale" content="<%= locale.hreflang.replace('-', '_') %>_KZ">
  <meta property="og:image" content="<%= resolvedOgImage %>">
  <% if (schema) { %><script type="application/ld+json"><%- safeSchemaJson %></script><% } %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/design-system.css?v=20260715-1">
  <link rel="stylesheet" href="/css/landing.css?v=20260904-1">
  <link rel="stylesheet" href="/css/style.css?v=20260823-1">
  <link rel="stylesheet" href="/css/news.css?v=20260720-1">
  <link rel="stylesheet" href="/css/company-directory.css?v=20260904-1">
</head>
<body>
<%- include('../partials/yandex-metrika') %>
<header class="site-header">
  <div class="landing-container nav-shell">
    <a class="brand" href="/">
      <img src="/img/brand/zakonexpert-logo-transparent-hd.png" width="1983" height="793" alt="ZakonExpert" class="brand-full-logo">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Menu" data-nav-toggle>
      <i class="bi bi-list fs-4"></i>
    </button>
    <nav>
      <ul class="nav-links" data-nav-links>
        <li><a class="nav-link" href="/"><%= copy.home %></a></li>
        <li><a class="nav-link active" href="<%= companyCatalogPath %>"><%= copy.directory %></a></li>
        <li data-nav-kgd><a class="nav-link" href="/proverka-kontragenta" title="Проверка организации по БИН">КГД</a></li>
      </ul>
    </nav>
    <div class="header-side">
      <label class="visually-hidden" for="company-language">Language</label>
      <span class="company-language-picker">
        <i class="bi bi-translate" aria-hidden="true"></i>
        <select id="company-language" class="company-language-picker__select" data-language-switch aria-label="Language">
          <% languages.forEach(function(language) { %>
          <option value="<%= language.href %>"<%= language.code === locale.code ? ' selected' : '' %>><%= language.nativeName %></option>
          <% }); %>
        </select>
        <i class="bi bi-chevron-down company-language-picker__chevron" aria-hidden="true"></i>
      </span>
    </div>
  </div>
</header>
<main><%- body %></main>
<footer class="landing-footer">
  <div class="footer-top-line"></div>
  <div class="landing-container footer-shell">
    <div class="footer-brand">
      <img src="/img/brand/zakonexpert-logo-transparent-hd.png" width="1983" height="793" alt="ZakonExpert" class="brand-full-logo brand-full-logo--footer" loading="lazy">
      <p class="mt-3"><%= copy.sourcePolicy %></p>
    </div>
    <div class="footer-cols">
      <div class="footer-col"><h3 class="footer-col-title"><%= copy.directory %></h3><div class="footer-links"><a href="<%= companyCatalogPath %>"><%= copy.companies %></a><a href="/companies/regions"><%= copy.regions %></a></div></div>
    </div>
  </div>
  <div class="landing-container footer-bottom"><span>© <span class="current-year"></span> ZakonExpert</span><span class="ze-legal-entity">ТОО «ZakonExpert» · БИН 260740044168</span><span>Kazakhstan</span></div>
</footer>
<script src="/js/site.js?v=20260906-1"></script>
<script src="/js/analytics-events.js?v=20260828-2"></script>
<script>
document.querySelector('[data-language-switch]')?.addEventListener('change', function () {
  window.location.href = this.value;
});

// Some source datasets append a phone number to the postal address (for example
// ", тел. 87781670117"). Keep the source data intact, but never show that phone
// fragment inside the address field on company cards.
document.querySelectorAll('.company-info-row__value').forEach(function (element) {
  const original = element.textContent || '';
  const cleaned = original
    .replace(/\s*[,;]?\s*(?:тел(?:ефон)?\.?|моб\.?|phone)\s*[:.]?\s*\+?[\d\s()\-]{7,}\s*$/iu, '')
    .replace(/[\s,;]+$/u, '')
    .trim();
  if (cleaned && cleaned !== original.trim()) element.textContent = cleaned;
});
</script>
</body>
</html>
