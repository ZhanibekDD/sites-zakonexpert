<%
const resolvedOgImage = 'https://zakonexpertt.kz/img/brand/zakonexpert-logo-transparent-hd.png';
const safeSchemaJson = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : '';
const resolvedWhatsAppHref = typeof whatsappHref === 'string' && whatsappHref
  ? whatsappHref
  : 'https://wa.me/77479957635';
const conversionEnabled = typeof companyCta !== 'undefined' && companyCta;
const resolvedCompanyPageType = typeof companyPageType === 'string' && companyPageType
  ? companyPageType
  : 'company_catalog';
%><!DOCTYPE html>
<html lang="<%= locale.hreflang %>" dir="<%= locale.dir %>"<% if (conversionEnabled) { %> data-company-page-type="<%= resolvedCompanyPageType %>" data-company-locale="<%= locale.code %>"<% } %>>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="rGbK9GM3kA42xzTzGMQs4VZju46dDdZjQdmOigQjnKY">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.png">
  <title><%= title %> | ZakonExpert</title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="<%= noindex ? 'noindex,follow' : 'index,follow' %>">
  <link rel="canonical" href="<%= canonical %>">
  <% (alternates || []).forEach(function(alternate) { %>
  <link rel="alternate" hreflang="<%= alternate.hreflang %>" href="<%= alternate.href %>">
  <% }); %>
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:locale" content="<%= locale.hreflang.replace('-', '_') %>_KZ">
  <meta property="og:image" content="<%= resolvedOgImage %>">
  <% if (schema) { %><script type="application/ld+json"><%- safeSchemaJson %></script><% } %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/design-system.css?v=20260715-1">
  <link rel="stylesheet" href="/css/landing.css?v=20260619-1">
  <link rel="stylesheet" href="/css/style.css?v=20260619-1">
  <link rel="stylesheet" href="/css/news.css?v=20260720-1">
  <% if (conversionEnabled) { %><link rel="stylesheet" href="/css/company-conversion.css?v=20260804-3"><% } %>
</head>
<body>
<%- include('../partials/yandex-metrika') %>
<header class="site-header">
  <div class="landing-container nav-shell">
    <a class="brand" href="/">
      <img src="/img/brand/zakonexpert-logo-transparent-hd.png" width="1983" height="793" alt="ZakonExpert" class="brand-full-logo">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Menu" data-nav-toggle>
      <i class="bi bi-list fs-4"></i>
    </button>
    <nav>
      <ul class="nav-links" data-nav-links>
        <li><a class="nav-link" href="/"><%= copy.home %></a></li>
        <li><a class="nav-link active" href="<%= companyCatalogPath %>"><%= copy.directory %></a></li>
        <li><a class="nav-link" href="/contact"><%= copy.legalHelp %></a></li>
      </ul>
    </nav>
    <div class="header-side">
      <label class="visually-hidden" for="company-language">Language</label>
      <select id="company-language" data-language-switch style="max-width:130px;border:1px solid #cbd5e1;border-radius:9px;padding:8px;background:#fff;color:#0d1f3c;">
        <% languages.forEach(function(language) { %>
        <option value="<%= language.href %>"<%= language.code === locale.code ? ' selected' : '' %>><%= language.nativeName %></option>
        <% }); %>
      </select>
    </div>
  </div>
</header>
<main><%- body %></main>
<footer class="landing-footer">
  <div class="footer-top-line"></div>
  <div class="landing-container footer-shell">
    <div class="footer-brand">
      <img src="/img/brand/zakonexpert-logo-transparent-hd.png" width="1983" height="793" alt="ZakonExpert" class="brand-full-logo brand-full-logo--footer" loading="lazy">
      <p class="mt-3"><%= copy.sourcePolicy %></p>
    </div>
    <div class="footer-cols">
      <div class="footer-col"><h3 class="footer-col-title"><%= copy.directory %></h3><div class="footer-links"><a href="<%= companyCatalogPath %>"><%= copy.companies %></a><a href="/companies/regions"><%= copy.regions %></a></div></div>
      <div class="footer-col"><h3 class="footer-col-title"><%= copy.legalHelp %></h3><div class="footer-contacts"><a href="tel:+77479957635">+7 (747) 995-76-35</a><a href="<%= resolvedWhatsAppHref %>" target="_blank" rel="noopener"<% if (conversionEnabled) { %> data-company-whatsapp data-cta-position="footer" data-company-offer data-offer-a="<%= copy.offerButtonA %>" data-offer-b="<%= copy.offerButtonB %>"<% } %>><%= conversionEnabled ? copy.offerButtonA : 'WhatsApp' %></a></div></div>
    </div>
  </div>
  <div class="landing-container footer-bottom"><span>© <span class="current-year"></span> ZakonExpert</span><span class="ze-legal-entity">ТОО «ZakonExpert» · БИН 260740044168</span><span>Kazakhstan</span></div>
</footer>
<% if (conversionEnabled) { %>
<a href="<%= resolvedWhatsAppHref %>" class="company-desktop-cta" target="_blank" rel="noopener" aria-label="WhatsApp" data-company-whatsapp data-cta-position="desktop-floating"><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
<a href="<%= resolvedWhatsAppHref %>" class="company-mobile-cta" target="_blank" rel="noopener" data-company-whatsapp data-cta-position="mobile-sticky"><i class="bi bi-whatsapp" aria-hidden="true"></i><span data-company-offer data-offer-a="<%= copy.offerButtonA %>" data-offer-b="<%= copy.offerButtonB %>"><%= copy.offerButtonA %></span></a>
<% } else { %>
<a href="<%= resolvedWhatsAppHref %>" class="sticky-wa" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
<% } %>
<script src="/js/site.js?v=20260815-1"></script>
<script src="/js/analytics-events.js"></script>
<% if (conversionEnabled) { %><script src="/js/company-conversion.js?v=20260804-2"></script><% } %>
<script>
document.querySelector('[data-language-switch]')?.addEventListener('change', function () {
  window.location.href = this.value;
});
</script>
</body>
</html>
