    + (phone ? '<div class="cb2-row"><span class="cb2-icon">📞</span><a href="tel:' + phoneRaw + '" class="cb2-link">' + phone + '</a></div>' : '')
    + (email ? '<div class="cb2-row"><span class="cb2-icon">✉️</span><a href="mailto:' + email + '" class="cb2-link">' + email + '</a></div>' : '')
    + (web ? '<div class="cb2-row"><span class="cb2-icon">🌐</span><a href="https://' + web + '" target="_blank" rel="noopener" class="cb2-link">' + web + '</a></div>' : '')
    + '</div>';
}

