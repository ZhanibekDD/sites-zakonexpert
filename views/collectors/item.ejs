<%
const displayName = String(item.name || '').replace(/^«/, '').trim();
const pageTitle = displayName + ' — коллектор, контакты | ZakonExpert';
const pageDesc = displayName + ': БИН ' + item.bin + '. Контакты и сведения из реестра коллекторских агентств. Юридическая помощь при незаконных требованиях.';
const canonical = 'https://zakonexpert.kz/collectors/' + item.slug;

function escHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function dataRow(icon, label, value, options) {
  if (!value) return '';
  options = options || {};
  var content = escHtml(value);
  if (options.href) {
    content = '<a class="collector-link" href="' + escHtml(options.href) + '"'
      + (options.external ? ' target="_blank" rel="noopener"' : '') + '>' + content + '</a>';
  }
  return '<div class="collector-data-row">'
    + '<span class="collector-data-row__icon" aria-hidden="true"><i class="bi ' + escHtml(icon) + '"></i></span>'
    + '<span class="collector-data-row__label">' + escHtml(label) + '</span>'
    + '<span class="collector-data-row__value">' + content + '</span>'
    + '</div>';
}

const phone = item.phones && item.phones[0] ? item.phones[0] : '';
const phoneHref = phone ? 'tel:' + phone.replace(/[^\d+]/g, '') : '';
const email = item.emails && item.emails[0] ? item.emails[0] : '';
const site = item.sites && item.sites[0] ? item.sites[0] : '';
const siteHref = site ? (/^https?:\/\//i.test(site) ? site : 'https://' + site) : '';
const mapQuery = encodeURIComponent((item.address || '') + ', Казахстан');
const mapSearch = encodeURIComponent(item.address || '');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Коллекторские агентства', item: 'https://zakonexpert.kz/collectors' },
        { '@type': 'ListItem', position: 3, name: displayName, item: canonical },
      ],
    },
    {
      '@type': 'Organization',
      name: displayName,
      identifier: item.bin,
      telephone: phone || undefined,
      email: email || undefined,
      url: siteHref || undefined,
      address: item.address ? { '@type': 'PostalAddress', streetAddress: item.address, addressCountry: 'KZ' } : undefined,
    },
  ],
};

const pageStyles = '<link rel="stylesheet" href="/css/collector-item.css?v=20260716-1">';
const detailsHtml = lowContentBoost({ entityLabel: 'этот коллектор', entityLabelGenitive: 'этого коллектора' })
  .replace('Что делать, если по вам есть взыскание', 'Подробные рекомендации');

const body = pageStyles
  + '<div class="collector-detail-page">'
  + '<section class="collector-hero">'
  + '<div class="collector-container">'
  + '<nav class="collector-breadcrumbs" aria-label="breadcrumb">'
  + '<a href="/">Главная</a><span>/</span><a href="/collectors">Коллекторы</a><span>/</span><span>' + escHtml(displayName) + '</span>'
  + '</nav>'
  + '<div class="collector-hero__badges">'
  + '<span class="collector-badge"><i class="bi bi-file-earmark-text"></i> Реестр АРРФР</span>'
  + '<span class="collector-badge collector-badge--active"><i class="bi bi-shield-check"></i> Действующее агентство</span>'
  + '</div>'
  + '<h1>' + escHtml(displayName) + '</h1>'
  + '</div>'
  + '</section>'
  + '<div class="collector-main">'
  + '<div class="collector-container">'
  + '<div class="collector-layout">'
  + '<section class="collector-card" aria-label="Сведения о коллекторском агентстве">'
  + dataRow('bi-geo-alt', 'Адрес', item.address)
  + dataRow('bi-person', 'Руководитель', item.leader)
  + dataRow('bi-telephone', 'Телефон', phone, { href: phoneHref })
  + dataRow('bi-envelope', 'Email', email, { href: email ? 'mailto:' + email : '' })
  + dataRow('bi-globe2', 'Веб-сайт', site, { href: siteHref, external: true })
  + dataRow('bi-file-earmark-text', 'Регистрационный номер', item.regNum ? 'Регистрация: ' + item.regNum : '')
  + dataRow('bi-person-vcard', 'БИН', item.bin ? 'БИН: ' + item.bin : '')
  + dataRow('bi-calendar3', 'Дата внесения в реестр', item.dateAdded ? 'В реестре с ' + item.dateAdded : '')
  + (item.address ? '<div class="collector-map">'
      + '<iframe src="https://maps.google.com/maps?q=' + mapQuery + '&output=embed&hl=ru&z=15" loading="lazy" title="Карта расположения ' + escHtml(displayName) + '" allowfullscreen></iframe>'
      + '</div>'
      + '<div class="collector-map-actions">'
      + '<a class="collector-map-button" href="https://2gis.kz/search/' + mapSearch + '" target="_blank" rel="noopener"><i class="bi bi-geo-alt-fill"></i> Открыть в 2ГИС</a>'
      + '<a class="collector-map-button" href="https://maps.google.com/?q=' + mapQuery + '" target="_blank" rel="noopener"><i class="bi bi-geo-alt"></i> Google Maps</a>'
      + '</div>' : '')
  + '</section>'
  + '<aside class="collector-sidebar">'
  + '<section class="collector-help" aria-labelledby="collector-help-title">'
  + '<div class="collector-help__title"><span class="collector-help__emblem"><i class="bi bi-shield-check"></i></span><h2 id="collector-help-title">Коллектор требует оплату?</h2></div>'
  + '<p>Мы поможем проверить законность требований и защитим ваши права в рамках закона.</p>'
  + '<ul class="collector-help__list">'
  + '<li><i class="bi bi-check-lg"></i><span>Проверим законность взыскания</span></li>'
  + '<li><i class="bi bi-check-lg"></i><span>Сопроводим при общении с коллектором</span></li>'
  + '<li><i class="bi bi-check-lg"></i><span>Защитим от нарушений ваших прав</span></li>'
  + '</ul>'
  + '<a class="collector-help__cta" href="https://wa.me/77003097566?text=Здравствуйте!+Коллектор+требует+оплату,+нужна+консультация." target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> Получить бесплатную консультацию</a>'
  + '<p class="collector-help__response"><i class="bi bi-clock"></i> Ответ специалиста в течение 10 минут</p>'
  + '</section>'
  + '<section class="collector-warning" aria-labelledby="collector-warning-title">'
  + '<div class="collector-warning__title" id="collector-warning-title"><i class="bi bi-exclamation-triangle"></i> Важно знать</div>'
  + '<p>Коллектор вправе связываться с должником, но не может арестовывать счета и имущество. Это могут делать только суд и ЧСИ.</p>'
  + '</section>'
  + '</aside>'
  + '</div>'
  + '<section class="collector-steps" aria-labelledby="collector-steps-title">'
  + '<h2 id="collector-steps-title">Что делать, если по вам есть взыскание</h2>'
  + '<div class="collector-steps__grid">'
  + '<article class="collector-step"><span class="collector-step__number">1</span><i class="bi bi-file-earmark-zoom"></i><div><strong>Проверьте основание</strong><small>Убедитесь, что долг существует, и проверьте его в реестре должников и в суде.</small></div></article>'
  + '<article class="collector-step"><span class="collector-step__number">2</span><i class="bi bi-folder2-open"></i><div><strong>Запросите документы</strong><small>Попросите у коллектора документы, подтверждающие право требования.</small></div></article>'
  + '<article class="collector-step"><span class="collector-step__number">3</span><i class="bi bi-shield-check"></i><div><strong>Обратитесь за защитой</strong><small>Если есть нарушения — мы поможем защитить ваши права и прекратить давление.</small></div></article>'
  + '</div>'
  + '</section>'
  + '<div class="collector-more">' + detailsHtml + '</div>'
  + '<a class="collector-back" href="/collectors"><i class="bi bi-arrow-left"></i> Все коллекторские агентства</a>'
  + '</div>'
  + '</div>'
  + '</div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
