<%
// Title-case: ИВАНОВ ИВАН → Иванов Иван
const nameTitle = lawyer.name.toLowerCase()
  .split(' ').map(w => w ? w[0].toUpperCase() + w.slice(1) : '').join(' ');

const pageTitle = `Адвокат ${nameTitle} — ${lawyer.region} | ZakonExpert`;
const _addrSnippet = lawyer.address ? `Адрес: ${lawyer.address.slice(0,60)}. ` : '';
const _phoneSnippet = lawyer.phones && lawyer.phones.length ? `Телефон: ${lawyer.phones[0]}. ` : '';
const _licSnippet = lawyer.license ? `Лицензия №${lawyer.license}. ` : '';
const pageDesc  = `Адвокат ${nameTitle} — ${lawyer.region}. ${_addrSnippet}${_phoneSnippet}${_licSnippet}ZakonExpert Казахстан.`;
const canonical = `https://zakonexpertt.kz/lawyer/${lawyer.slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: `Адвокат ${nameTitle}`,
    description: pageDesc,
    address: {
      '@type': 'PostalAddress',
      streetAddress: lawyer.address || '',
      addressRegion: lawyer.region,
      addressCountry: 'KZ',
    },
    ...(lawyer.phones && lawyer.phones.length ? { telephone: lawyer.phones[0] } : {}),
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
      { '@type': 'ListItem', position: 2, name: 'Адвокаты', item: 'https://zakonexpertt.kz/lawyers' },
      { '@type': 'ListItem', position: 3, name: `Адвокат ${nameTitle}`, item: canonical },
    ],
  },
];

function fmtPhone(raw) {
  const d = (raw || '').replace(/\D/g, '');
  if (d.length === 11) return '+7 (' + d.slice(1,4) + ') ' + d.slice(4,7) + '-' + d.slice(7,9) + '-' + d.slice(9,11);
  if (d.length === 10) return '+7 (' + d.slice(0,3) + ') ' + d.slice(3,6) + '-' + d.slice(6,8) + '-' + d.slice(8,10);
  return raw;
}
function fmtPhones(phones) {
  if (!phones || !phones.length) return '';
  return phones.map(p => {
    const digits = p.replace(/[^\d+]/g, '');
    return `<a href="tel:${digits}" class="npage-phone-link">${fmtPhone(p)}</a>`;
  }).join(', ');
}

const body = `
<div class="npage-wrap">
  <div class="landing-container">

    <nav class="npage-breadcrumb" aria-label="breadcrumb">
      <a href="/">Главная</a>
      <span class="npage-bc-sep">/</span>
      <a href="/lawyers">Адвокаты</a>
      <span class="npage-bc-sep">/</span>
      <span>${nameTitle}</span>
    </nav>

    <div class="npage-hero">
      <div class="npage-badges">
        <span class="npage-badge npage-badge--lawyer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Адвокат
        </span>
        <span class="npage-region-tag">${lawyer.region}</span>
      </div>
      <h1 class="npage-h1">${nameTitle}</h1>
    </div>

    <div class="npage-card">
      ${lawyer.address ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Адрес / Форма деятельности</span>
          <span class="npage-row-val">${lawyer.address}</span>
        </div>
      </div>` : ''}

      ${lawyer.phones && lawyer.phones.length ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5 19.79 19.79 0 0 1 1.61 4.94 2 2 0 0 1 3.59 2.73h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 10a16 16 0 0 0 6.12 6.12l.92-.93a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 17z"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Телефон</span>
          <span class="npage-row-val">${fmtPhones(lawyer.phones)}</span>
        </div>
      </div>` : ''}

      ${lawyer.licenseNo ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Лицензия</span>
          <span class="npage-row-val">№ ${lawyer.licenseNo}${lawyer.licenseDate ? ' от ' + lawyer.licenseDate : ''}</span>
        </div>
      </div>` : ''}

      ${lawyer.since ? `
      <div class="npage-row">
        <span class="npage-row-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </span>
        <div class="npage-row-body">
          <span class="npage-row-label">Адвокат</span>
          <span class="npage-row-val">${lawyer.since}</span>
        </div>
      </div>` : ''}
    </div>

    <!-- CTA advertising block -->
    <div class="npage-cta npage-cta--lawyer">
      <div class="npage-cta-left">
        <p class="npage-cta-label">Юридическая помощь</p>
        <h2 class="npage-cta-title">Нужна юридическая консультация?</h2>
        <p class="npage-cta-sub">Наши специалисты помогут в любой правовой ситуации: долги, аресты, исполнительное производство, жилищные споры.</p>
        <div class="npage-cta-tags">
          <span>Снятие ареста со счёта</span>
          <span>Долговые споры</span>
          <span>Жилищные вопросы</span>
          <span>Исполнительное производство</span>
        </div>
      </div>
      <a href="https://wa.me/77000300024?text=Здравствуйте!+Нужна+юридическая+консультация."
         class="npage-wa-btn" target="_blank" rel="noopener">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
        </svg>
        Написать в WhatsApp
      </a>
    </div>

    <p class="npage-source-note">
      Данные предоставлены <a href="https://adilet.zan.kz" target="_blank" rel="noopener noreferrer">Министерством юстиции РК (КАОЖ)</a>.
      Обновляются по мере публикации новых списков.
    </p>

  </div>
</div>
`;
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
