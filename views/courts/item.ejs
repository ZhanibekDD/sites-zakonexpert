<%
const pageTitle = court.name + (court.region ? ' (' + court.region + ')' : '') + ' — телефон, email, адрес | ZakonExpert';
const pageDesc = court.name + (court.region ? ', ' + court.region : '') + (court.address ? ': ' + court.address : ': адрес') + ', телефон, email и режим работы. Помощь с подготовкой документов в суд.';
const canonical = 'https://zakonexpert.kz/courts/' + court.slug;
const webHref = court.web ? (/^https?:\/\//i.test(court.web) ? court.web : 'https://' + court.web) : '';
const schema = { '@context': 'https://schema.org', '@type': 'GovernmentOrganization', name: court.name,
  telephone: court.phoneRaw || court.phone || undefined, email: court.email || undefined, url: webHref || undefined,
  address: court.address ? { '@type': 'PostalAddress', streetAddress: court.address, addressLocality: court.region, addressCountry: 'KZ' } : undefined };
const detail = {
  name: court.name, subtitle: court.region,
  breadcrumbs: [{ href: '/courts', label: 'Суды Казахстана' }, { label: court.region }],
  badges: [{ icon: 'bi-bank', label: court.level || 'Суд РК' }, { icon: 'bi-shield-check', label: 'Судебная система', active: true }],
  rows: [
    { icon: 'bi-geo-alt', label: 'Адрес', value: court.address },
    { icon: 'bi-telephone', label: 'Телефон', value: court.phone, href: court.phone ? 'tel:' + (court.phoneRaw || court.phone.replace(/[^\d+]/g, '')) : '' },
    { icon: 'bi-envelope', label: 'Email', value: court.email, href: court.email ? 'mailto:' + court.email : '' },
    { icon: 'bi-globe2', label: 'Веб-сайт', value: court.web, href: webHref, external: true },
    { icon: 'bi-person', label: 'Председатель', value: court.chairman },
    { icon: 'bi-clock', label: 'Режим работы', value: court.schedule },
  ],
  address: [court.region, court.address].filter(Boolean).join(', '),
  help: { icon: 'bi-shield-check', title: 'Нужна помощь в суде?', text: 'Определим способ защиты и подготовим процессуальные документы.',
    items: ['Проанализируем документы и сроки', 'Подготовим иск, отзыв или жалобу', 'Сопроводим дело до результата'],
    whatsappText: 'Здравствуйте! Нужна помощь по делу в ' + court.name + '.' },
  warning: { title: 'Важно знать', text: 'Судебные сроки могут быть короткими. Сохраните уведомления и заранее получите копии всех материалов дела.' },
  stepsTitle: 'Как подготовиться к обращению в суд',
  steps: [
    { icon: 'bi-folder2-open', title: 'Соберите материалы', text: 'Подготовьте договоры, переписку, платежи и судебные документы.' },
    { icon: 'bi-calendar3', title: 'Проверьте сроки', text: 'Уточните срок подачи и порядок обжалования.' },
    { icon: 'bi-file-earmark-text', title: 'Подготовьте позицию', text: 'Сформулируйте требования и приложите подтверждающие доказательства.' },
  ],
  backUrl: '/courts', backLabel: 'Все суды Казахстана',
};
const body = '<link rel="stylesheet" href="/css/registry-item.css?v=20260716-1">' + include('../partials/registry-item-body', { detail });
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
