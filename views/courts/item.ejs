<%
const pageTitle = court.name + ' — телефон, email, адрес | ZakonExpert';
const pageDesc  = court.name + ': адрес ' + court.region + ', ' + court.address + ', телефон ' + court.phone + ', email ' + court.email + '. Нужна помощь в суде? ZakonExpert подготовит документы.';
const canonical = 'https://zakonexpertt.kz/courts/' + court.slug;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Суды Казахстана', item: 'https://zakonexpertt.kz/courts' },
        { '@type': 'ListItem', position: 3, name: court.name, item: canonical },
      ],
    },
    {
      '@type': 'GovernmentOffice',
      name: court.name,
      address: { '@type': 'PostalAddress', streetAddress: court.address, addressLocality: court.region, addressCountry: 'KZ' },
      telephone: court.phoneRaw,
      email: court.email,
      url: 'https://' + court.web,
    },
  ],
};

const levelColor = court.level === 'Верховный суд'
  ? 'background:#ede9fe;color:#7c3aed;border:1px solid #c4b5fd;'
  : 'background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;';

const CSS = '<style>'
  + '.ci-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:28px 32px;max-width:680px;}'
  + '.ci-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f1f5f9;font-size:.92rem;}'
  + '.ci-row:last-child{border-bottom:none;}'
  + '.ci-icon{flex-shrink:0;width:22px;text-align:center;font-size:1rem;line-height:1.5;}'
  + '.ci-link{color:#1a56db;text-decoration:none;}'
  + '.ci-link:hover{text-decoration:underline;}'
  + '.ci-badge{display:inline-block;font-size:.72rem;font-weight:700;border-radius:6px;padding:2px 10px;' + levelColor + '}'
  + '.ci-info{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;font-size:.85rem;color:#1e40af;margin-top:1rem;line-height:1.6;}'
  + '</style>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><a href="/courts">Суды Казахстана</a><span class="npage-bc-sep">/</span><span>' + court.region + '</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🏛 Суд РК</span></div>'
  + '<h1 class="npage-h1">' + court.name + '</h1>'
  + '<p style="color:#64748b;margin-top:6px;"><span class="ci-badge">' + court.level + '</span> &nbsp; ' + court.region + '</p></div>'
  + '<div class="ci-card" style="margin-top:1.5rem;">'
  + '<div class="ci-row"><span class="ci-icon">📍</span><span>' + court.address + '</span></div>'
  + (court.phone ? '<div class="ci-row"><span class="ci-icon">📞</span><a href="tel:' + (court.phoneRaw||court.phone) + '" class="ci-link">' + court.phone + '</a></div>' : '')
  + (court.email ? '<div class="ci-row"><span class="ci-icon">✉️</span><a href="mailto:' + court.email + '" class="ci-link">' + court.email + '</a></div>' : '')
  + (court.web ? '<div class="ci-row"><span class="ci-icon">🌐</span><a href="https://' + court.web + '" target="_blank" rel="noopener" class="ci-link">' + court.web + '</a></div>' : '')
  + (court.chairman ? '<div class="ci-row"><span class="ci-icon">👤</span><span><strong>Председатель:</strong> ' + court.chairman + '</span></div>' : '')
  + (court.schedule ? '<div class="ci-row"><span class="ci-icon">🕐</span><span>' + court.schedule + '</span></div>' : '')
  + '<div class="ci-info">ℹ️ Для участников процесса: движение дел, графики заседаний и электронные обращения — через <a href="https://sud.gov.kz" target="_blank" rel="noopener" class="ci-link">sud.gov.kz</a> и <a href="https://www.egov.kz" target="_blank" rel="noopener" class="ci-link">eGov.kz</a>.</div>'
  + '</div>'
  + '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">Нужна помощь в ' + court.name.replace('Суд','суде').replace('суд РК','суде РК') + '?</h2>'
  + '<p class="npage-cta-sub">Подготовим документы, оспорим арест и представим ваши интересы в суде. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Документы в суд</span><span>Оспаривание арестов</span><span>Все регионы</span></div></div>'
  + '<a href="https://wa.me/77000300024?text=Здравствуйте!+Нужна+помощь+в+суде,+прошу+проконсультировать." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 700 030-00-24</span></span></a></div>'
  + '<div style="margin-top:1.5rem;"><a href="/courts" style="color:#1a56db;font-size:.9rem;text-decoration:none;">← Все суды Казахстана</a></div>'
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
