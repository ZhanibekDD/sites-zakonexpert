<%
const pageTitle = item.shortName + ' — страховая компания Казахстана, телефон, email, адрес | ZakonExpert';
const pageDesc  = item.name + ': страховая организация Казахстана. БИН ' + item.bin + '. ' + (item.address ? 'Адрес: ' + item.address + '. ' : '') + (item.phone ? 'Телефон: ' + item.phone + '. ' : '') + 'Спор со страховой? ZakonExpert поможет.';
const canonical = 'https://zakonexpertt.kz/insurance/' + item.slug;

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function mapBlock(addr) {
  if (!addr) return '';
  var q = encodeURIComponent(addr + ', Казахстан');
  var q2 = encodeURIComponent(addr);
  return '<div style="margin-top:1.5rem;max-width:720px;">'
    + '<iframe src="https://maps.google.com/maps?q=' + q + '&output=embed&hl=ru&z=15" width="100%" height="280" style="border:0;border-radius:12px;display:block;" loading="lazy" allowfullscreen></iframe>'
    + '<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">'
    + '<a href="https://2gis.kz/search/' + q2 + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;font-size:.82rem;color:#1a56db;text-decoration:none;padding:6px 14px;border:1.5px solid #bfdbfe;border-radius:8px;background:#eff6ff;font-weight:500;">🗺 Открыть в 2ГИС</a>'
    + '<a href="https://maps.google.com/?q=' + q + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;font-size:.82rem;color:#374151;text-decoration:none;padding:6px 14px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;font-weight:500;">📌 Google Maps</a>'
    + '</div></div>';
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Страховые компании', item: 'https://zakonexpertt.kz/insurance' },
        { '@type': 'ListItem', position: 3, name: item.shortName, item: canonical },
      ],
    },
    {
      '@type': 'InsuranceAgency',
      name: item.name,
      telephone: item.phoneRaw || item.phone,
      email: item.email,
      url: item.web ? 'https://' + item.web : undefined,
      address: item.address ? { '@type': 'PostalAddress', streetAddress: item.address, addressCountry: 'KZ' } : undefined,
    },
  ],
};

const CSS = '<style>'
  + '.ii-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:28px 32px;max-width:680px;}'
  + '.ii-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f1f5f9;font-size:.92rem;}'
  + '.ii-row:last-child{border-bottom:none;}'
  + '.ii-icon{flex-shrink:0;width:22px;text-align:center;font-size:1rem;line-height:1.5;}'
  + '.ii-link{color:#1a56db;text-decoration:none;}'
  + '.ii-link:hover{text-decoration:underline;}'
  + '.ii-dim{color:#94a3b8;font-size:.82rem;}'
  + '.ii-info{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 18px;font-size:.85rem;color:#1e40af;margin-top:1rem;line-height:1.6;}'
  + '</style>';

var phoneLink = item.phone
  ? '<a href="tel:' + (item.phoneRaw || item.phone.replace(/[^\d+]/g,'')) + '" class="ii-link">' + escHtml(item.phone) + '</a>'
  : '<span class="ii-dim">уточните на сайте компании</span>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><a href="/insurance">Страховые компании</a><span class="npage-bc-sep">/</span><span>' + escHtml(item.shortName) + '</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🛡 Страховая компания РК</span></div>'
  + '<h1 class="npage-h1">' + escHtml(item.shortName) + '</h1>'
  + (item.name !== item.shortName ? '<p style="color:#94a3b8;font-size:.88rem;margin-top:4px;">' + escHtml(item.name) + '</p>' : '')
  + '</div>'
  + '<div class="ii-card" style="margin-top:1.5rem;">'
  + (item.address ? '<div class="ii-row"><span class="ii-icon">📍</span><span>' + escHtml(item.address) + '</span></div>' : '')
  + '<div class="ii-row"><span class="ii-icon">📞</span>' + phoneLink + '</div>'
  + (item.email ? '<div class="ii-row"><span class="ii-icon">✉️</span><a href="mailto:' + escHtml(item.email) + '" class="ii-link">' + escHtml(item.email) + '</a></div>' : '')
  + (item.web ? '<div class="ii-row"><span class="ii-icon">🌐</span><a href="https://' + escHtml(item.web) + '" target="_blank" rel="noopener" class="ii-link">' + escHtml(item.web) + '</a></div>' : '')
  + (item.leader ? '<div class="ii-row"><span class="ii-icon">👤</span><span><strong>Председатель правления:</strong> ' + escHtml(item.leader) + '</span></div>' : '')
  + (item.bin ? '<div class="ii-row"><span class="ii-icon">🆔</span><span class="ii-dim">БИН: ' + escHtml(item.bin) + '</span></div>' : '')
  + mapBlock(item.address)
  + '<div class="ii-info">ℹ️ Жалобы на страховые компании принимает <strong>АРРФР</strong> — Агентство по регулированию и развитию финансового рынка РК. Обращайтесь на <a href="https://www.afsa.kz" target="_blank" rel="noopener" class="ii-link">afsa.kz</a> или по тел. +7 727 237-10-00.</div>'
  + '</div>'
  + '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">' + escHtml(item.shortName) + ' отказала в выплате?</h2>'
  + '<p class="npage-cta-sub">Поможем добиться страховой выплаты, оспорить отказ и подать жалобу в АРРФР. Работаем по всему Казахстану.</p>'
