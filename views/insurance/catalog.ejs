<%
const pageTitle = 'Страховые компании Казахстана — реестр, телефоны, email | ZakonExpert';
const pageDesc  = 'Полный реестр страховых компаний Казахстана: ' + items.length + ' компаний. Адреса, телефоны, email, сайты. Страховой спор? ZakonExpert поможет.';
const canonical = 'https://zakonexpertt.kz/insurance';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
    { '@type': 'ListItem', position: 2, name: 'Страховые компании Казахстана', item: canonical },
  ],
};

var searchInput = '<div style="margin:1.2rem 0;">'
  + '<input id="ins-search" type="text" placeholder="Поиск по названию..." '
  + 'style="width:100%;max-width:480px;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.9rem;outline:none;" '
  + 'oninput="filterIns(this.value)">'
  + '<span id="ins-count" style="margin-left:10px;color:#64748b;font-size:.85rem;">' + items.length + ' компаний</span>'
  + '</div>';

var CSS = '<style>'
  + '.ins-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px;margin-top:1rem;}'
  + '.ins-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;padding:16px 18px;}'
  + '.ins-short{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#0369a1;margin-bottom:3px;}'
  + '.ins-name{font-size:.84rem;font-weight:700;color:#0d1f3c;margin-bottom:10px;line-height:1.35;}'
  + '.ins-row{display:flex;gap:7px;font-size:.82rem;margin-bottom:4px;align-items:flex-start;}'
  + '.ins-icon{flex-shrink:0;width:20px;text-align:center;}'
  + '.ins-link{color:#1a56db;text-decoration:none;}'
  + '.ins-link:hover{text-decoration:underline;}'
  + '</style>';

var cards = '';
for (var i = 0; i < items.length; i++) {
  var c = items[i];
  var phoneHtml = c.phone
    ? '<a href="tel:' + (c.phoneRaw || c.phone.replace(/[^\d+]/g,'')) + '" class="ins-link">' + c.phone + '</a>'
    : '';
  var emailHtml = c.email ? '<a href="mailto:' + c.email + '" class="ins-link">' + c.email + '</a>' : '';
  var webHtml = c.web ? '<a href="https://' + c.web + '" target="_blank" rel="noopener" class="ins-link">' + c.web + '</a>' : '';
  var addrHtml = c.address ? c.address.replace(/^\d+,\s*/,'').substring(0, 90) : '';
  var searchText = (c.name + ' ' + c.shortName).toLowerCase();

  cards += '<div class="ins-card" data-search="' + searchText + '">'
    + '<div class="ins-short">' + (c.slug ? '<a href="/insurance/' + c.slug + '" style="color:inherit;text-decoration:none;">' + c.shortName + '</a>' : c.shortName) + '</div>'
    + '<div class="ins-name">' + c.name + '</div>'
    + (addrHtml ? '<div class="ins-row"><span class="ins-icon">📍</span><span>' + addrHtml + '</span></div>' : '')
    + (phoneHtml ? '<div class="ins-row"><span class="ins-icon">📞</span><span>' + phoneHtml + '</span></div>' : '')
    + (emailHtml ? '<div class="ins-row"><span class="ins-icon">✉️</span><span>' + emailHtml + '</span></div>' : '')
    + (webHtml ? '<div class="ins-row"><span class="ins-icon">🌐</span><span>' + webHtml + '</span></div>' : '')
    + (c.leader ? '<div class="ins-row"><span class="ins-icon">👤</span><span style="color:#64748b;">' + c.leader + '</span></div>' : '')
    + '</div>';
}

var filterJS = '<script>'
  + 'function filterIns(q){'
  + 'var t=q.toLowerCase(),els=document.querySelectorAll(".ins-card"),n=0;'
  + 'els.forEach(function(el){var m=el.dataset.search.includes(t);el.style.display=m?"":"none";if(m)n++;});'
  + 'document.getElementById("ins-count").textContent=n+" компаний";}'
  + '</script>';

const ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">Спор со страховой компанией?</h2>'
  + '<p class="npage-cta-sub">Поможем добиться страховой выплаты, оспорить отказ и защитить ваши права. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Отказ в выплате</span><span>Занижение суммы</span><span>Жалоба в АРРФР</span></div></div>'
  + '<a href="https://wa.me/77752998738?text=Здравствуйте!+Спор+со+страховой+компанией,+нужна+помощь." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 775 299-87-38</span></span></a></div>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><span>Страховые компании</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🛡 Страховые РК</span></div>'
  + '<h1 class="npage-h1">Страховые компании Казахстана</h1>'
  + '<p style="color:#475569;margin-top:.5rem;">Официальный реестр страховых организаций РК — <strong>' + items.length + ' компаний</strong></p></div>'
  + searchInput
  + '<div class="ins-grid">' + cards + '</div>'
  + ctaHtml
  + '<div style="margin-top:1.5rem;"><a href="/regulators" style="color:#1a56db;font-size:.9rem;text-decoration:none;">Финансовые регуляторы (АРРФР, НБ РК) →</a></div>'
  + '</div></div>'
  + filterJS;
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
