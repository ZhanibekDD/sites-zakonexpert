  + '<a href="/tools" style="display:inline-flex;align-items:center;gap:7px;margin-left:10px;color:#1a56db;font-weight:700;font-size:.86rem;text-decoration:none"><i class="bi bi-grid"></i> Все калькуляторы</a>'
  + '</div>'
  + '<div class="calc-wrap">'
  + '<div class="calc-tabs">'
  + '<button class="calc-tab active" data-tab="mfo" onclick="setTab(\'mfo\')">💳 МФО / микрозайм</button>'
  + '<button class="calc-tab" data-tab="bank" onclick="setTab(\'bank\')">🏦 Банковский кредит</button>'
  + '</div>'
  + '<div class="calc-card">'
  + '<div class="calc-row">'
  + '<div class="calc-group"><label class="calc-label">Сумма займа (₸)</label><input id="principal" class="calc-input" type="number" placeholder="100000" min="1000" step="1000"></div>'
  + '<div class="calc-group"><label class="calc-label">Дата займа</label><input id="date-from" class="calc-input" type="date"></div>'
  + '</div>'
  + '<div class="calc-row">'
  + '<div id="field-rate" class="calc-group"><label class="calc-label">Ставка (% в день)</label><input id="rate-mfo" class="calc-input" type="number" value="1" min="0.01" max="10" step="0.01"></div>'
  + '<div id="field-rate-bank" class="calc-group" style="display:none"><label class="calc-label">Ставка (% годовых)</label><input id="rate-bank" class="calc-input" type="number" value="24" min="1" max="300" step="0.5"></div>'
  + '<div class="calc-group"><label class="calc-label">Дата расчёта</label><input id="date-to" class="calc-input" type="date"></div>'
  + '</div>'
  + '<div class="calc-row">'
  + '<div class="calc-group"><label class="calc-label">Пеня (% в день)</label><input id="penalty" class="calc-input" type="number" value="0.5" min="0" max="5" step="0.01"></div>'
  + '<div class="calc-group" style="justify-content:flex-end;padding-top:24px"><button class="calc-btn" onclick="calculate()">Рассчитать</button></div>'
  + '</div>'
  + '<div id="result-box" class="calc-result">'
  + '<div class="cr-row"><span class="cr-label">Срок просрочки</span><span class="cr-val" id="cr-days">—</span></div>'
  + '<div class="cr-row"><span class="cr-label">Основной долг</span><span class="cr-val" id="cr-principal">—</span></div>'
  + '<div class="cr-row"><span class="cr-label">Накопленные проценты</span><span class="cr-val" id="cr-interest">—</span></div>'
  + '<div class="cr-row"><span class="cr-label">Пеня за просрочку</span><span class="cr-val cr-total" id="cr-penalty">—</span></div>'
  + '<div class="cr-row" style="margin-top:8px"><span class="cr-label" style="font-weight:700">ИТОГО к оплате</span><span class="cr-val cr-total" id="cr-total">—</span></div>'
  + '<div class="cr-row"><span class="cr-label">Ориентир: 3 года от даты займа</span><span class="cr-val" id="cr-limit">—</span></div>'
  + '<div id="cr-expired" class="cr-warn" style="display:none">⚠️ <strong>Прошло более трёх лет.</strong> Это не означает автоматическое прекращение долга: начало и течение срока зависят от даты нарушения, платежей, признания долга, судебных актов и других обстоятельств. Нужна проверка документов.</div>'
  + '<div class="cr-warn">Расчёт предварительный и использует введённые вами ставки. Он не подтверждает размер задолженности и не заменяет договор, расчёт кредитора или юридическое заключение.</div>'
  + '</div>'
  + '</div>'
  + '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Нужна помощь с долгом?</p>'
  + '<h2 class="npage-cta-title">Сумма слишком большая?</h2>'
  + '<p class="npage-cta-sub">ZakonExpert поможет снизить долг, оспорить пеню и добиться реструктуризации. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Снижение долга</span><span>Оспаривание пени</span><span>Рассрочка</span></div></div>'
  + '<a href="https://wa.me/77058762795?text=Здравствуйте!+Хочу+узнать+как+снизить+долг+и+пеню." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + '<span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 705 876-27-95</span></span></a></div>'
  + '</div></div>'
  + JS;
