<%
const pageTitle = 'Калькулятор долга и пени по займу | ZakonExpert';
const pageDesc  = 'Рассчитайте сумму долга по МФО или банку: проценты, пеня, срок исковой давности. Бесплатный онлайн-калькулятор.';
const canonical = 'https://zakonexpertt.kz/calculator';
const schema = { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Главная',item:'https://zakonexpertt.kz/'},{'@type':'ListItem',position:2,name:'Калькулятор долга',item:canonical}]};

const CSS = '<style>'
  + '.calc-wrap{max-width:680px}'
  + '.calc-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:28px 32px;margin-top:1.5rem}'
  + '.calc-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}'
  + '.calc-group{display:flex;flex-direction:column;gap:6px}'
  + '.calc-label{font-size:.78rem;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.05em}'
  + '.calc-input{padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.95rem;outline:none;width:100%;box-sizing:border-box}'
  + '.calc-input:focus{border-color:#1a56db}'
  + '.calc-btn{width:100%;background:#1a56db;color:#fff;border:none;border-radius:12px;padding:14px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:8px}'
  + '.calc-btn:hover{background:#1e40af}'
  + '.calc-result{background:#f0fdf4;border:2px solid #86efac;border-radius:14px;padding:20px 24px;margin-top:1.2rem;display:none}'
