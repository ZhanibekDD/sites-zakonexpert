  + '.cr-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid #dcfce7;font-size:.9rem}'
  + '.cr-row:last-child{border-bottom:none}'
  + '.cr-label{color:#374151}'
  + '.cr-val{font-weight:700;color:#0d1f3c}'
  + '.cr-total{font-size:1.15rem;color:#16a34a}'
  + '.cr-warn{background:#fff7ed;border:1.5px solid #fed7aa;border-radius:10px;padding:12px 16px;font-size:.83rem;color:#92400e;margin-top:12px;line-height:1.6}'
  + '.calc-tabs{display:flex;gap:8px;margin-bottom:1.2rem;flex-wrap:wrap}'
  + '.calc-tab{padding:8px 18px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.83rem;font-weight:600;cursor:pointer;background:#fff;color:#475569}'
  + '.calc-tab.active{background:#1a56db;color:#fff;border-color:#1a56db}'
  + '@media(max-width:520px){.calc-row{grid-template-columns:1fr}}'
  + '</style>';

const JS = `<script>
function setTab(t) {
  document.querySelectorAll('.calc-tab').forEach(function(el){ el.classList.toggle('active', el.dataset.tab === t); });
  document.getElementById('field-rate').style.display = t === 'mfo' ? '' : 'none';
  document.getElementById('field-rate-bank').style.display = t === 'bank' ? '' : 'none';
  document.getElementById('field-penalty').parentElement.style.display = t === 'mfo' ? '' : 'none';
  document.getElementById('result-box').classList.remove('show');
}
function fmt(n) { return Math.round(n).toLocaleString('ru-RU') + ' ₸'; }
function calculate() {
  var activeTab = document.querySelector('.calc-tab.active').dataset.tab;
  var principal = parseFloat(document.getElementById('principal').value) || 0;
  var dateFrom  = new Date(document.getElementById('date-from').value);
  var dateTo    = new Date(document.getElementById('date-to').value);
  if (!principal || isNaN(dateFrom) || isNaN(dateTo) || dateTo <= dateFrom) {
    alert('Заполните все поля корректно'); return;
  }
  var days = Math.round((dateTo - dateFrom) / 86400000);
  var interest = 0, penalty = 0, total = 0;

  if (activeTab === 'mfo') {
    var rateDay = parseFloat(document.getElementById('rate-mfo').value) || 1;
    var penaltyRate = parseFloat(document.getElementById('penalty').value) || 0.5;
    interest = principal * (rateDay / 100) * days;
    penalty  = principal * (penaltyRate / 100) * days;
    total = principal + interest + penalty;
  } else {
    var rateYear = parseFloat(document.getElementById('rate-bank').value) || 24;
    interest = principal * (rateYear / 100) * (days / 365);
    penalty  = 0;
    total = principal + interest;
  }

  var limitDate = new Date(dateFrom); limitDate.setFullYear(limitDate.getFullYear() + 3);
  var expired   = dateTo > limitDate;

  document.getElementById('cr-days').textContent     = days + ' дней';
  document.getElementById('cr-principal').textContent = fmt(principal);
  document.getElementById('cr-interest').textContent  = fmt(interest);
  document.getElementById('cr-penalty').parentElement.style.display = penalty > 0 ? '' : 'none';
  document.getElementById('cr-penalty').textContent   = fmt(penalty);
  document.getElementById('cr-total').textContent     = fmt(total);
  document.getElementById('cr-limit').textContent     = limitDate.toLocaleDateString('ru-RU');
  document.getElementById('cr-expired').style.display = expired ? '' : 'none';
  document.getElementById('result-box').classList.add('show');
  if (window.ZE_trackEvent) window.ZE_trackEvent('calculator_completed', 'calculator');
}
window.addEventListener('DOMContentLoaded', function() { setTab('mfo'); });
</script>`;

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
