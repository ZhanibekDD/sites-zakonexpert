<%
function titleCase(value) {
  return String(value || '').toLowerCase().split(' ').map(function(word) {
    return word ? word[0].toUpperCase() + word.slice(1) : '';
  }).join(' ');
}

function phoneParts(raw) {
  var values = Array.isArray(raw) ? raw : String(raw || '').split(/[;,]+/);
  return values.map(function(value) {
    var text = String(value || '').trim();
    var digits = text.replace(/\D/g, '');
    if (digits.length === 11 && digits[0] === '8') digits = '7' + digits.slice(1);
    if (digits.length === 10) digits = '7' + digits;
    var formatted = text;
    if (digits.length === 11 && digits[0] === '7') {
      formatted = '+7 (' + digits.slice(1, 4) + ') ' + digits.slice(4, 7) + '-' + digits.slice(7, 9) + '-' + digits.slice(9, 11);
    }
    return { href: digits.length >= 10 ? 'tel:+' + digits : '', text: formatted };
  }).filter(function(item) { return item.text; }).slice(0, 2);
}

var regions = catalog.regions || [];
var items = catalog.items || [];
var paging = catalog.pagination || { page: 1, pageSize: items.length || 1, total: items.length, totalPages: 1 };
var total = regions.reduce(function(sum, region) { return sum + (region.count || 0); }, 0);
var verifiedDate = catalog.lastUpdated
  ? new Date(catalog.lastUpdated).toLocaleDateString('ru-RU', { timeZone: 'Asia/Almaty' })
  : '';
%>
<div class="professional-catalog">
  <section class="collector-hero">
    <div class="collector-container">
      <nav class="collector-breadcrumbs" aria-label="Хлебные крошки каталога">
        <a href="/">Главная</a><span>/</span>
        <% if (catalog.region) { %><a href="<%= catalog.baseUrl %>"><%= catalog.pluralLabel %></a><span>/</span><span><%= catalog.regionBreadcrumbLabel || catalog.region %></span><% } else { %><span><%= catalog.pluralLabel %></span><% } %>
      </nav>
      <div class="collector-hero__badges">
        <span class="collector-badge"><i class="bi <%= catalog.heroIcon %>"></i> <%= catalog.registryLabel %></span>
        <span class="collector-badge collector-badge--active"><i class="bi bi-database-check"></i> <%= total %> записей</span>
      </div>
      <div class="professional-catalog__hero-grid<%= catalog.regionEmblem ? ' professional-catalog__hero-grid--emblem' : '' %>">
        <div>
          <h1><%= catalog.region ? (catalog.regionH1 || catalog.regionTitle + ' — ' + catalog.region) : catalog.title %></h1>
          <p class="professional-catalog__subtitle"><%= catalog.region ? (catalog.regionIntro || 'Контакты, адреса и лицензии собраны в одном каталоге.') : catalog.subtitle %></p>
        </div>
        <% if (catalog.regionEmblem) { %>
          <div class="professional-catalog__hero-emblem" aria-hidden="true"><img src="/img/regions/<%= catalog.regionEmblem %>.webp" width="128" height="128" alt=""></div>
        <% } %>
      </div>
    </div>
  </section>

  <div class="professional-catalog__main">
    <div class="collector-container">
      <section class="professional-catalog__toolbar" aria-label="Поиск по каталогу">
        <form method="GET" action="<%= catalog.searchAction %>" class="professional-catalog__search">
          <label for="professional-search"><%= catalog.searchLabel %></label>
          <div class="professional-catalog__search-row">
            <input id="professional-search" type="search" name="q" placeholder="<%= catalog.searchPlaceholder %>" autocomplete="off">
            <button type="submit"><i class="bi bi-search"></i> Найти</button>
          </div>
        </form>
        <a class="professional-catalog__wa" href="https://wa.me/77003097566?text=<%= encodeURIComponent(catalog.whatsappText) %>" target="_blank" rel="noopener"
          <% if (catalog.analyticsEvent) { %>data-product-event="<%= catalog.analyticsEvent %>" data-event-target="catalog-whatsapp" data-event-cta="catalog_toolbar" data-source-entity-type="<%= catalog.type %>"<% } %>><i class="bi bi-whatsapp"></i> Бесплатная консультация</a>
      </section>

      <% if (catalog.type === 'notary') { %>
        <a class="professional-catalog__registry-pulse" href="/notaries/changes">
          <span><i class="bi bi-arrow-repeat"></i></span>
          <span><strong>Что изменилось в реестре нотариусов</strong><small>Новые записи, прекращение деятельности, контакты и передача архивов — автоматическая сверка с ЕНИС</small></span>
          <i class="bi bi-arrow-right"></i>
        </a>
      <% } %>

      <% if (!catalog.region) { %>
        <div class="professional-catalog__heading">
          <h2>Выберите регион</h2>
          <span class="professional-catalog__meta"><%= regions.length %> регионов · <%= total %> записей</span>
        </div>
        <div class="professional-catalog__regions">
          <% regions.forEach(function(region) {
            const emblem = typeof catalog.getRegionEmblem === 'function'
              ? catalog.getRegionEmblem(region.region)
              : '';
          %>
            <a class="professional-catalog__region" href="<%= region.path || (catalog.baseUrl + '?region=' + encodeURIComponent(region.region)) %>">
              <span class="professional-catalog__region-icon">
                <% if (emblem) { %>
                  <img src="/img/regions/<%= emblem %>.webp" width="128" height="128" alt="" aria-hidden="true" loading="lazy">
                <% } else { %>
                  <i class="bi bi-geo-alt"></i>
                <% } %>
              </span>
              <span><strong><%= region.region %></strong><small><%= region.count %> <%= catalog.countLabel %></small></span>
              <i class="bi bi-arrow-right"></i>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="professional-catalog__heading">
          <h2><%= catalog.regionListTitle || (catalog.regionTitle + ' в регионе') %></h2>
          <span class="professional-catalog__meta"><% if (paging.total) { %><%= ((paging.page - 1) * paging.pageSize) + 1 %>–<%= Math.min(paging.page * paging.pageSize, paging.total) %> из <%= paging.total %><% } else { %>0 записей<% } %><%= verifiedDate ? ' · обновлено ' + verifiedDate : '' %></span>
        </div>
        <% if (!items.length) { %>
          <div class="professional-catalog__empty">В выбранном регионе записи не найдены.</div>
        <% } else { %>
          <div class="professional-catalog__grid">
            <% items.forEach(function(item) {
              var isNotary = catalog.type === 'notary';
              var inactive = isNotary && item.active === false;
              var phones = phoneParts(isNotary ? item.phone : item.phones);
              var detailUrl = catalog.itemBaseUrl + item.slug;
            %>
              <article class="professional-card<%= inactive ? ' professional-card--inactive' : '' %>">
                <div class="professional-card__head">
                  <span class="professional-card__icon"><i class="bi <%= catalog.cardIcon %>"></i></span>
                  <div>
                    <h3 class="professional-card__name"><a href="<%= detailUrl %>"><%= titleCase(item.name) %></a></h3>
                    <% if (isNotary) { %>
                      <span class="professional-card__status<%= inactive ? ' professional-card__status--inactive' : '' %>"><i class="bi <%= inactive ? 'bi-x-circle' : 'bi-check-circle' %>"></i> <%= inactive ? 'Деятельность прекращена' : 'Действующий нотариус' %></span>
                    <% } else { %>
                      <span class="professional-card__status"><i class="bi bi-check-circle"></i> Частный судебный исполнитель</span>
                    <% } %>
                  </div>
                </div>
                <div class="professional-card__license"><i class="bi bi-file-earmark-check"></i><span><%= item.license ? ('Лицензия № ' + item.license + (item.licenseDate ? ' от ' + item.licenseDate : '')) : 'Номер лицензии не опубликован' %></span></div>
                <div class="professional-card__rows">
                  <div class="professional-card__row">
                    <span class="professional-card__icon"><i class="bi bi-telephone"></i></span>
                    <span>
                      <% if (phones.length) { phones.forEach(function(phone, index) { %><% if (index) { %><br><% } %><% if (phone.href) { %><a href="<%= phone.href %>"><%= phone.text %></a><% } else { %><%= phone.text %><% } %><% }); } else { %><span class="professional-card__missing"><%= isNotary ? 'Не опубликован в ЕНИС' : 'Телефон не указан' %></span><% } %>
                    </span>
                  </div>
                  <div class="professional-card__row">
                    <span class="professional-card__icon"><i class="bi bi-envelope"></i></span>
                    <% if (item.email) { %><a href="mailto:<%= item.email %>"><%= item.email %></a><% } else { %><span class="professional-card__missing"><%= isNotary ? 'Не опубликован в ЕНИС' : 'Email не указан' %></span><% } %>
                  </div>
                  <% if (item.address) { %><div class="professional-card__row"><span class="professional-card__icon"><i class="bi bi-geo-alt"></i></span><span><%= item.address %></span></div><% } %>
                  <% if (isNotary && item.schedule) { %><div class="professional-card__row"><span class="professional-card__icon"><i class="bi bi-clock"></i></span><span><%= item.schedule %></span></div><% } %>
                </div>
                <a class="professional-card__link" href="<%= detailUrl %>">Открыть полную карточку <i class="bi bi-arrow-right"></i></a>
              </article>
            <% }); %>
          </div>
          <% if (paging.totalPages > 1 && catalog.regionPage) {
            var startPage = Math.max(2, paging.page - 2);
            var endPage = Math.min(paging.totalPages - 1, paging.page + 2);
            function pagePath(page) { return catalog.regionPage.path + (page > 1 ? '?page=' + page : ''); }
          %>
            <nav class="professional-pagination" aria-label="Страницы каталога нотариусов">
              <% if (paging.page > 1) { %><a href="<%= pagePath(paging.page - 1) %>" rel="prev" aria-label="Предыдущая страница"><i class="bi bi-arrow-left"></i><span>Назад</span></a><% } %>
              <a href="<%= pagePath(1) %>" class="<%= paging.page === 1 ? 'is-current' : '' %>"<% if (paging.page === 1) { %> aria-current="page"<% } %>>1</a>
              <% if (startPage > 2) { %><span aria-hidden="true">…</span><% } %>
              <% for (var page = startPage; page <= endPage; page += 1) { %>
                <a href="<%= pagePath(page) %>" class="<%= page === paging.page ? 'is-current' : '' %>"<% if (page === paging.page) { %> aria-current="page"<% } %>><%= page %></a>
              <% } %>
              <% if (endPage < paging.totalPages - 1) { %><span aria-hidden="true">…</span><% } %>
              <a href="<%= pagePath(paging.totalPages) %>" class="<%= paging.page === paging.totalPages ? 'is-current' : '' %>"<% if (paging.page === paging.totalPages) { %> aria-current="page"<% } %>><%= paging.totalPages %></a>
              <% if (paging.page < paging.totalPages) { %><a href="<%= pagePath(paging.page + 1) %>" rel="next" aria-label="Следующая страница"><span>Дальше</span><i class="bi bi-arrow-right"></i></a><% } %>
            </nav>
          <% } %>
        <% } %>
      <% } %>

      <% if (catalog.type === 'bailiff' && catalog.regionPage) { %>
        <section class="bailiff-region-help" aria-labelledby="bailiff-region-help-title">
          <div class="bailiff-region-help__heading">
            <div><span>Если ЧСИ наложил ограничение</span><h2 id="bailiff-region-help-title">Что проверить до оплаты</h2></div>
            <a href="/snyatie-ogranichenii-chsi">Полный порядок действий <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="bailiff-region-help__steps">
            <article><span>1</span><div><strong>Найдите своего ЧСИ</strong><p>Сверьте ФИО, регион, номер лицензии и контакты с документами исполнительного производства.</p></div></article>
            <article><span>2</span><div><strong>Получите постановления</strong><p>Запросите документ о возбуждении производства, основание взыскания и постановление о конкретной мере.</p></div></article>
            <article><span>3</span><div><strong>Выберите правовой маршрут</strong><p>Проверяйте основание, сроки и уведомление. Оплата неизвестного требования не заменяет анализ документов.</p></div></article>
          </div>
          <div class="bailiff-region-help__routes">
            <a href="/kak-uznat-kto-nalozhil-arest-na-schet"><i class="bi bi-search"></i><span><strong>Кто наложил арест</strong><small>Установить инициатора и документ</small></span></a>
            <a href="/kak-poluchit-postanovlenie-chsi"><i class="bi bi-file-earmark-text"></i><span><strong>Получить постановление</strong><small>Какие материалы запросить у ЧСИ</small></span></a>
            <a href="/snyatie-aresta-so-scheta"><i class="bi bi-credit-card"></i><span><strong>Снять арест со счёта</strong><small>Пошаговый маршрут по документу</small></span></a>
            <a href="/arest-snyat-no-schet-zablokirovan"><i class="bi bi-unlock"></i><span><strong>Арест уже снят</strong><small>Почему счёт всё ещё недоступен</small></span></a>
          </div>
          <div class="bailiff-region-help__cta">
            <div><strong>Не знаете, какое производство относится к аресту?</strong><span>Пришлите скрин банка и постановление. Не отправляйте SMS-коды, CVV и пароли.</span></div>
            <div class="bailiff-region-help__cta-actions">
              <a class="bailiff-region-help__diagnostic" href="/diagnostika-aresta?source=bailiff&amp;entry=bailiff_region"
                data-product-event="arrest_diagnostic_entry" data-event-target="registry-diagnostic"
                data-event-cta="bailiff_region" data-source-entity-type="bailiff"
                data-service-type="arrest_diagnostic" data-document-type="bailiff"><i class="bi bi-signpost-split"></i> Ответить на 2 вопроса</a>
              <a href="https://wa.me/77003097566?text=<%= encodeURIComponent(catalog.whatsappText) %>" target="_blank" rel="noopener"
                data-product-event="click_cta_bailiff" data-event-target="catalog-whatsapp"
                data-event-cta="region_bottom" data-source-entity-type="bailiff"><i class="bi bi-whatsapp"></i> Написать</a>
            </div>
          </div>
        </section>

        <section class="bailiff-region-links" aria-labelledby="other-bailiff-regions">
          <div class="professional-catalog__heading"><h2 id="other-bailiff-regions">ЧСИ в других регионах</h2><a href="/bailiffs">Все регионы Казахстана →</a></div>
          <div>
            <% regions.filter(function(item) { return item.region !== catalog.region; }).forEach(function(item) { %>
              <a href="<%= item.path || (catalog.baseUrl + '?region=' + encodeURIComponent(item.region)) %>"><%= item.region %><span><%= item.count %></span></a>
            <% }); %>
          </div>
        </section>
      <% } %>

      <% if (catalog.type === 'notary' && catalog.regionPage) { %>
        <section class="bailiff-region-help" aria-labelledby="notary-region-help-title">
          <div class="bailiff-region-help__heading">
            <div><span>Если нотариус совершил исполнительную надпись</span><h2 id="notary-region-help-title">Что проверить до оплаты</h2></div>
            <a href="/otmena-ispolnitelnoi-nadpisi">Порядок отмены надписи <i class="bi bi-arrow-right"></i></a>
          </div>
          <div class="bailiff-region-help__steps">
            <article><span>1</span><div><strong>Получите копию надписи</strong><p>Проверьте нотариуса, взыскателя, сумму, дату и основание требования. Одного уведомления банка недостаточно.</p></div></article>
            <article><span>2</span><div><strong>Зафиксируйте дату получения</strong><p>Закон связывает срок подачи письменного возражения с получением копии исполнительной надписи должником.</p></div></article>
            <article><span>3</span><div><strong>Проверьте возражение</strong><p>При наличии оснований направьте его нотариусу, совершившему надпись. Если срок или порядок спорны, оцените судебный маршрут.</p></div></article>
          </div>
          <div class="bailiff-region-help__routes">
            <a href="/zamena-notariusa"><i class="bi bi-archive"></i><span><strong>Нотариус не работает</strong><small>Узнать, кому передан его архив</small></span></a>
            <a href="/notary-search"><i class="bi bi-search"></i><span><strong>Найти нотариуса</strong><small>Поиск по ФИО в реестре ЕНИС</small></span></a>
            <a href="/otmena-ispolnitelnoi-nadpisi"><i class="bi bi-file-earmark-x"></i><span><strong>Отменить надпись</strong><small>Сроки, документы и порядок действий</small></span></a>
            <a href="https://adilet.zan.kz/rus/docs/Z970000155_" target="_blank" rel="noopener"><i class="bi bi-bank"></i><span><strong>Проверить закон</strong><small>Статьи 92-6–92-8 на Әділет</small></span></a>
          </div>
          <div class="bailiff-region-help__cta">
            <div><strong>Надпись уже передали ЧСИ или нотариус не отвечает?</strong><span>Ответьте на два вопроса — покажем подходящий маршрут. Не отправляйте SMS-коды, CVV и пароли.</span></div>
            <div class="bailiff-region-help__cta-actions">
              <a class="bailiff-region-help__diagnostic" href="/diagnostika-aresta?source=notary&amp;entry=notary_region"
                data-product-event="arrest_diagnostic_entry" data-event-target="registry-diagnostic"
                data-event-cta="notary_region" data-source-entity-type="notary"
                data-service-type="arrest_diagnostic" data-document-type="notary"><i class="bi bi-signpost-split"></i> Ответить на 2 вопроса</a>
              <a href="https://wa.me/77003097566?text=<%= encodeURIComponent(catalog.whatsappText) %>" target="_blank" rel="noopener"
                data-product-event="click_cta_notary" data-event-target="catalog-whatsapp"
                data-event-cta="region_bottom" data-source-entity-type="notary"><i class="bi bi-whatsapp"></i> Написать</a>
            </div>
          </div>
        </section>

        <section class="bailiff-region-links" aria-labelledby="other-notary-regions">
          <div class="professional-catalog__heading"><h2 id="other-notary-regions">Нотариусы в других регионах</h2><a href="/notaries">Все регионы Казахстана →</a></div>
          <div>
            <% regions.filter(function(item) { return item.region !== catalog.region; }).forEach(function(item) { %>
              <a href="<%= item.path || (catalog.baseUrl + '?region=' + encodeURIComponent(item.region)) %>"><%= item.region %><span><%= item.count %></span></a>
            <% }); %>
          </div>
        </section>
      <% } %>

      <div class="professional-catalog__source">
        <i class="bi bi-database-check"></i>
        <div><strong>Источник данных:</strong> <a href="<%= catalog.sourceUrl %>" target="_blank" rel="noopener"><%= catalog.sourceName %></a>. <%= catalog.sourceText %><%= verifiedDate ? ' Последнее обновление базы ZakonExpert: ' + verifiedDate + '.' : '' %></div>
      </div>
    </div>
  </div>
</div>
