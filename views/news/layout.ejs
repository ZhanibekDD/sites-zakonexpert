const pageExtraStyles = (typeof extraStyles !== 'undefined' && Array.isArray(extraStyles) ? extraStyles : [])
  .filter(function(asset) { return /^\/css\/[a-z0-9._/?=&-]+$/i.test(asset); });
const pageExtraScripts = (typeof extraScripts !== 'undefined' && Array.isArray(extraScripts) ? extraScripts : [])
  .filter(function(asset) { return /^\/js\/[a-z0-9._/?=&-]+$/i.test(asset); });
const suppressOwnContacts = typeof suppressZakonExpertContacts !== 'undefined'
