<script>
// Копировать телефон по клику
document.querySelectorAll('.npage-phone-link').forEach(function(link){
  link.title = 'Нажмите чтобы скопировать';
  link.addEventListener('click', function(){
    var txt = this.textContent.trim();
    navigator.clipboard && navigator.clipboard.writeText(txt).then(function(){
      var orig = link.textContent;
      link.textContent = '✓ Скопировано!';
      setTimeout(function(){ link.textContent = orig; }, 1500);
    }).catch(function(){});
  });
});
</script>
