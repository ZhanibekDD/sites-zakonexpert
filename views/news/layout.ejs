// Search snippets: Google shows about 60–70 characters of a title and ~160 of a description.
// Long titles lose the brand suffix first, then a parenthesised region, then the tail after the
// last « — »; only then are they cut at a word. Registry names that lost their closing quote
// («ТОО "Ромашка — …») get it back. Descriptions over 180 characters end at a sentence.
function zxBalanceQuotes(text) {
  const value = String(text || '');
  if ((value.match(/"/g) || []).length % 2 === 0) return value;
  const open = value.lastIndexOf('"');
  const rest = value.slice(open + 1);
  const stop = rest.search(/ — |: | \| |\. |…$/);
  return stop >= 0 ? value.slice(0, open + 1 + stop) + '"' + value.slice(open + 1 + stop) : value + '"';
}
function zxCut(text, max) {
  const cut = text.slice(0, max - 1);
  const space = cut.lastIndexOf(' ');
  return zxBalanceQuotes((space > max * 0.5 ? cut.slice(0, space) : cut).replace(/[\s,;:—–-]+$/, '') + '…');
}
function zxFitTitle(text, max) {
  let value = zxBalanceQuotes(String(text || '').replace(/\s+/g, ' ').trim());
  if (value.length <= max) return value;
  // Without the brand a whole phrase a few characters over is better than an ellipsis
  value = value.replace(/ \| ZakonExpert(?: Казахстан| Қазақстан)?$/, '');
  if (value.length <= max + 4) return value;
  value = value.replace(/\s*\([^()]*\)/, '');
  if (value.length <= max + 4) return value;
  const dash = value.lastIndexOf(' — ');
  if (dash > 20) {
    value = value.slice(0, dash);
    if (value.length <= max) return value;
  }
  return zxCut(value, max);
}
function zxFitDescription(text, max) {
  const value = zxBalanceQuotes(String(text || '').replace(/\s+/g, ' ').trim());
  if (value.length <= max) return value;
  const sentence = value.slice(0, max).lastIndexOf('. ');
  return sentence >= 100 ? value.slice(0, sentence + 1) : zxCut(value, max);
}
const pageTitleText = zxFitTitle(title, 70);
const pageDescriptionText = zxFitDescription(description, 180);
