const safeSchemaJson = (typeof schema !== 'undefined' && schema)
  ? JSON.stringify(schema).replace(/</g, '\\u003c')
  : '';
// This layout is shared by news, catalogues, registry profiles and tools.
// Autoplacement is safe only inside editorial articles: on structured registry
// cards it can inject creatives between data rows and make official details
// look corrupted. Callers may still override the default explicitly.
const autoAdsEnabled = typeof enableAutoAds !== 'undefined'
  ? Boolean(enableAutoAds)
