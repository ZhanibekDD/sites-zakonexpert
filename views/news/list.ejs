<%
const CATEGORIES = [
  { slug: '',          label: 'Все' },
  { slug: 'аресты',   label: 'Аресты счетов' },
  { slug: 'finance',  label: 'Банки' },
  { slug: 'chsi',     label: 'ЧСИ' },
  { slug: 'notarius', label: 'Исп. надпись' },
  { slug: 'sud',      label: 'Суд' },
  { slug: 'alimenty', label: 'Алименты' },
  { slug: 'shtrafy',  label: 'Штрафы' },
  { slug: 'avto',     label: 'Авто и имущество' },
  { slug: 'laws',     label: 'Законы' },
];

/* CSS-градиент + inline SVG-иконка по категории */
function getCoverBlock(a) {
  const tags = (a.tags || '').toLowerCase();
  const title = (a.title || '').toLowerCase();
  const combined = tags + ' ' + title;

  let theme = 'default';
  if (combined.includes('kaspi') || combined.includes('halyk') || combined.includes('freedom') || combined.includes('банк') || a.category === 'finance') theme = 'bank';
  else if (combined.includes('чси') || combined.includes('судебный исполнитель')) theme = 'chsi';
  else if (combined.includes('нотариус') || combined.includes('надпись')) theme = 'notarius';
  else if (combined.includes('суд') || combined.includes('решение суд')) theme = 'sud';
  else if (combined.includes('штраф') || combined.includes('коап')) theme = 'shtraf';
  else if (combined.includes('алимент')) theme = 'alimenty';
  else if (combined.includes('авто') || combined.includes('запрет')) theme = 'auto';
  else if (a.category === 'laws') theme = 'laws';

  const themes = {
    bank: {
      grad: 'linear-gradient(135deg,#0e3a6e 0%,#1a5ca8 100%)',
      label: 'Банки',
      icon: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h2"/><path d="M12 15h2"/>',
    },
    chsi: {
      grad: 'linear-gradient(135deg,#1a2a4a 0%,#2d4a7a 100%)',
      label: 'ЧСИ',
      icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>',
    },
    notarius: {
      grad: 'linear-gradient(135deg,#2a1a0e 0%,#7a4a1a 100%)',
      label: 'Нотариус',
      icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
    },
    sud: {
      grad: 'linear-gradient(135deg,#1a0e2a 0%,#4a1a7a 100%)',
      label: 'Суд',
      icon: '<line x1="12" y1="20" x2="12" y2="4"/><line x1="4" y1="9" x2="20" y2="9"/><path d="M4 9 Q4 15 12 20 Q20 15 20 9"/>',
    },
    shtraf: {
      grad: 'linear-gradient(135deg,#2a1a00 0%,#8a4400 100%)',
      label: 'Штрафы',
      icon: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
    },
    alimenty: {
      grad: 'linear-gradient(135deg,#0e2a1a 0%,#1a5a3a 100%)',
      label: 'Алименты',
      icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
    },
    auto: {
      grad: 'linear-gradient(135deg,#0e1a2a 0%,#1a3a5a 100%)',
      label: 'Авто',
      icon: '<path d="M5 17H3v-7l2.5-5h13l2.5 5v7h-2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><line x1="9" y1="17" x2="15" y2="17"/>',
    },
    laws: {
      grad: 'linear-gradient(135deg,#1a2a0e 0%,#2a4a1a 100%)',
      label: 'Законы',
      icon: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
    },
    default: {
      grad: 'linear-gradient(135deg,#0e2a47 0%,#163d65 100%)',
      label: 'Новости',
      icon: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="13" y2="15"/>',
    },
  };

  const t = themes[theme] || themes.default;
  return { grad: t.grad, label: t.label, icon: t.icon };
}

function getCatLabel(a) {
  if (a.category === 'laws') return 'Законы';
  if (a.category === 'finance') return 'Банки';
  if (a.category === 'chsi') return 'ЧСИ';
  if (a.category === 'notarius') return 'Нотариус';
  if (a.category === 'sud') return 'Суд';
  if (a.category === 'alimenty') return 'Алименты';
  if (a.category === 'shtrafy') return 'Штрафы';
  if (a.category === 'avto') return 'Авто';
  return 'Новости';
}

function getDateStr(a, long) {
  if (!a.published_at_site) return '';
  const opts = long
    ? { day: 'numeric', month: 'long', year: 'numeric' }
    : { day: 'numeric', month: 'short' };
  return new Date(a.published_at_site).toLocaleDateString('ru-RU', opts);
}

function getTags(a) {
  try { return JSON.parse(a.tags || '[]'); } catch { return []; }
}

const featured   = articles.length > 0 ? articles[0] : null;
const secondary  = articles.slice(1, 3);
const gridItems  = articles.slice(3);

const body = `
<!-- HERO -->
<section class="news-hero">
  <div class="landing-container">
    <nav aria-label="breadcrumb" class="news-breadcrumb">
      <a href="/">Главная</a> / <span>Новости</span>
    </nav>
    <h1>Новости и разборы: аресты счетов, ЧСИ и долги в Казахстане</h1>
    <p class="news-hero-lead">
      Отслеживаем события в банках, судах, у ЧСИ и в законодательстве РК.
      Каждый материал — юридический разбор ZakonExpert для должников.
    </p>
    <nav class="news-categories" aria-label="Фильтр">
      ${CATEGORIES.map(c => `
      <a href="${c.slug ? '/news?cat=' + c.slug : '/news'}"
         class="${(!currentCategory && !c.slug) || currentCategory === c.slug ? 'active' : ''}">${c.label}</a>`).join('')}
    </nav>
  </div>
</section>

<!-- NEWS BODY -->
<section class="news-section">
  <div class="landing-container">

    ${articles.length === 0 ? `
    <div class="news-empty">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="8" y1="13" x2="16" y2="13"/>
        <line x1="8" y1="17" x2="12" y2="17"/>
      </svg>
      <h2>Новости скоро появятся</h2>
      <p>Мы отслеживаем события в финансово-правовой сфере Казахстана.<br>
         Пока вы можете <a href="/#checker-section">проверить ИИН</a> или прочитать <a href="/zakony">раздел законов</a>.</p>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:20px">
        <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
        <a href="/zakony" class="btn-legal-outline">Читать о законах</a>
      </div>
    </div>
    ` : `

    <!-- TOP ROW: featured + secondary -->
    ${featured ? `
    <div class="news-top-row">

      <!-- BIG FEATURED -->
      <article class="news-featured-main">
        <a href="/news/${featured.slug}" class="news-featured-main-img-link">
          <div class="news-featured-main-img" style="background:${getCoverBlock(featured).grad}">
            <div class="news-cover-icon"><svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="rgba(215,167,66,0.9)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${getCoverBlock(featured).icon}</svg></div>
            ${featured.og_image
              ? `<img src="${featured.og_image}" alt="${featured.title}" loading="eager" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;" onerror="this.remove()">`
              : ``
            }
            <span class="news-featured-cat-badge">${getCatLabel(featured)}</span>
          </div>
        </a>
        <div class="news-featured-main-body">
          <div class="news-featured-main-meta">
            <span class="news-source">${featured.source_name || 'ZakonExpert'}</span>
            <time class="news-date">${getDateStr(featured, true)}</time>
            ${getTags(featured).slice(0,2).map(t => `<span class="legal-pill news-tag">${t}</span>`).join('')}
          </div>
          <h2><a href="/news/${featured.slug}">${featured.title}</a></h2>
          <p class="news-featured-excerpt">${(featured.excerpt || '').substring(0, 260)}</p>
          <a href="/news/${featured.slug}" class="news-featured-readmore">
            Читать полный разбор
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </article>

      <!-- SECONDARY COLUMN -->
      ${secondary.length > 0 ? `
      <div class="news-featured-side">
        ${secondary.map(a => {
          const cb = getCoverBlock(a);
          return `
        <a href="/news/${a.slug}" class="news-secondary-card">
          <div class="news-secondary-img" style="background:${cb.grad}">
            <div class="news-cover-icon-sm"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="rgba(215,167,66,0.9)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${cb.icon}</svg></div>
            ${a.og_image
              ? `<img src="${a.og_image}" alt="${a.title}" loading="lazy" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;" onerror="this.remove()">`
              : ``
            }
          </div>
          <div class="news-secondary-body">
            <div class="news-secondary-meta">
              <span>${getCatLabel(a)}</span>
              <span> · </span>
              <time>${getDateStr(a, false)}</time>
            </div>
            <div class="news-secondary-title">${a.title}</div>
            <div class="news-secondary-tags">
              ${getTags(a).slice(0,2).map(t => `<span class="legal-pill news-tag">${t}</span>`).join('')}
            </div>
          </div>
        </a>`;
        }).join('')}
      </div>
      ` : ''}

    </div>
    ` : ''}

    <!-- MARKETING CTA STRIP -->
    <div class="news-cta-strip">
      <div class="news-cta-strip-icon">⚖️</div>
      <div class="news-cta-strip-text">
        <p class="news-cta-strip-q">ЧСИ арестовал счёт, карту или авто?</p>
        <p class="news-cta-strip-hint">Проверьте исполнительные производства по ИИН — бесплатно</p>
      </div>
      <div class="news-cta-strip-actions">
        <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
        <a href="https://wa.me/77000300024?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5.+%D0%A7%D0%A1%D0%98+%D0%B0%D1%80%D0%B5%D1%81%D1%82%D0%BE%D0%B2%D0%B0%D0%BB+%D1%81%D1%87%D1%91%D1%82.+%D0%9D%D1%83%D0%B6%D0%BD%D0%B0+%D0%BA%D0%BE%D0%BD%D1%81%D1%83%D0%BB%D1%8C%D1%82%D0%B0%D1%86%D0%B8%D1%8F."
           target="_blank" rel="noopener" class="btn-legal-outline">Написать в WhatsApp</a>
      </div>
    </div>

    <!-- GRID: remaining articles -->
    ${gridItems.length > 0 ? `
    <div class="news-section-header">
      <h2>Все материалы</h2>
    </div>
    <div class="news-grid">
      ${gridItems.map(a => {
        const cover  = getCoverBlock(a);
        const tags   = getTags(a);
        const dateStr = getDateStr(a, false);
        return `
      <article class="news-card">
        <a href="/news/${a.slug}" class="news-card-cover-link">
          <div class="news-card-cover" style="background:${cover.grad}">
            <div class="news-card-cover-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(215,167,66,0.9)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${cover.icon}</svg></div>
            ${a.og_image
              ? `<img src="${a.og_image}" alt="${a.title}" loading="lazy" onerror="this.remove()">`
              : ``
            }
            <span class="news-card-category">${cover.label}</span>
          </div>
        </a>
        <div class="news-card-body">
          <div class="news-card-meta">
            <span class="news-source">${a.source_name || 'ZakonExpert'}</span>
            <time class="news-date">${dateStr}</time>
          </div>
          <h2 class="news-card-title">
            <a href="/news/${a.slug}">${a.title}</a>
          </h2>
          <p class="news-card-excerpt">${(a.excerpt || '').substring(0, 140)}</p>
          <div class="news-card-footer">
            <a href="/news/${a.slug}" class="news-read-more">Читать разбор →</a>
            ${tags.slice(0,2).map(t => `<span class="legal-pill news-tag">${t}</span>`).join('')}
          </div>
        </div>
      </article>`;
      }).join('')}
    </div>
    ` : ''}

    `}

    <!-- PAGINATION -->
    ${totalPages > 1 ? `
    <nav class="news-pagination" aria-label="Пагинация">
      ${currentPage > 1 ? `
      <a href="/news?page=${currentPage - 1}${currentCategory ? '&cat=' + currentCategory : ''}"
         class="news-page-btn">← Назад</a>` : ''}
      <span class="news-page-info">Страница ${currentPage} из ${totalPages}</span>
      ${currentPage < totalPages ? `
      <a href="/news?page=${currentPage + 1}${currentCategory ? '&cat=' + currentCategory : ''}"
         class="news-page-btn">Вперёд →</a>` : ''}
    </nav>
    ` : ''}

    <!-- BOTTOM CTA BLOCK -->
    <div class="news-cta-block">
      <div class="news-cta-inner">
        <div>
          <h3>ЧСИ арестовал счёт или имущество?</h3>
          <p>Проверьте ИИН — мы установим основание взыскания и объясним правовой путь бесплатно.</p>
        </div>
        <div class="news-cta-actions">
          <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
          <a href="https://wa.me/77000300024?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5.+%D0%A7%D0%B8%D1%82%D0%B0%D0%BB+%D0%BD%D0%BE%D0%B2%D0%BE%D1%81%D1%82%D0%B8.+%D0%9D%D1%83%D0%B6%D0%BD%D0%B0+%D0%BA%D0%BE%D0%BD%D1%81%D1%83%D0%BB%D1%8C%D1%82%D0%B0%D1%86%D0%B8%D1%8F."
             target="_blank" rel="noopener" class="btn-legal-outline">WhatsApp</a>
        </div>
      </div>
    </div>

  </div>
</section>
`;
%>
<%- include('layout', { title, description, canonical, ogType: 'website', ogImage: '/img/zakonexpert-logo-kazakhstan.png', schema, activeNav: 'news', body }) %>
