<%
const CATEGORIES = [
  { slug: '',          label: 'Все' },
  { slug: 'аресты',   label: 'Аресты счетов' },
  { slug: 'finance',  label: 'Банки' },
  { slug: 'chsi',     label: 'ЧСИ' },
  { slug: 'notarius', label: 'Исп. надпись' },
  { slug: 'sud',      label: 'Суд' },
  { slug: 'alimenty', label: 'Алименты' },
  { slug: 'shtrafy',  label: 'Штрафы' },
  { slug: 'avto',     label: 'Авто и имущество' },
  { slug: 'laws',     label: 'Законы' },
];

/* CSS-градиент + inline SVG-иконка по категории — без зависимости от внешних картинок */
function getCoverBlock(a) {
  const tags = (a.tags || '').toLowerCase();
  const title = (a.title || '').toLowerCase();
  const combined = tags + ' ' + title;

  // Определяем тип
  let theme = 'default';
  if (combined.includes('kaspi') || combined.includes('halyk') || combined.includes('freedom') || combined.includes('банк') || a.category === 'finance') theme = 'bank';
  else if (combined.includes('чси') || combined.includes('судебный исполнитель')) theme = 'chsi';
  else if (combined.includes('нотариус') || combined.includes('надпись')) theme = 'notarius';
  else if (combined.includes('суд') || combined.includes('решение суд')) theme = 'sud';
  else if (combined.includes('штраф') || combined.includes('коап')) theme = 'shtraf';
  else if (combined.includes('алимент')) theme = 'alimenty';
  else if (combined.includes('авто') || combined.includes('запрет')) theme = 'auto';
  else if (a.category === 'laws') theme = 'laws';

  const themes = {
    bank: {
      grad: 'linear-gradient(135deg,#0e3a6e 0%,#1a5ca8 100%)',
      label: 'Банки',
      icon: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h2"/><path d="M12 15h2"/>',
    },
    chsi: {
      grad: 'linear-gradient(135deg,#1a2a4a 0%,#2d4a7a 100%)',
      label: 'ЧСИ',
      icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>',
    },
    notarius: {
      grad: 'linear-gradient(135deg,#2a1a0e 0%,#7a4a1a 100%)',
      label: 'Нотариус',
      icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
    },
    sud: {
      grad: 'linear-gradient(135deg,#1a0e2a 0%,#4a1a7a 100%)',
      label: 'Суд',
      icon: '<line x1="12" y1="20" x2="12" y2="4"/><line x1="4" y1="9" x2="20" y2="9"/><path d="M4 9 Q4 15 12 20 Q20 15 20 9"/>',
    },
    shtraf: {
      grad: 'linear-gradient(135deg,#2a1a00 0%,#8a4400 100%)',
      label: 'Штрафы',
      icon: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
    },
    alimenty: {
      grad: 'linear-gradient(135deg,#0e2a1a 0%,#1a5a3a 100%)',
      label: 'Алименты',
      icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
    },
    auto: {
      grad: 'linear-gradient(135deg,#0e1a2a 0%,#1a3a5a 100%)',
      label: 'Авто',
      icon: '<path d="M5 17H3v-7l2.5-5h13l2.5 5v7h-2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><line x1="9" y1="17" x2="15" y2="17"/>',
    },
    laws: {
      grad: 'linear-gradient(135deg,#1a2a0e 0%,#2a4a1a 100%)',
      label: 'Законы',
      icon: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
    },
    default: {
      grad: 'linear-gradient(135deg,#0e2a47 0%,#163d65 100%)',
      label: 'Новости',
      icon: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="13" y2="15"/>',
    },
  };

  const t = themes[theme] || themes.default;
  return { grad: t.grad, label: t.label, icon: t.icon };
}

const body = `
<!-- NEWS HERO -->
<section class="news-hero">
  <div class="legal-container">
    <nav aria-label="breadcrumb" class="news-breadcrumb">
      <a href="/">Главная</a> / <span>Новости</span>
    </nav>
    <h1>Новости и разборы по арестам счетов, ЧСИ и долгам в Казахстане</h1>
    <p class="news-hero-lead">
      Мы отслеживаем события в банках, судах, исполнительном производстве и законодательстве РК —
      и объясняем, что это значит для должников. Каждый материал — уникальный юридический разбор ZakonExpert.
    </p>

    <!-- CATEGORY FILTERS -->
    <div class="news-categories" role="navigation" aria-label="Фильтр по категориям">
      ${CATEGORIES.map(c => `
      <a href="${c.slug ? '/news?cat=' + c.slug : '/news'}"
         class="${(!currentCategory && !c.slug) || currentCategory === c.slug ? 'active' : ''}"
         aria-current="${(!currentCategory && !c.slug) || currentCategory === c.slug ? 'page' : 'false'}">
        ${c.label}
      </a>`).join('')}
    </div>
  </div>
</section>

<!-- NEWS GRID -->
<section class="news-section">
  <div class="legal-container">

    ${articles.length === 0 ? `
    <div class="news-empty">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="8" y1="13" x2="16" y2="13"/>
        <line x1="8" y1="17" x2="12" y2="17"/>
      </svg>
      <h2>Новости скоро появятся</h2>
      <p>Мы отслеживаем события в финансово-правовой сфере Казахстана.<br>
         А пока вы можете <a href="/#checker-section">проверить ИИН</a>
         или прочитать <a href="/zakony.html">раздел законов</a>.</p>
      <div style="display:flex;gap:12px;justify-content:center;margin-top:20px">
        <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
        <a href="/zakony.html" class="btn-legal-outline">Читать о законах</a>
      </div>
    </div>
    ` : `
    <div class="news-grid">
      ${articles.map(a => {
        const cover  = getCoverBlock(a);
        const tags   = (() => { try { return JSON.parse(a.tags || '[]'); } catch { return []; } })();
        const dateStr = a.published_at_site
          ? new Date(a.published_at_site).toLocaleDateString('ru-RU', {day:'numeric', month:'long', year:'numeric'})
          : '';
        return `
      <article class="news-card">
        <a href="/news/${a.slug}" class="news-card-cover-link">
          <div class="news-card-cover" style="background:${cover.grad}">
            <div class="news-card-cover-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(215,167,66,0.9)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${cover.icon}</svg>
            </div>
            <span class="news-card-category">${cover.label}</span>
          </div>
        </a>
        <div class="news-card-body">
          <div class="news-card-meta">
            <span class="news-source">${a.source_name || 'ZakonExpert'}</span>
            <time class="news-date">${dateStr}</time>
          </div>
          <h2 class="news-card-title">
            <a href="/news/${a.slug}">${a.title}</a>
          </h2>
          <p class="news-card-excerpt">${(a.excerpt || '').substring(0, 160)}${(a.excerpt || '').length > 160 ? '…' : ''}</p>
          <div class="news-card-footer">
            <a href="/news/${a.slug}" class="news-read-more">Читать разбор →</a>
            <div class="news-card-tags">
              ${tags.slice(0,3).map(t => `<span class="legal-pill news-tag">${t}</span>`).join('')}
            </div>
          </div>
        </div>
      </article>`;
      }).join('')}
    </div>
    `}

    <!-- PAGINATION -->
    ${totalPages > 1 ? `
    <nav class="news-pagination" aria-label="Пагинация">
      ${currentPage > 1 ? `
      <a href="/news?page=${currentPage - 1}${currentCategory ? '&cat=' + currentCategory : ''}"
         class="news-page-btn">← Назад</a>` : ''}
      <span class="news-page-info">Страница ${currentPage} из ${totalPages}</span>
      ${currentPage < totalPages ? `
      <a href="/news?page=${currentPage + 1}${currentCategory ? '&cat=' + currentCategory : ''}"
         class="news-page-btn">Вперёд →</a>` : ''}
    </nav>
    ` : ''}

    <!-- CTA BLOCK -->
    <div class="news-cta-block">
      <div class="news-cta-inner">
        <div>
          <h3>Есть арест или ограничение?</h3>
          <p>Проверьте по ИИН — мы установим основание и объясним правовой путь.</p>
        </div>
        <div class="news-cta-actions">
          <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
          <a href="https://wa.me/77000300024?text=Здравствуйте.+Читал+новости.+Нужна+консультация."
             target="_blank" rel="noopener" class="btn-legal-outline">WhatsApp</a>
        </div>
      </div>
    </div>

  </div>
</section>
`;
%>
<%- include('layout', { title, description, canonical, ogType: 'website', ogImage: '/img/zakonexpert-logo-kazakhstan.png', schema, body }) %>
