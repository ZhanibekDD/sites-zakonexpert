<%
function escapeHtml(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function cleanDisplayText(value) {
  return String(value || '').replace(/[\u00a0\u2007\u202f]/g, ' ').replace(/\s+/g, ' ').trim();
}
function relatedTitle(item) {
  return cleanDisplayText(item.original_title || item.title || 'Материал ZakonExpert');
}
let tagsArr = [];
try { tagsArr = JSON.parse(article.tags || '[]').filter(t => typeof t === 'string'); } catch (_) {}
const displayTitle = cleanDisplayText(article.display_title || article.original_title || article.title);
const displayExcerpt = cleanDisplayText(article.display_excerpt || article.excerpt || article.original_excerpt);
const pubDateRaw = article.published_at_source || article.published_at_site;
const pubDate   = pubDateRaw ? new Date(pubDateRaw) : new Date();
const pubDateStr = pubDate.toLocaleDateString('ru-RU', { day:'numeric', month:'long', year:'numeric' });
const isAdvokat  = article.category === 'Адвокат';
const localOgImage = String(article.og_image || '').startsWith('/img/') ? article.og_image : '';
const coverImg  = article.display_cover || (isAdvokat ? localOgImage : '') || article.category_cover || '/img/news/news-cover-default.svg';
const fallbackCover = article.fallback_cover || '/img/news/news-cover-fallback-v2.svg';

// Imported text is external data. Escape it first, then support only a tiny,
// controlled subset of markdown generated by our own analysis templates.
function inlineFormat(value) {
  return escapeHtml(value).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
function renderRichText(value) {
  return String(value || '').trim().split(/\n\n+/).map(block => {
    const lines = block.split(/\n+/).map(line => line.trim()).filter(Boolean);
    const bullets = lines.filter(line => /^(?:—|-|•)\s+/.test(line));
    if (bullets.length) {
      const headingLines = lines.filter(line => !/^(?:—|-|•)\s+/.test(line));
      return `${headingLines.map(line => `<p>${inlineFormat(line)}</p>`).join('')}<ul>${bullets.map(line => `<li>${inlineFormat(line.replace(/^(?:—|-|•)\s+/, ''))}</li>`).join('')}</ul>`;
    }
    return lines.map(line => `<p>${inlineFormat(line)}</p>`).join('');
  }).join('');
}
function parseChecklist(value) {
  if (Array.isArray(value)) return value.filter(Boolean);
  try {
    const parsed = JSON.parse(value || '[]');
    if (Array.isArray(parsed)) return parsed.filter(Boolean);
  } catch (_) {}
  return String(value || '').split(/\n+/).map(item => item.replace(/^(?:—|-|•)\s+/, '').trim()).filter(Boolean);
}

const rawContent = (article.event_summary || article.original_excerpt || displayExcerpt).trim();
const hasHtml = isAdvokat && /<p\b|<br\b|<blockquote\b|<ul\b|<ol\b/i.test(rawContent);
let renderedSummary;
if (hasHtml) {
  renderedSummary = rawContent;
} else {
  renderedSummary = renderRichText(rawContent);
}
const checklist = parseChecklist(article.what_to_check);
const sourceUrl = /^https?:\/\//i.test(article.source_url || article.original_url || '')
  ? (article.source_url || article.original_url)
  : '';

