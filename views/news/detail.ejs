<%
const tagsArr   = JSON.parse(article.tags || '[]');
const pubDate   = article.published_at_site ? new Date(article.published_at_site) : new Date();
const pubDateStr = pubDate.toLocaleDateString('ru-RU', { day:'numeric', month:'long', year:'numeric' });
const coverImg  = article.og_image || article.category_cover || '/img/news/news-cover-default.svg';
const sourceLink = article.source_url || article.original_url || '#';

// Just the actual news text — first paragraph of event_summary (before our generated marketing line)
const rawContent = (article.event_summary || article.original_excerpt || '').trim();
const paragraphs = rawContent.split(/\n\n+/).map(p => p.trim()).filter(p =>
  p.length > 0 &&
  !p.startsWith('Эта новость представляет') &&
  !p.startsWith('Ниже — юридический')
);

const body = `
<!-- BREADCRUMB -->
<section class="news-detail-hero">
  <div class="landing-container">
    <nav aria-label="breadcrumb" class="news-breadcrumb">
      <a href="/">Главная</a> /
      <a href="/news">Новости</a> /
      <span>${article.title.substring(0,55)}${article.title.length > 55 ? '…' : ''}</span>
    </nav>
  </div>
</section>

<!-- ARTICLE -->
<section class="news-detail-section">
  <div class="landing-container">
    <div class="news-detail-layout">

      <!-- MAIN -->
      <article class="news-detail-main" itemscope itemtype="https://schema.org/NewsArticle">

        <!-- COVER -->
        <div class="news-detail-cover">
          <img src="${coverImg}" alt="${article.title}" loading="eager" itemprop="image"
               onerror="this.src='/img/news/news-cover-default.svg'">
        </div>

        <!-- META -->
        <div class="news-detail-meta">
          <span class="news-source-badge">${article.source_name || 'Источник'}</span>
          <time class="news-date" datetime="${pubDate.toISOString()}" itemprop="datePublished">${pubDateStr}</time>
          ${tagsArr.slice(0,4).map(t => `<span class="legal-pill news-tag">${t}</span>`).join('')}
        </div>

        <!-- H1 -->
        <h1 itemprop="headline">${article.title}</h1>

        <!-- CONTENT — actual parsed news text -->
        <div class="news-article-body" itemprop="articleBody">
          ${paragraphs.length > 0
            ? paragraphs.map(p => `<p>${p}</p>`).join('\n          ')
            : `<p>${article.excerpt || ''}</p>`
          }
        </div>

        <!-- SHARE -->
        <div class="news-share">
          <span>Поделиться:</span>
          <a href="https://wa.me/?text=${encodeURIComponent(article.title + ' — https://zakonexpertt.kz/news/' + article.slug)}"
             target="_blank" rel="noopener" class="news-share-btn news-share-wa">WhatsApp</a>
          <a href="https://t.me/share/url?url=${encodeURIComponent('https://zakonexpertt.kz/news/' + article.slug)}&text=${encodeURIComponent(article.title)}"
             target="_blank" rel="noopener" class="news-share-btn news-share-tg">Telegram</a>
          <button class="news-share-btn news-share-copy"
                  onclick="navigator.clipboard.writeText(window.location.href);this.textContent='Скопировано!'">
            Копировать ссылку
          </button>
        </div>

      </article>

      <!-- SIDEBAR -->
      <aside class="news-sidebar">

        <div class="news-sidebar-widget">
          <h3>Проверить по ИИН</h3>
          <p>Узнайте об исполнительных производствах и ограничениях бесплатно.</p>
          <a href="/#checker-section" class="btn-legal-cta" style="width:100%;text-align:center;display:block;">Проверить сейчас</a>
        </div>

        ${related && related.length > 0 ? `
        <div class="news-sidebar-widget">
          <h3>Похожие материалы</h3>
          ${related.map(r => `
          <a href="/news/${r.slug}" class="news-related-item">
            ${r.title.substring(0, 80)}${r.title.length > 80 ? '…' : ''}
          </a>`).join('')}
        </div>
        ` : ''}

        <div class="news-sidebar-widget">
          <h3>Связаться с нами</h3>
          <a href="https://wa.me/77000300024?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5.+%D0%9D%D1%83%D0%B6%D0%BD%D0%B0+%D0%BA%D0%BE%D0%BD%D1%81%D1%83%D0%BB%D1%8C%D1%82%D0%B0%D1%86%D0%B8%D1%8F." target="_blank" rel="noopener" class="news-sidebar-wa">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M5.077 19.956c-2.434-1.279-4.177-3.463-4.777-5.952-.3-2.49.527-5.099 2.261-6.994C4.295 5.115 6.455 4.083 9.024 4.083c2.569 0 5.028 1.032 6.762 2.927 1.734 1.895 2.562 4.504 2.261 7.007-.301 2.503-1.734 4.828-3.826 6.277l.298 1.491-1.638-.428c-1.239.619-2.619.962-4.048.962-1.087 0-2.14-.2-3.131-.58l-2.025.527.527-2.025-.148.245z"/></svg>
            Написать в WhatsApp
          </a>
          <a href="tel:+77000300024" class="news-sidebar-phone">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.87 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.77 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            +7 (700) 030-00-24
          </a>
        </div>

        <div class="news-sidebar-widget">
          <h3>Темы</h3>
          <div class="news-sidebar-tags">
            <a href="/news?cat=аресты">Аресты счетов</a>
            <a href="/news?cat=finance">Банки</a>
            <a href="/news?cat=chsi">ЧСИ</a>
            <a href="/news?cat=notarius">Исп. надпись</a>
            <a href="/news?cat=alimenty">Алименты</a>
            <a href="/news?cat=shtrafy">Штрафы</a>
            <a href="/news?cat=avto">Авто</a>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>
`;
%>
<%- include('layout', { title: article.meta_title || article.title + ' | ZakonExpert', description: article.meta_desc || article.excerpt || '', canonical: 'https://zakonexpertt.kz/news/' + article.slug, ogType: 'article', ogImage: article.og_image || article.category_cover || '/img/zakonexpert-logo-kazakhstan.png', schema, activeNav: 'news', body }) %>
