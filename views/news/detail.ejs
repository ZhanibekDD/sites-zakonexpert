<%
function escapeHtml(value) {
  return String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function cleanDisplayText(value) {
  return String(value || '').replace(/[\u00a0\u2007\u202f]/g, ' ').replace(/\s+/g, ' ').trim();
}
function relatedTitle(item) {
  return cleanDisplayText(item.original_title || item.title || 'Материал ZakonExpert');
}
let tagsArr = [];
try { tagsArr = JSON.parse(article.tags || '[]').filter(t => typeof t === 'string'); } catch (_) {}
const displayTitle = cleanDisplayText(article.display_title || article.original_title || article.title);
const displayExcerpt = cleanDisplayText(article.display_excerpt || article.excerpt || article.original_excerpt);
const pubDateRaw = article.published_at_source || article.published_at_site;
const pubDate = pubDateRaw ? new Date(pubDateRaw) : new Date();
const pubDateStr = pubDate.toLocaleDateString('ru-RU', { day:'numeric', month:'long', year:'numeric' });
const localOgImage = String(article.og_image || '').startsWith('/img/') ? article.og_image : '';
const coverImg = article.display_cover || localOgImage || article.category_cover || '/img/news/news-cover-default.svg';
const fallbackCover = article.fallback_cover || '/img/news/news-cover-fallback-v2.svg';

// Imported article text is external data. Always escape it before rendering.
// This intentionally has no special "advocate" path that can inject stored HTML.
function inlineFormat(value) {
  return escapeHtml(value).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}
function renderRichText(value) {
  return String(value || '').trim().split(/\n\n+/).map(block => {
    const lines = block.split(/\n+/).map(line => line.trim()).filter(Boolean);
    const bullets = lines.filter(line => /^(?:—|-|•)\s+/.test(line));
    if (bullets.length) {
      const headingLines = lines.filter(line => !/^(?:—|-|•)\s+/.test(line));
      return `${headingLines.map(line => `<p>${inlineFormat(line)}</p>`).join('')}<ul>${bullets.map(line => `<li>${inlineFormat(line.replace(/^(?:—|-|•)\s+/, ''))}</li>`).join('')}</ul>`;
    }
    return lines.map(line => `<p>${inlineFormat(line)}</p>`).join('');
  }).join('');
}
function parseChecklist(value) {
  if (Array.isArray(value)) return value.filter(Boolean);
  try {
    const parsed = JSON.parse(value || '[]');
    if (Array.isArray(parsed)) return parsed.filter(Boolean);
  } catch (_) {}
  return String(value || '').split(/\n+/).map(item => item.replace(/^(?:—|-|•)\s+/, '').trim()).filter(Boolean);
}

const rawContent = (article.event_summary || article.original_excerpt || displayExcerpt).trim();
const renderedSummary = renderRichText(rawContent);
const checklist = parseChecklist(article.what_to_check);
const sourceUrl = /^https?:\/\//i.test(article.source_url || article.original_url || '')
  ? (article.source_url || article.original_url)
  : '';
const waZakonUrl = `https://wa.me/77058762795?text=${encodeURIComponent('Здравствуйте. Нужна консультация. Пишу с сайта ZakonExpert.')}`;

const body = `
<!-- BREADCRUMB -->
<section class="news-detail-hero">
  <div class="landing-container">
    <nav aria-label="breadcrumb" class="news-breadcrumb">
      <a href="/">Главная</a> /
      <a href="/news">Новости</a> /
      <span>${escapeHtml(displayTitle.substring(0,55))}${displayTitle.length > 55 ? '…' : ''}</span>
    </nav>
  </div>
</section>

<!-- ARTICLE -->
<section class="news-detail-section">
  <div class="landing-container">
    <div class="news-detail-layout">

      <!-- MAIN -->
      <article class="news-detail-main" itemscope itemtype="https://schema.org/NewsArticle">

        <!-- COVER -->
        <div class="news-detail-cover">
          <img src="${escapeHtml(coverImg)}" alt="${escapeHtml(displayTitle)}" loading="eager" itemprop="image" referrerpolicy="no-referrer"
               onerror="this.onerror=null;this.src='${escapeHtml(fallbackCover)}'">
        </div>

        <!-- META -->
        <div class="news-detail-meta">
          <span class="news-source-badge">${escapeHtml(article.source_name || 'Источник')}</span>
          <time class="news-date" datetime="${pubDate.toISOString()}" itemprop="datePublished">${pubDateStr}</time>
          ${tagsArr.slice(0,4).map(t => `<span class="legal-pill news-tag">${escapeHtml(t)}</span>`).join('')}
        </div>

        <!-- H1 -->
        <h1 itemprop="headline">${escapeHtml(displayTitle)}</h1>

        ${displayExcerpt ? `<p class="news-detail-lead">${escapeHtml(displayExcerpt)}</p>` : ''}

        <!-- FULL ARTICLE -->
        <div class="news-article-body" itemprop="articleBody">
          <section class="news-section-block news-section-block--main">
            <h2>Что произошло</h2>
            ${renderedSummary}
          </section>

          ${article.why_important ? `
          <section class="news-section-block">
            <h2>Почему это важно</h2>
            ${renderRichText(article.why_important)}
          </section>` : ''}

          ${article.legal_commentary ? `
          <section class="news-section-block news-commentary">
            <div class="news-commentary-header">
              <span class="news-commentary-mark" aria-hidden="true">ZE</span>
              <h2>Юридический разбор ZakonExpert</h2>
            </div>
            ${renderRichText(article.legal_commentary)}
          </section>` : ''}

          ${checklist.length ? `
          <section class="news-section-block news-check-panel">
            <h2>Что проверить прямо сейчас</h2>
            <ul class="news-checklist">
              ${checklist.map(item => `<li><span aria-hidden="true">✓</span><span>${inlineFormat(item)}</span></li>`).join('')}
            </ul>
          </section>` : ''}

          ${article.when_to_seek_help ? `
          <section class="news-when-help">
            <h2>Когда нужна помощь специалиста</h2>
            ${renderRichText(article.when_to_seek_help)}
            <div class="news-when-help-actions">
              <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
              <a href="${waZakonUrl}" target="_blank" rel="noopener" class="btn-legal-outline">Написать в WhatsApp</a>
            </div>
          </section>` : ''}
        </div>

        ${sourceUrl ? `
        <div class="news-source-box">
          <div>
            <strong>Первоисточник</strong>
            <span>Факты события взяты из публикации «${escapeHtml(article.source_name || 'Источник')}».</span>
          </div>
          <a href="${escapeHtml(sourceUrl)}" target="_blank" rel="nofollow noopener noreferrer">Открыть источник ↗</a>
        </div>` : ''}

        <p class="news-editorial-note">Материал содержит редакционный юридический разбор ZakonExpert и не заменяет индивидуальную консультацию. Проверяйте применимость норм к вашей ситуации.</p>

        <!-- SHARE -->
        <div class="news-share">
          <span>Поделиться:</span>
          <a href="https://wa.me/?text=${encodeURIComponent(displayTitle + ' — https://zakonexpert.kz/news/' + article.slug)}"
             target="_blank" rel="noopener" class="news-share-btn news-share-wa">WhatsApp</a>
          <a href="https://t.me/share/url?url=${encodeURIComponent('https://zakonexpert.kz/news/' + article.slug)}&text=${encodeURIComponent(displayTitle)}"
             target="_blank" rel="noopener" class="news-share-btn news-share-tg">Telegram</a>
          <button class="news-share-btn news-share-copy"
                  onclick="navigator.clipboard.writeText(window.location.href);this.textContent='Скопировано!'">
            Копировать ссылку
          </button>
        </div>

      </article>

      <!-- SIDEBAR -->
      <aside class="news-sidebar">
        <div class="news-sidebar-widget">
          <h3>Проверить по ИИН</h3>
          <p>Узнайте об исполнительных производствах и ограничениях бесплатно.</p>
          <a href="/#checker-section" class="btn-legal-cta" style="width:100%;text-align:center;display:block;">Проверить сейчас</a>
        </div>

        ${related && related.length > 0 ? `
        <div class="news-sidebar-widget">
          <h3>Похожие материалы</h3>
          ${related.map(r => `
          <a href="/news/${r.slug}" class="news-related-item">
            ${escapeHtml(relatedTitle(r).substring(0, 80))}${relatedTitle(r).length > 80 ? '…' : ''}
          </a>`).join('')}
        </div>
        ` : ''}

        <div class="news-sidebar-widget">
          <h3>Темы</h3>
          <div class="news-sidebar-tags">
            <a href="/news?cat=аресты">Аресты счетов</a>
            <a href="/news?cat=finance">Банки</a>
            <a href="/news?cat=chsi">ЧСИ</a>
            <a href="/news?cat=notarius">Исп. надпись</a>
            <a href="/news?cat=alimenty">Алименты</a>
            <a href="/news?cat=shtrafy">Штрафы</a>
            <a href="/news?cat=avto">Авто</a>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>
`;
%>
<%- include('layout', { title: displayTitle.substring(0, 62) + ' | ZakonExpert', description: (article.meta_desc || displayExcerpt).substring(0, 160), canonical: 'https://zakonexpert.kz/news/' + article.slug, ogType: 'article', ogImage: coverImg, schema, activeNav: 'news', body }) %>
