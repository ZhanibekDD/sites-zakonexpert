// Render article body: if content has HTML tags, use directly; otherwise split by \n\n
const rawContent = (article.event_summary || article.original_excerpt || '').trim();
const hasHtml = /<p\b|<br\b|<blockquote\b|<ul\b|<ol\b/i.test(rawContent);
let renderedBody;
if (hasHtml) {
  renderedBody = rawContent;
} else {
  const paragraphs = rawContent.split(/\n\n+/).map(p => p.trim()).filter(p =>
    p.length > 0 &&
    !p.startsWith('Эта новость представляет') &&
    !p.startsWith('Ниже — юридический')
  );
  renderedBody = paragraphs.length > 0
    ? paragraphs.map(p => `<p>${p}</p>`).join('\n          ')
    : `<p>${article.excerpt || ''}</p>`;
}

