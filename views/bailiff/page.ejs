<%
function titleCase(value) {
  return String(value || '').toLowerCase().split(' ').map(function(word) {
    return word ? word[0].toUpperCase() + word.slice(1) : '';
  }).join(' ');
}
function formatPhone(value) {
  var digits = String(value || '').replace(/\D/g, '');
  if (digits.length === 11 && digits[0] === '8') digits = '7' + digits.slice(1);
  if (digits.length === 10) digits = '7' + digits;
  return digits.length === 11 && digits[0] === '7'
    ? '+7 (' + digits.slice(1, 4) + ') ' + digits.slice(4, 7) + '-' + digits.slice(7, 9) + '-' + digits.slice(9, 11)
    : value;
}
var nameTitle = titleCase(bailiff.name);
var rawPhones = (bailiff.phones || []).map(function(value) { return String(value || '').trim(); }).filter(Boolean);
var phoneText = rawPhones.map(formatPhone).join(' · ');
var firstPhone = rawPhones.length ? rawPhones[0].replace(/\D/g, '') : '';
if (firstPhone.length === 11 && firstPhone[0] === '8') firstPhone = '7' + firstPhone.slice(1);
if (firstPhone.length === 10) firstPhone = '7' + firstPhone;
var verifiedDate = bailiff.updatedAt
  ? new Date(bailiff.updatedAt).toLocaleDateString('ru-RU', { timeZone: 'Asia/Almaty' })
  : '';
var pageTitle = 'ЧСИ ' + nameTitle + ' — контакты и лицензия | ZakonExpert';
var pageDesc = 'ЧСИ ' + nameTitle + ' (' + bailiff.region + '): телефон, адрес и номер лицензии. Помощь при аресте счёта и ограничениях.';
var canonical = 'https://zakonexpert.kz/bailiff/' + bailiff.slug;
var schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
      { '@type': 'ListItem', position: 2, name: 'Каталог ЧСИ', item: 'https://zakonexpert.kz/bailiffs' },
      { '@type': 'ListItem', position: 3, name: nameTitle, item: canonical },
    ] },
    { '@type': 'LegalService', name: 'ЧСИ ' + nameTitle, url: canonical,
      address: bailiff.address ? { '@type': 'PostalAddress', streetAddress: bailiff.address, addressRegion: bailiff.region, addressCountry: 'KZ' } : undefined,
      telephone: rawPhones[0] || undefined, email: bailiff.email || undefined },
  ],
};
var reviewsHtml = include('../partials/professional-reviews', {
  itemType: 'bailiff', slug: bailiff.slug, backUrl: '/bailiff/' + bailiff.slug,
  subjectLabel: 'этим ЧСИ', comments, commentStats, commentSent,
});
var detail = {
  name: nameTitle,
  subtitle: 'Частный судебный исполнитель · ' + bailiff.region,
  breadcrumbs: [{ href: '/bailiffs', label: 'Каталог ЧСИ' }, { label: nameTitle }],
  badges: [
    { icon: 'bi-person-badge', label: 'Частный судебный исполнитель' },
    { icon: 'bi-file-earmark-check', label: bailiff.license ? ('Лицензия № ' + bailiff.license) : 'Лицензия не указана', active: Boolean(bailiff.license) },
  ],
  rows: [
    { icon: 'bi-geo-alt', label: 'Адрес', value: bailiff.address },
    { icon: 'bi-telephone', label: 'Телефон ЧСИ', value: phoneText || 'Не указан в сводном реестре', href: firstPhone ? 'tel:+' + firstPhone : '' },
    { icon: 'bi-envelope', label: 'Email', value: bailiff.email || 'Не указан в сводном реестре', href: bailiff.email ? 'mailto:' + bailiff.email : '' },
    { icon: 'bi-file-earmark-check', label: 'Лицензия', value: bailiff.license ? ('№ ' + bailiff.license + (bailiff.licenseDate ? ' от ' + bailiff.licenseDate : '')) : 'Не указана в сводном реестре' },
    { icon: 'bi-database-check', label: 'Официальная проверка', value: 'АИС органов исполнительного производства' + (verifiedDate ? ' · база ZakonExpert обновлена ' + verifiedDate : ''), href: 'https://aisoip.adilet.gov.kz/', external: true },
  ],
  address: bailiff.address,
  help: {
    icon: 'bi-shield-check',
    title: 'Этот ЧСИ наложил ограничение?',
    text: 'Проверим исполнительное производство, сумму взыскания и законность ареста счёта, авто или запрета на выезд.',
    items: ['Найдём производство и постановления', 'Проверим сумму и основания взыскания', 'Подготовим документы для снятия ограничений'],
    whatsappText: 'Здравствуйте! ЧСИ ' + nameTitle + ' наложил ограничение, нужна консультация.',
  },
  diagnostic: {
    source: 'bailiff',
    entry: 'bailiff_profile',
    entityType: 'bailiff',
    title: 'Сначала пройти диагностику',
    note: '2 вопроса · основание «ЧСИ» уже учтено',
  },
  analyticsEvent: 'click_cta_bailiff',
  analyticsEntityType: 'bailiff',
  warning: {
    title: 'Важно знать',
    text: 'Номер лицензии подтверждает право на деятельность ЧСИ, но перед обращением рекомендуем проверить текущий статус исполнителя в государственной АИС ОИП.',
  },
  stepsTitle: 'Что делать, если ЧСИ наложил арест',
  steps: [
    { icon: 'bi-search', title: 'Найдите производство', text: 'Уточните номер производства, сумму и основание взыскания.' },
    { icon: 'bi-file-earmark-text', title: 'Получите постановление', text: 'Запросите документы об аресте и расчёт расходов ЧСИ.' },
    { icon: 'bi-shield-check', title: 'Снимите ограничение', text: 'Оспорьте основание либо согласуйте законный порядок исполнения.' },
  ],
  moreHtml: reviewsHtml,
  backUrl: '/bailiffs',
  backLabel: 'Все ЧСИ Казахстана',
};
var body = '<link rel="stylesheet" href="/css/registry-item.css?v=20260824-1">'
  + include('../partials/registry-item-body', { detail });
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
