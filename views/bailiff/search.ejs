const canonical = 'https://zakonexpertt.kz/bailiff-search';

function titleCase(s) {
  return s.toLowerCase().split(' ').map(function(w){ return w ? w[0].toUpperCase() + w.slice(1) : ''; }).join(' ');
}

let resultsHtml = '';
if (results !== null) {
  if (results.length === 0) {
    resultsHtml = '<div class="registry-empty"><p>По запросу <strong>' + q + '</strong> ничего не найдено.</p>'
      + '<p style="font-size:0.9rem;color:#64748b;">Попробуйте ввести только фамилию, например: <em>Иванов</em></p></div>';
  } else {
    var countNote = results.length === 30 ? '+ (показаны первые 30)' : '';
    var items = '';
    for (var i = 0; i < results.length; i++) {
      var b = results[i];
      var name = titleCase(b.name);
      items += '<li class="registry-item"><a href="/bailiff/' + b.slug + '" class="registry-item-link">'
        + '<span class="registry-item-name">' + name + '</span>'
        + '<span class="registry-item-region">' + (b.region || '') + '</span>'
        + '</a></li>';
    }
    resultsHtml = '<p class="registry-count">Найдено: <strong>' + results.length + '</strong>' + countNote + '</p>'
      + '<ul class="registry-list">' + items + '</ul>';
  }
}

const body = '<div class="npage-wrap"><div class="landing-container">'
