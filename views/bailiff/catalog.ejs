<%
const region   = (selectedRegion || '').trim();
const regions  = allRegions  || [];
const bailiffs = regionItems || [];

const pageTitle = region
  ? ('Судебные исполнители ЧСИ — ' + region + ' | ZakonExpert')
  : 'Частные судебные исполнители (ЧСИ) Казахстана по регионам | ZakonExpert';
const pageDesc = region
  ? ('Список частных судебных исполнителей (ЧСИ) региона ' + region + '. Реестр ZakonExpert.')
  : 'Полный реестр частных судебных исполнителей (ЧСИ) Казахстана по регионам. 2079 ЧСИ с адресами.';
const canonical = region
  ? ('https://zakonexpertt.kz/bailiffs?region=' + encodeURIComponent(region))
  : 'https://zakonexpertt.kz/bailiffs';

function titleCase(s) {
  return (s || '').toLowerCase().split(' ').map(function(w){ return w ? w[0].toUpperCase() + w.slice(1) : ''; }).join(' ');
}

var breadcrumb = '<nav class="npage-breadcrumb" aria-label="breadcrumb">'
  + '<a href="/">Главная</a><span class="npage-bc-sep">/</span>'
  + (region
    ? '<a href="/bailiffs">Судебные исполнители</a><span class="npage-bc-sep">/</span><span>' + region + '</span>'
    : '<span>Судебные исполнители</span>')
  + '</nav>';

var heroHtml = '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge npage-badge--chsi">Реестр ЧСИ Казахстана</span></div>'
  + '<h1 class="npage-h1">'
  + (region ? 'ЧСИ — ' + region : 'Частные судебные исполнители Казахстана')
  + '</h1>'
  + '<p style="color:#475569;margin-top:0.5rem;">'
  + (region ? 'Найдено ЧСИ в регионе: <strong>' + bailiffs.length + '</strong>' : 'База данных 2079 ЧСИ по всем регионам Казахстана')
  + '</p></div>';

var contentHtml = '';

if (region) {
  if (bailiffs.length === 0) {
    contentHtml = '<div class="registry-empty"><p>Судебные исполнители в регионе <strong>' + region + '</strong> не найдены.</p></div>';
  } else {
    var items = '';
    for (var i = 0; i < bailiffs.length; i++) {
      var b = bailiffs[i];
      var name = titleCase(b.name);
      items += '<li class="registry-item"><a href="/bailiff/' + b.slug + '" class="registry-item-link">'
        + '<span class="registry-item-name">' + name + '</span>'
        + (b.phones ? '<span class="registry-item-region">' + b.phones + '</span>' : '')
        + '</a></li>';
    }
    contentHtml = '<ul class="registry-list">' + items + '</ul>';
  }
} else {
  var regionCards = '';
  for (var j = 0; j < regions.length; j++) {
    var r = regions[j];
    regionCards += '<a href="/bailiffs?region=' + encodeURIComponent(r.region) + '" class="catalog-region-card catalog-region-card--chsi">'
      + '<span class="catalog-region-name">' + r.region + '</span>'
      + '<span class="catalog-region-count">' + r.count + ' ЧСИ</span>'
      + '</a>';
  }
  contentHtml = '<div class="catalog-region-grid">' + regionCards + '</div>';
}

var ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p><h2 class="npage-cta-title">ЧСИ арестовал ваши счета?</h2>'
  + '<p class="npage-cta-sub">Поможем снять арест, оспорить действия исполнителя и добиться рассрочки.</p></div>'
  + '<a href="https://wa.me/77000300024?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5!+%D0%A7%D0%A1%D0%98+%D0%B0%D1%80%D0%B5%D1%81%D1%82%D0%BE%D0%B2%D0%B0%D0%BB+%D1%81%D1%87%D0%B5%D1%82%D0%B0%2C+%D0%BF%D1%80%D0%BE%D1%88%D1%83+%D0%BF%D0%BE%D0%BC%D0%BE%D1%87%D1%8C." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' Написать в WhatsApp</a></div>';

const body = '<div class="npage-wrap"><div class="landing-container">'
  + breadcrumb
  + heroHtml
  + '<div class="registry-results">' + contentHtml + '</div>'
  + ctaHtml
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema: null, noindex: false, body }) %>
