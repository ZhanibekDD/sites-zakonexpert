<%
const CATALOG = (typeof catalog !== 'undefined' && catalog) ? catalog : {
  query: '', page: 1, total: items.length, filteredTotal: items.length, totalPages: 1,
};
const QUERY = CATALOG.query || '';
const PAGE = CATALOG.page || 1;
const TOTAL = CATALOG.total || items.length;
const pageTitle = 'Ломбарды Казахстана — реестр ' + TOTAL + ' организаций' + (PAGE > 1 ? ', страница ' + PAGE : '') + ' | ZakonExpert';
const pageDesc  = 'Ломбард требует долг или грозит арестом? Проверим требования бесплатно. Реестр ' + TOTAL + ' лицензированных ломбардов РК.';
const canonical = 'https://zakonexpert.kz/lombards' + (!QUERY && PAGE > 1 ? '?page=' + PAGE : '');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpert.kz/' },
    { '@type': 'ListItem', position: 2, name: 'Ломбарды Казахстана', item: canonical },
  ],
};

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function pageHref(page) {
  const params = [];
  if (QUERY) params.push('q=' + encodeURIComponent(QUERY));
  if (page > 1) params.push('page=' + page);
  return '/lombards' + (params.length ? '?' + params.join('&') : '');
}

var paginationHtml = '';
if (CATALOG.totalPages > 1) {
  paginationHtml = '<nav class="cat-pagination" aria-label="Страницы каталога">'
    + (PAGE > 1 ? '<a href="' + pageHref(PAGE - 1) + '">← Назад</a>' : '<span class="disabled">← Назад</span>');
  for (var p = 1; p <= CATALOG.totalPages; p++) {
    if (p === 1 || p === CATALOG.totalPages || Math.abs(p - PAGE) <= 2) {
      paginationHtml += p === PAGE ? '<span class="current" aria-current="page">' + p + '</span>' : '<a href="' + pageHref(p) + '">' + p + '</a>';
    } else if (p === 2 || p === CATALOG.totalPages - 1) paginationHtml += '<span class="ellipsis">…</span>';
  }
  paginationHtml += PAGE < CATALOG.totalPages ? '<a href="' + pageHref(PAGE + 1) + '">Вперёд →</a></nav>' : '<span class="disabled">Вперёд →</span></nav>';
}

const searchHtml = '<form class="cat-search" method="get" action="/lombards">'
  + '<label class="visually-hidden" for="cc-search">Поиск ломбарда</label>'
  + '<input id="cc-search" name="q" type="search" value="' + escHtml(QUERY) + '" placeholder="Название, город или БИН" autocomplete="off">'
  + '<button type="submit">Найти</button>'
  + (QUERY ? '<a href="/lombards">Сбросить</a>' : '')
  + '</form><div id="cc-count">' + (QUERY ? 'Найдено: ' + CATALOG.filteredTotal + ' из ' + TOTAL : 'Всего в реестре: ' + TOTAL + ' ломбардов') + '</div>';

var cards = '';
for (var i = 0; i < items.length; i++) {
  var lb = items[i];
  var cleanName = lb.name || lb.nameFull.replace(/^ТОО\s+"*|"*$/g,'').replace(/ЛОМБАРД\s+/gi,'Ломбард ').trim();
  var addr = (lb.address || '').replace(/^[А-ЯЁA-Z]+\s+ОБЛАСТЬ,\s*/,'').replace(/^Г\./,'г.').replace(/^Г\s+/i,'г. ').trim();

  var addrHtml = addr
    ? '<div class="cc-row"><span class="cc-icon">📍</span><span class="cc-text">' + escHtml(addr.substring(0,120)) + '</span></div>'
    : '';
  var binHtml = '<div class="cc-row"><span class="cc-icon">🆔</span><span class="cc-dim">БИН: ' + escHtml(lb.bin) + '</span></div>';
  var leadHtml = lb.leader
    ? '<div class="cc-row"><span class="cc-icon">👤</span><span class="cc-dim">' + escHtml(lb.leader) + '</span></div>'
    : '';

  cards += '<div class="cc-card" data-search="' + escHtml((cleanName + ' ' + addr + ' ' + lb.leader).toLowerCase()) + '">'
    + '<div class="cc-name">' + (lb.slug ? '<a href="/lombards/' + lb.slug + '" style="color:inherit;text-decoration:none;">' + escHtml(cleanName) + '</a>' : escHtml(cleanName)) + '</div>'
    + '<div class="cc-contacts">'
    + addrHtml + leadHtml + binHtml
    + '</div>'
    + '</div>';
}

const infoBox = '<div style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:12px;padding:18px 20px;margin-top:1.5rem;font-size:.9rem;color:#92400e;line-height:1.6;">'
  + '<strong>⚠️ Важно знать:</strong> Ломбард вправе реализовать залог только через суд или нотариальную надпись после нарушения условий договора. '
  + 'Если ломбард арестовал счёт или угрожает — это незаконно. '
  + '<a href="https://wa.me/77003097566" style="color:#1a56db;font-weight:600;">Обращайтесь в ZakonExpert →</a>'
  + '</div>';

const ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p><h2 class="npage-cta-title">Проблема с ломбардом?</h2>'
  + '<p class="npage-cta-sub">Поможем оспорить незаконную реализацию залога, снять арест со счёта и защитить права должника. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Защита залога</span><span>Снятие ареста</span><span>Оспаривание</span><span>Все регионы</span></div></div>'
  + '<a href="https://wa.me/77003097566?text=Здравствуйте!+Проблема+с+ломбардом,+нужна+помощь." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 700 309-75-66</span></span></a></div>';

const sourceHtml = '<div style="margin-top:2rem;padding:16px 20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;display:flex;align-items:flex-start;gap:12px;">'
  + '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
  + '<div style="font-size:.82rem;color:#64748b;line-height:1.6;">'
  + '<strong style="color:#374151;">Источник данных:</strong> Реестр ломбардов Агентства по регулированию и развитию финансового рынка РК (<a href="https://www.afsa.kz" target="_blank" rel="noopener" style="color:#1a56db;">afsa.kz</a>). '
  + 'Контактные данные ломбардов уточняйте напрямую или на сайте АРРФР.'
  + '</div></div>';

const CSS = '<style>'
  + '.cat-search{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:1.2rem 0 .6rem;}.cat-search input{flex:1;min-width:240px;padding:12px 16px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:.95rem;outline:none;box-sizing:border-box;}.cat-search input:focus{border-color:#1a56db;}.cat-search button{border:0;border-radius:10px;background:#1a56db;color:#fff;padding:12px 22px;font-weight:700;cursor:pointer;}.cat-search a{color:#1a56db;text-decoration:none;padding:10px;}'
  + '#cc-count{font-size:.82rem;color:#64748b;margin-bottom:.8rem;}'
  + '.cc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;}'
  + '.cc-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:10px;padding:12px 14px;transition:box-shadow .12s,border-color .12s;}'
  + '.cc-card:hover{box-shadow:0 3px 14px rgba(13,31,60,.09);border-color:#cbd5e1;}'
  + '.cc-name{font-weight:700;font-size:.86rem;color:#0d1f3c;margin-bottom:6px;line-height:1.35;}'
  + '.cc-contacts{display:flex;flex-direction:column;gap:3px;}'
  + '.cc-row{display:flex;align-items:flex-start;gap:6px;font-size:.76rem;line-height:1.45;}'
  + '.cc-icon{flex-shrink:0;font-size:.8rem;line-height:1.5;}'
  + '.cc-text{color:#374151;}'
  + '.cc-dim{color:#94a3b8;font-size:.72rem;}'
  + '.cc-link{color:#1a56db;text-decoration:none;}'
  + '.cc-link:hover{text-decoration:underline;}'
  + '.cat-pagination{display:flex;justify-content:center;align-items:center;gap:6px;flex-wrap:wrap;margin:1.4rem 0;}.cat-pagination a,.cat-pagination span{min-width:38px;padding:9px 10px;border:1px solid #dbe3ee;border-radius:9px;text-align:center;text-decoration:none;color:#1a56db;background:#fff;font-size:.85rem;}.cat-pagination .current{background:#0d2d59;color:#fff;border-color:#0d2d59;font-weight:700;}.cat-pagination .disabled,.cat-pagination .ellipsis{color:#94a3b8;background:#f8fafc;}'
  + '@media(max-width:600px){.cc-grid{grid-template-columns:1fr;}.cat-search button{flex:1}.cat-pagination a,.cat-pagination span{min-width:34px;padding:8px;}}'
  + '</style>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><span>Ломбарды</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">💎 Реестр АРРФР</span></div>'
  + '<h1 class="npage-h1">Ломбарды Казахстана</h1>'
  + '<p style="color:#475569;margin-top:0.5rem;">Государственный реестр лицензированных ломбардов РК — <strong>' + TOTAL + ' организаций</strong></p>'
  + '<p style="color:#475569;font-size:.92rem;margin-top:.6rem;max-width:720px;">Ломбард вправе реализовать залог только через нотариуса или суд — самостоятельно арестовать счёт или имущество он не может. Если это происходит или сумма долга кажется завышенной — ZakonExpert бесплатно разберёт ситуацию.</p></div>'
  + infoBox
  + searchHtml
  + (items.length ? '<div class="cc-grid">' + cards + '</div>' : '<p style="padding:2rem 0;color:#64748b;">По вашему запросу ломбарды не найдены.</p>')
  + paginationHtml
  + ctaHtml
  + lowContentBoost({ entityLabel: 'ломбард' })
  + sourceHtml
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: Boolean(QUERY), body }) %>
