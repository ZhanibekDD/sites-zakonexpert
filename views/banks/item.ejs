<%
const pageTitle = bank.shortName + ' — контакты, адрес, БИН | ZakonExpert';
const pageDesc  = bank.shortName + ': БИН ' + bank.bin + ', адрес ' + bank.city + '. Арестовали счёт или карту? Проверим ЧСИ и основание ареста бесплатно.';
const canonical = 'https://zakonexpertt.kz/banks/' + bank.slug;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
        { '@type': 'ListItem', position: 2, name: 'Банки Казахстана', item: 'https://zakonexpertt.kz/banks' },
        { '@type': 'ListItem', position: 3, name: bank.shortName, item: canonical },
      ],
    },
    {
      '@type': 'BankOrCreditUnion',
      name: bank.name,
      alternateName: bank.shortName,
      identifier: bank.bin,
      address: { '@type': 'PostalAddress', streetAddress: bank.address, addressLocality: bank.city, addressCountry: 'KZ' },
      telephone: bank.phoneRaw || undefined,
      email: bank.email || undefined,
      url: bank.web ? 'https://' + bank.web : undefined,
    },
  ],
};

function mapBlock(addr) {
  if (!addr) return '';
  var q = encodeURIComponent(addr + ', Казахстан');
  var q2 = encodeURIComponent(addr);
  return '<div style="margin-top:1.5rem;max-width:720px;">'
    + '<iframe src="https://maps.google.com/maps?q=' + q + '&output=embed&hl=ru&z=15" width="100%" height="280" style="border:0;border-radius:12px;display:block;" loading="lazy" allowfullscreen></iframe>'
    + '<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">'
    + '<a href="https://2gis.kz/search/' + q2 + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;font-size:.82rem;color:#1a56db;text-decoration:none;padding:6px 14px;border:1.5px solid #bfdbfe;border-radius:8px;background:#eff6ff;font-weight:500;">🗺 Открыть в 2ГИС</a>'
    + '<a href="https://maps.google.com/?q=' + q + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;font-size:.82rem;color:#374151;text-decoration:none;padding:6px 14px;border:1.5px solid #e2e8f0;border-radius:8px;background:#fff;font-weight:500;">📌 Google Maps</a>'
    + '</div></div>';
}

function tagColor(tag) {
  if (tag === 'Государственный')   return 'background:#dcfce7;color:#166534;';
  if (tag === 'Иностранный')       return 'background:#e0f2fe;color:#0369a1;';
  if (tag === 'Исламский')         return 'background:#fef9c3;color:#854d0e;';
  if (tag === 'Банк развития')     return 'background:#f3e8ff;color:#6b21a8;';
  if (tag === 'Специализированный') return 'background:#ffedd5;color:#9a3412;';
  return 'background:#f1f5f9;color:#475569;';
}

const CSS = '<style>'
  + '.bi-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:28px 32px;max-width:720px;}'
  + '.bi-label{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8;margin-bottom:4px;}'
  + '.bi-value{font-size:.95rem;color:#0d1f3c;font-weight:500;}'
  + '.bi-bin{font-size:1.5rem;font-weight:900;color:#0d1f3c;letter-spacing:.04em;margin:4px 0;}'
  + '.bi-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid #f1f5f9;font-size:.9rem;}'
  + '.bi-row:last-child{border-bottom:none;}'
  + '.bi-icon{flex-shrink:0;width:20px;text-align:center;font-size:1rem;line-height:1.5;}'
  + '.bi-link{color:#1a56db;text-decoration:none;}'
  + '.bi-link:hover{text-decoration:underline;}'
  + '.bi-tag{display:inline-block;font-size:.72rem;font-weight:700;border-radius:6px;padding:2px 10px;margin-left:8px;}'
  + '.bi-note{background:#f8fafc;border-left:3px solid #1a56db;padding:10px 14px;border-radius:0 8px 8px 0;font-size:.85rem;color:#475569;margin-top:1rem;}'
  + '</style>';

const tagHtml = bank.tag ? '<span class="bi-tag" style="' + tagColor(bank.tag) + '">' + bank.tag + '</span>' : '';
const phoneHtml = bank.phone
  ? '<div class="bi-row"><span class="bi-icon">📞</span><div><div class="bi-value">' + (bank.phoneRaw ? '<a href="tel:' + bank.phoneRaw + '" class="bi-link">' + bank.phone + '</a>' : bank.phone) + '</div>' + (bank.phoneShort ? '<div style="font-size:.8rem;color:#64748b;margin-top:2px;">' + bank.phoneShort + '</div>' : '') + '</div></div>'
  : '';
const emailHtml = bank.email ? '<div class="bi-row"><span class="bi-icon">✉️</span><a href="mailto:' + bank.email + '" class="bi-link bi-value">' + bank.email + '</a></div>' : '';
const webHtml = bank.web ? '<div class="bi-row"><span class="bi-icon">🌐</span><a href="https://' + bank.web + '" target="_blank" rel="noopener" class="bi-link bi-value">' + bank.web + '</a></div>' : '';
const addrHtml = bank.address ? '<div class="bi-row"><span class="bi-icon">📍</span><span class="bi-value">' + bank.city + ', ' + bank.address + '</span></div>' : '';
const chairHtml = bank.chairman ? '<div class="bi-row"><span class="bi-icon">👤</span><span class="bi-value">' + bank.chairman + ' <span style="color:#94a3b8;font-size:.82rem;">(Председатель Правления)</span></span></div>' : '';
const noteHtml = bank.note ? '<div class="bi-note">' + bank.note + '</div>' : '';

const ctaHtml = '<div class="npage-cta" style="margin-top:2.5rem;"><div class="npage-cta-left">'
  + '<p class="npage-cta-label">Юридическая помощь</p>'
  + '<h2 class="npage-cta-title">' + bank.shortName + ' арестовал счёт?</h2>'
  + '<p class="npage-cta-sub">Поможем снять арест с карты или счёта в ' + bank.shortName + ', оспорить задолженность и добиться реструктуризации долга. Работаем по всему Казахстану.</p>'
  + '<div class="npage-cta-tags"><span>Снятие ареста</span><span>Реструктуризация</span><span>Все банки РК</span></div></div>'
  + '<a href="https://wa.me/77752998738?text=Здравствуйте!+' + encodeURIComponent(bank.shortName) + '+арестовал+счёт,+прошу+помочь." class="npage-wa-btn" target="_blank" rel="noopener">'
  + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>'
  + ' <span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1.2;"><span>Написать в ZakonExpert</span><span style="font-size:.75rem;font-weight:400;opacity:.85;">+7 775 299-87-38</span></span></a></div>';

const body = CSS
  + '<div class="npage-wrap"><div class="landing-container">'
  + '<nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><a href="/banks">Банки Казахстана</a><span class="npage-bc-sep">/</span><span>' + bank.shortName + '</span></nav>'
  + '<div class="npage-hero"><div class="npage-badges"><span class="npage-badge">🏦 Банк РК</span></div>'
  + '<h1 class="npage-h1">' + bank.shortName + tagHtml + '</h1>'
  + '<p style="color:#94a3b8;font-size:.9rem;margin-top:4px;">' + bank.name + '</p></div>'
  + '<div class="bi-card" style="margin-top:1.5rem;">'
  + '<div style="margin-bottom:16px;padding-bottom:16px;border-bottom:2px solid #f1f5f9;">'
  + '<div class="bi-label">БИН банка</div>'
  + '<div class="bi-bin">' + bank.bin + '</div>'
  + '</div>'
  + addrHtml + phoneHtml + emailHtml + webHtml + chairHtml
  + noteHtml
  + '</div>'
  + mapBlock((bank.city ? bank.city + ', ' : '') + (bank.address || ''))
  + lowContentBoost({ entityLabel: bank.shortName })
  + ctaHtml
  + '<div style="margin-top:1.5rem;"><a href="/banks" style="color:#1a56db;font-size:.9rem;text-decoration:none;">← Все банки Казахстана</a></div>'
  + '</div></div>';
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
