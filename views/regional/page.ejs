<%
const pageTitle = 'Снятие ареста в ' + city.caseIn + ' — Kaspi, Halyk, ЧСИ | ZakonExpert';
const pageDesc = 'Арестовали счёт или карту в ' + city.caseIn + '? Проверим ЧСИ, сумму долга и основание ареста бесплатно. Работаем дистанционно по ' + city.caseByCity + '.';
const canonical = 'https://zakonexpertt.kz/snyatie-aresta-' + city.slug;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://zakonexpertt.kz/' },
      { '@type': 'ListItem', position: 2, name: 'Снятие ареста в ' + city.name, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: city.faq.map(function(f) {
      return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } };
    }),
  },
];

const waLink = 'https://wa.me/77003097566?text=' + encodeURIComponent('Здравствуйте! Арестовали счёт в ' + city.name + ', нужна помощь.');

const body = `
<div class="npage-wrap"><div class="landing-container">
  <nav class="npage-breadcrumb" aria-label="breadcrumb"><a href="/">Главная</a><span class="npage-bc-sep">/</span><span>Снятие ареста в ${city.name}</span></nav>

  <div class="npage-hero">
    <div class="npage-badges"><span class="npage-badge">📍 ${city.name}</span></div>
    <h1 class="npage-h1">Снятие ареста со счёта в ${city.prepIn}</h1>
    <p style="color:#475569;margin-top:.5rem;max-width:680px;">${city.intro}</p>
  </div>

  <div class="npage-quick-cta">
    <p>Арестовали Kaspi, Halyk или другой счёт в ${city.caseIn}? Отправьте ИИН в WhatsApp — проверим производство и основание ареста бесплатно.</p>
    <a href="${waLink}" class="npage-wa-btn" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      Проверить бесплатно
    </a>
  </div>

  <div class="npage-links-row" style="margin-bottom:1.5rem;">
    <a href="/snyatie-aresta-so-scheta">Снятие ареста со счёта</a>
    <a href="/arest-kaspi">Арест Kaspi</a>
    <a href="/snyatie-zapreta-na-avto">Запрет на авто</a>
    <a href="/snyatie-ogranichenii-chsi">Ограничения ЧСИ</a>
    <a href="/otmena-ispolnitelnoi-nadpisi">Исполнительная надпись</a>
  </div>

  <section class="legal-section" style="padding:0;margin-top:1.5rem;">
    <div class="row g-4">
      <div class="col-lg-8">
        <h2 style="font-size:1.2rem;font-weight:800;color:#0f2044;">ЧСИ и нотариусы в ${city.prepIn}</h2>
        <p style="color:#475569;">В ${city.caseIn} работают <strong>${bailiffCount ? bailiffCount + ' частных судебных исполнителей' : 'частные судебные исполнители'}</strong> и <strong>${notaryCount ? notaryCount + ' нотариусов' : 'нотариусы'}</strong>, которые ведут исполнительные производства и совершают исполнительные надписи по кредитам и МФО. Именно они накладывают арест на счета, карты, авто и недвижимость.</p>
        <div class="npage-links-row" style="margin:1rem 0 1.5rem;">
          <a href="/bailiffs?region=${encodeURIComponent(city.bailiffRegion)}">ЧСИ в ${city.prepIn} →</a>
          <a href="/notaries?region=${encodeURIComponent(city.notaryRegion)}">Нотариусы в ${city.prepIn} →</a>
        </div>

        <h2 style="font-size:1.2rem;font-weight:800;color:#0f2044;">Какие банки чаще всего накладывают арест</h2>
        <p style="color:#475569;">Чаще всего к нам обращаются клиенты Kaspi Bank, Halyk Bank и Freedom Bank — банк лишь исполняет постановление ЧСИ или исполнительную надпись нотариуса, самостоятельно решение об аресте он не принимает.</p>
        <div class="npage-links-row" style="margin:1rem 0 1.5rem;">
          <a href="/arest-kaspi">Арест Kaspi</a>
          <a href="/arest-halyk-bank">Арест Halyk Bank</a>
          <a href="/arest-freedom-bank">Арест Freedom Bank</a>
        </div>

        <h2 style="font-size:1.2rem;font-weight:800;color:#0f2044;">Что делать, если арестовали счёт в ${city.prepIn}</h2>
        <div class="law-highlight" style="margin:1rem 0 1.5rem;">
          <ul style="margin:0;padding-left:1.1rem;">
            <li>Проверьте по ИИН, кто наложил арест — ЧСИ, суд или нотариус — и на каком основании.</li>
            <li>Запросите постановление или исполнительную надпись — без документа сложно оценить законность.</li>
            <li>Если это исполнительная надпись нотариуса — на возражение есть 10 рабочих дней.</li>
            <li>Мы работаем дистанционно по ${city.caseByCity} — приезжать в офис не обязательно.</li>
          </ul>
        </div>

        <div class="law-faq mt-4">
          <h2 style="font-size:1.1rem;font-weight:800;margin-bottom:16px;color:#0f2044;">Частые вопросы — ${city.name}</h2>
          ${city.faq.map(function(f) {
            return `<div class="law-faq-item"><button class="law-faq-question" aria-expanded="false">${f.q}<span class="law-faq-question-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span></button><div class="law-faq-answer"><p>${f.a}</p></div></div>`;
          }).join('')}
        </div>

        <div class="article-cta" style="margin:24px 0;">
          <h3>Арестовали счёт в ${city.prepIn}?</h3>
          <p>Проверим по ИИН и объясним шаги — бесплатно и без обязательств.</p>
          <div class="d-flex gap-3 flex-wrap">
            <a href="/#checker-section" class="btn-legal-cta">Проверить по ИИН</a>
            <a href="${waLink}" target="_blank" rel="noopener" class="btn-legal-outline"><i class="bi bi-whatsapp me-1"></i> WhatsApp</a>
          </div>
        </div>
        <div class="legal-disclaimer">Информация носит справочный характер. Для оценки ситуации необходим анализ документов.</div>
      </div>
      <div class="col-lg-4">
        <div class="law-source-card sticky-top" style="top:80px">
          <h3>Другие регионы</h3>
          <ul>
            ${otherCities.map(function(c) { return `<li><a href="/snyatie-aresta-${c.slug}">Снятие ареста в ${c.name}</a></li>`; }).join('')}
          </ul>
          <a href="${waLink}" target="_blank" rel="noopener" class="btn-legal-cta d-block text-center mt-3">Написать в WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

</div></div>
`;
%>
<%- include('../news/layout', { title: pageTitle, description: pageDesc, canonical, ogType: 'website', ogImage: null, schema, noindex: false, body }) %>
