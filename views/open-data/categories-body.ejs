      <div class="od-directory-grid"><% categories.forEach(function(category) { %><a class="od-directory-card" href="/otkrytye-dannye/kategoriya/<%= category.slug %>"><span class="od-directory-card__icon"><i class="bi bi-database"></i></span><span><strong><%= category.name %></strong><small><%= formatNumber(category.count) %> наборов</small></span><i class="bi bi-arrow-right"></i></a><% }); %></div>
    </section>
  </div>
</section>
