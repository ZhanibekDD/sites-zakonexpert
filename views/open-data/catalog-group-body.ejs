<section class="od-page">
  <div class="landing-container">
    <nav class="od-breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/otkrytye-dannye">Открытые данные</a><span>/</span><a href="<%= groupType === 'category' ? '/otkrytye-dannye/kategorii' : '/otkrytye-dannye/organizacii' %>"><%= groupType === 'category' ? 'Категории' : 'Организации' %></a><span>/</span><span><%= group.name %></span></nav>
    <header class="od-hero od-hero--compact"><div class="od-hero__copy"><span class="od-eyebrow"><i class="bi bi-database-check"></i> <%= groupType === 'category' ? 'Категория' : 'Владелец данных' %></span><h1><%= group.name %></h1><p>Все опубликованные наборы data.egov.kz в этом разделе. Записи открываются через официальный API без скрытия полей.</p><div class="od-stat-ribbon"><span><b><%= formatNumber(result.total) %></b> наборов</span><span><b><%= result.page %></b> страница из <%= result.totalPages %></span></div></div></header>
    <section class="od-section"><form class="od-records-toolbar" method="get"><label>Поиск внутри раздела<input type="search" name="q" value="<%= result.query %>" placeholder="Тема, название или ключевое слово"></label><button class="od-btn od-btn--primary" type="submit"><i class="bi bi-search"></i> Найти</button></form>
      <div class="od-dataset-grid"><% result.datasets.forEach(function(dataset) { %><article class="od-dataset-card"><div class="od-dataset-card__top"><span class="od-source-badge"><i class="bi bi-patch-check-fill"></i> data.egov.kz</span><span class="od-status"><%= dataset.actual ? 'актуален' : 'архивный' %></span></div><h3><a href="<%= dataset.path %>"><%= dataset.title %></a></h3><p><%= dataset.description %></p><dl class="od-meta-inline"><div><dt>Категория</dt><dd><%= dataset.category %></dd></div><div><dt>Орган</dt><dd><%= dataset.agency %></dd></div><div><dt>Обновлено</dt><dd><%= formatDate(dataset.updatedAt) %></dd></div></dl><a class="od-text-link" href="<%= dataset.path %>">Открыть данные <span>→</span></a></article><% }); %></div>
      <% if (!result.datasets.length) { %><p class="od-catalog-empty">По этому запросу наборов не найдено.</p><% } %>
      <% if (result.totalPages > 1) { const querySuffix = result.query ? '&q=' + encodeURIComponent(result.query) : ''; %><nav class="od-records-pagination" aria-label="Страницы"><% if (result.page > 1) { %><a class="od-btn od-btn--ghost" href="?page=<%= result.page - 1 %><%= querySuffix %>">← Предыдущая</a><% } %><span>Страница <%= result.page %> из <%= result.totalPages %></span><% if (result.page < result.totalPages) { %><a class="od-btn od-btn--ghost" href="?page=<%= result.page + 1 %><%= querySuffix %>">Следующая →</a><% } %></nav><% } %>
    </section>
  </div>
</section>
