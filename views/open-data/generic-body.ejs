<section class="od-page">
  <div class="landing-container">
    <nav class="od-breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span>/</span><a href="/otkrytye-dannye">Открытые данные</a><span>/</span><a href="<%= dataset.category === 'Государственный сектор' ? '/otkrytye-dannye/gosudarstvennyy-sektor' : '/otkrytye-dannye/kategorii' %>"><%= dataset.category %></a><span>/</span><span><%= dataset.title %></span></nav>
    <header class="od-detail-hero">
      <div class="od-detail-hero__main"><span class="od-eyebrow"><i class="bi bi-database-check"></i> Официальный набор данных</span><h1><%= dataset.title %></h1><p><%= dataset.description %></p></div>
      <div class="od-source-seal"><i class="bi bi-bank"></i><span>Источник</span><strong>data.egov.kz</strong></div>
    </header>

    <div class="od-kpi-grid"><div class="od-kpi"><span class="od-kpi__icon"><i class="bi bi-list-ol"></i></span><strong><%= recordCountLabel(dataset) %></strong><small>записи официального API</small></div><div class="od-kpi"><span class="od-kpi__icon"><i class="bi bi-layout-three-columns"></i></span><strong><%= dataset.columns.length || 'Авто' %></strong><small>поля определяются из данных</small></div><div class="od-kpi"><span class="od-kpi__icon"><i class="bi bi-calendar3"></i></span><strong><%= formatDate(dataset.updatedAt) %></strong><small>обновление источника</small></div><div class="od-kpi"><span class="od-kpi__icon"><i class="bi bi-arrow-repeat"></i></span><strong><%= dataset.updateFrequency || 'По паспорту' %></strong><small>периодичность</small></div></div>

    <% if (!dataset.liveAvailable && !dataset.hasData) { %><div class="od-data-alert"><i class="bi bi-hourglass-split"></i><div><strong>Паспорт набора доступен, но API источника не объявлен.</strong><p>Откройте официальный паспорт для проверки статуса.</p></div></div><% } %>

    <% if (housingDataset) { %><%- include('housing-records', { dataset: dataset }) %><% } %>
    <% if (!housingDataset && dataset.liveAvailable) { %><%- include('records', { dataset: dataset }) %><% } %>

    <div class="od-detail-grid">
      <section class="od-table-card" aria-labelledby="od-fields-title">
        <div class="od-card-heading"><div><span class="od-kicker">Структура</span><h2 id="od-fields-title">Поля и показатели</h2></div></div>
        <% if (dataset.columns.length) { %><div class="od-table-wrap"><table><thead><tr><th>Поле</th><th>Тип</th><th>Заполнено</th><th>Сводка</th></tr></thead><tbody><% dataset.columns.forEach(function(column) { %><tr><td><%= column.label %></td><td><%= column.type %></td><td><%= formatNumber(column.filledCount) %> / <%= formatNumber(dataset.rowCount) %></td><td><% if (column.sensitive) { %>поле публикуется полностью в таблице ниже<% } else if (column.type === 'number') { %>от <%= formatNumber(column.minimum, 2) %> до <%= formatNumber(column.maximum, 2) %><% } else if (column.type === 'date' && column.dateRange) { %><%= formatDate(column.dateRange.from) %> — <%= formatDate(column.dateRange.to) %><% } else { %><%= formatNumber(column.uniqueCount) %> уникальных значений<% } %></td></tr><% }); %></tbody></table></div><% } else { %><p class="od-muted-copy">Названия полей будут определены при загрузке первой страницы записей.</p><% } %>
      </section>
      <aside class="od-source-card"><span class="od-kicker">Источник и актуальность</span><h2>Паспорт набора</h2><dl><div><dt>Государственный орган</dt><dd><%= dataset.agency %></dd></div><div><dt>Категория</dt><dd><%= dataset.category %></dd></div><div><dt>Дата размещения</dt><dd><%= formatDate(dataset.publishedAt) %></dd></div><div><dt>Дата обновления</dt><dd><%= formatDate(dataset.updatedAt) %></dd></div><div><dt>Версия</dt><dd><%= dataset.version || 'определяется автоматически' %></dd></div></dl><a class="od-btn od-btn--source" href="<%= dataset.datasetUrl %>" target="_blank" rel="noopener noreferrer nofollow">Открыть официальный набор <i class="bi bi-box-arrow-up-right"></i></a><% if (dataset.metaUrl) { %><a class="od-meta-link" href="<%= dataset.metaUrl %>" target="_blank" rel="noopener noreferrer nofollow">Метаинформация API</a><% } %></aside>
    </div>

  </div>
</section>
