# NeDB database — stays on server
data/
# Two privacy-safe open-data files are deployment assets. Raw API responses,
# local recon-out bundles and databases remain ignored.
!data/
data/*
!data/open-data-government-sector-seed.json
!data/open-data-inventory.json.br
!data/open-data-snapshots.json
!data/open-data-pending.json
!data/official-data-sources.json
recon-out/

